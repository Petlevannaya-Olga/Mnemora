<UserControl
    x:Class="Mnemora.Desktop.Views.Library.CreateMaterialView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Mnemora.Desktop.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:TopicColorConverter x:Key="TopicColorConverter" />

        <!-- Хлебная крошка — тот же спокойный back-link, что и на страницах управления. -->
        <Style x:Key="CreateMaterial.BreadcrumbButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Карточка выбора типа. Вся карточка является RadioButton. -->
        <Style x:Key="CreateMaterial.TypeCard" TargetType="RadioButton">
            <Setter Property="Width" Value="350" />
            <Setter Property="Height" Value="280" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                            </Border>

                            <Border x:Name="SelectedMark"
                                    Width="28"
                                    Height="28"
                                    Margin="0,14,14,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Mnemora.Brush.Secondary}"
                                    CornerRadius="14"
                                    Visibility="Collapsed">
                                <materialDesign:PackIcon Width="17"
                                                         Height="17"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Kind="Check" />
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#FAF9FF" />
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#DAD3F8" />
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#F7F5FF" />
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Mnemora.Brush.Secondary}" />
                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                                <Setter TargetName="SelectedMark"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Mnemora.Brush.SurfaceMuted}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Хлебные крошки — наверху, как на остальных страницах библиотеки. -->
        <Button Grid.Row="0"
                Margin="32,28,32,0"
                HorizontalAlignment="Left"
                Style="{StaticResource CreateMaterial.BreadcrumbButton}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Width="18"
                                         Height="18"
                                         VerticalAlignment="Center"
                                         Kind="ChevronLeft" />
                <TextBlock Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Text="Темы" />
            </StackPanel>
        </Button>

        <!-- 2. Контекст текущей темы. Тонкий разделитель отделяет тему от процесса создания. -->
        <Grid Grid.Row="1"
              Margin="32,20,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="64"
                    Height="64"
                    Background="{Binding SelectedTopic.TopicColor, Converter={StaticResource TopicColorConverter}}"
                    CornerRadius="15">
                <materialDesign:PackIcon Width="34"
                                         Height="34"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="White"
                                         Kind="{Binding SelectedTopic.IconKind}" />
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                           Text="{Binding SelectedTopic.Name, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="Создать материал" />
            </StackPanel>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Height="1"
                    Margin="0,14,0,0"
                    Background="{DynamicResource Mnemora.Brush.Border}" />
        </Grid>

        <!-- 3. Stepper — повторяет навигацию онбординга: активный шаг и соединение выделены фирменным градиентом. -->
        <Grid Grid.Row="2"
              Margin="72,26,72,0"
              HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>

            <!-- Шаг 1 — активный. -->
            <StackPanel Grid.Column="0"
                        HorizontalAlignment="Center">
                <Border Width="46"
                        Height="46"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.BrandGradient}"
                        BorderThickness="2"
                        CornerRadius="23">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                               Text="1" />
                </Border>
                <TextBlock Margin="0,9,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                           Text="Тип материала" />
            </StackPanel>

            <Border Grid.Column="1"
                    Height="3"
                    Margin="8,22,8,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource Mnemora.Brush.BrandGradient}"
                    CornerRadius="2" />

            <!-- Шаг 2. -->
            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Center">
                <Border Width="46"
                        Height="46"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                        BorderThickness="2"
                        CornerRadius="23">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="2" />
                </Border>
                <TextBlock Margin="0,9,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="Основное" />
            </StackPanel>

            <Border Grid.Column="3"
                    Height="2"
                    Margin="8,22,8,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource Mnemora.Brush.Border}" />

            <!-- Шаг 3. -->
            <StackPanel Grid.Column="4"
                        HorizontalAlignment="Center">
                <Border Width="46"
                        Height="46"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                        BorderThickness="2"
                        CornerRadius="23">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="3" />
                </Border>
                <TextBlock Margin="0,9,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="Содержимое" />
            </StackPanel>

            <Border Grid.Column="5"
                    Height="2"
                    Margin="8,22,8,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource Mnemora.Brush.Border}" />

            <!-- Шаг 4. -->
            <StackPanel Grid.Column="6"
                        HorizontalAlignment="Center">
                <Border Width="46"
                        Height="46"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                        BorderThickness="2"
                        CornerRadius="23">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="4" />
                </Border>
                <TextBlock Margin="0,9,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="Обучение и связи" />
            </StackPanel>
        </Grid>

        <!-- 4. Содержимое только первого шага. -->
        <ScrollViewer Grid.Row="3"
                      Margin="32,28,32,20"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Border MaxWidth="900"
                    Padding="36,28,36,30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource Mnemora.Brush.Surface}"
                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="Что добавим в Mnemora?" />

                    <TextBlock Margin="0,7,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Выбери формат — дальше настроим всё по шагам." />

                    <Grid Margin="0,24,0,0"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="ArticleChoiceRadio"
                                     Grid.Column="0"
                                     GroupName="CreateMaterialType"
                                     Style="{StaticResource CreateMaterial.TypeCard}">
                            <Grid Margin="26,20,26,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Width="60"
                                        Height="60"
                                        HorizontalAlignment="Center"
                                        Background="#F1EDFF"
                                        CornerRadius="30">
                                    <materialDesign:PackIcon Width="30"
                                                             Height="30"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                             Kind="FileDocumentOutline" />
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                               Text="Статья" />
                                    <TextBlock Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                               Text="Теория, конспект или подробный разбор" />
                                </StackPanel>

                                <Border Grid.Row="2"
                                        Height="1"
                                        Margin="0,16,0,14"
                                        Background="{DynamicResource Mnemora.Brush.Border}" />

                                <StackPanel Grid.Row="3">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                 Kind="BookOpenPageVariantOutline" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                   Text="Сохраняй теорию и разборы" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                 Kind="FormatListBulleted" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                   Text="Структурируй материал с оглавлением" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                 Kind="HelpCircleOutline" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                   Text="Закрепляй знания вопросами с ИИ-проверкой" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="QuestionChoiceRadio"
                                     Grid.Column="2"
                                     GroupName="CreateMaterialType"
                                     Style="{StaticResource CreateMaterial.TypeCard}">
                            <Grid Margin="26,20,26,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Width="60"
                                        Height="60"
                                        HorizontalAlignment="Center"
                                        Background="#E8FAF7"
                                        CornerRadius="30">
                                    <materialDesign:PackIcon Width="30"
                                                             Height="30"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                             Kind="HelpCircleOutline" />
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                               Text="Вопрос" />
                                    <TextBlock Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                               Text="Практика и проверка знаний" />
                                </StackPanel>

                                <Border Grid.Row="2"
                                        Height="1"
                                        Margin="0,16,0,14"
                                        Background="{DynamicResource Mnemora.Brush.Border}" />

                                <StackPanel Grid.Row="3">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                                 Kind="HelpCircleOutline" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                   Text="Создавай вопросы для практики" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                                 Kind="Check" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                   Text="Добавляй эталонные ответы" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                                 Kind="InformationOutline" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                   Text="Получай ИИ-проверку и обратную связь" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 5. Фиксированный footer первого шага. Реальное создание материала пока не подключено. -->
        <Border Grid.Row="4"
                Padding="32,16"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button HorizontalAlignment="Left"
                        Command="{Binding CancelCreateMaterialCommand}"
                        Style="{StaticResource Mnemora.SecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 VerticalAlignment="Center"
                                                 Kind="ChevronLeft" />
                        <TextBlock Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Назад к материалам" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        MinWidth="132"
                        Height="44">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource Mnemora.PrimaryButton}">
                            <Setter Property="IsEnabled" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=ArticleChoiceRadio}"
                                             Value="True">
                                    <Setter Property="IsEnabled" Value="True" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=QuestionChoiceRadio}"
                                             Value="True">
                                    <Setter Property="IsEnabled" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Далее" />
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 Margin="7,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Kind="ChevronRight" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
