<UserControl
    x:Class="Mnemora.Desktop.Controls.Loading.LoadingIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loading="clr-namespace:Mnemora.Desktop.Controls.Loading"
    AutomationProperties.Name="{Binding Message, RelativeSource={RelativeSource Self}}"
    Focusable="False"
    IsHitTestVisible="False"
    UseLayoutRounding="True">

    <Grid
        x:Name="IndicatorContent"
        Opacity="0"
        Visibility="Collapsed"
        Width="{Binding IndicatorLength, RelativeSource={RelativeSource AncestorType={x:Type loading:LoadingIndicator}}}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Собственный шаблон не зависит от темы MaterialDesign и поэтому
             одинаково виден на светлом и тёмном фоне. -->
        <Grid
            x:Name="Track"
            Height="{Binding IndicatorThickness, RelativeSource={RelativeSource AncestorType={x:Type loading:LoadingIndicator}}}"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
            SizeChanged="Track_OnSizeChanged">
            <Border
                Background="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType={x:Type loading:LoadingIndicator}}}"
                CornerRadius="999" />

            <Border
                x:Name="DeterminateFill"
                Width="0"
                HorizontalAlignment="Left"
                CornerRadius="999">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#7C4DFF" />
                        <GradientStop Offset="0.52" Color="#3E8EF7" />
                        <GradientStop Offset="1" Color="#16CDB7" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border
                x:Name="IndeterminateFill"
                Width="96"
                HorizontalAlignment="Left"
                CornerRadius="999">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="IndeterminateTranslation" />
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#007C4DFF" />
                        <GradientStop Offset="0.24" Color="#7C4DFF" />
                        <GradientStop Offset="0.58" Color="#3E8EF7" />
                        <GradientStop Offset="0.86" Color="#16CDB7" />
                        <GradientStop Offset="1" Color="#0016CDB7" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="MessageTextBlock"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{Binding MessageForeground, RelativeSource={RelativeSource AncestorType={x:Type loading:LoadingIndicator}}}"
                Text="{Binding Message, RelativeSource={RelativeSource AncestorType={x:Type loading:LoadingIndicator}}}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="PercentageTextBlock"
                Grid.Column="1"
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{Binding PercentageForeground, RelativeSource={RelativeSource AncestorType={x:Type loading:LoadingIndicator}}}"
                Text="{Binding Value, RelativeSource={RelativeSource AncestorType={x:Type loading:LoadingIndicator}}, StringFormat={}{0:0}%}" />
        </Grid>
    </Grid>
</UserControl>
