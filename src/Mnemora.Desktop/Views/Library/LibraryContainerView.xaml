<UserControl
    xmlns:libraryBehaviors="clr-namespace:Mnemora.Desktop.Views.Library"
    x:Class="Mnemora.Desktop.Views.Library.LibraryContainerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Mnemora.Desktop.Converters"
    xmlns:loading="clr-namespace:Mnemora.Desktop.Controls.Loading"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    DataContextChanged="LibraryContainerView_OnDataContextChanged"
    Loaded="LibraryContainerView_OnLoaded"
    Unloaded="LibraryContainerView_OnUnloaded"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:LibraryRangeCounterTextConverter x:Key="LibraryRangeCounterTextConverter" />
        <converters:LibraryFolderColorConverter x:Key="LibraryFolderColorConverter" />
        <converters:LibraryFolderIconConverter x:Key="LibraryFolderIconConverter" />

        <Style x:Key="BreadcrumbButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LibraryViewModeButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Mnemora.Brush.SurfaceMuted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Primary}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E6FBF8" />
                                <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialFilterButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Mnemora.Brush.SurfaceMuted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Primary}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E6FBF8" />
                                <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="libraryBehaviors:SuppressBringIntoViewBehavior.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LargeCardStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="138" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
        </Style>

        <Style x:Key="CompactCardStyle" TargetType="Border">
            <Setter Property="Height" Value="78" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RangeTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#F6F8FC" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="TableRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7FAFC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaterialTableColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialTableRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="66" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Grid>
                            <Border
                                x:Name="RowBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                BorderThickness="0,0,0,1" />

                            <Border
                                x:Name="SelectionIndicator"
                                Width="4"
                                Margin="0,8,0,8"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Mnemora.Brush.Primary}"
                                CornerRadius="0,3,3,0"
                                Visibility="Collapsed" />

                            <DataGridCellsPresenter />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#F3F6FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#E6FBF8" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FolderTableRowStyle" BasedOn="{StaticResource MaterialTableRowStyle}" TargetType="DataGridRow">
            <EventSetter Event="MouseLeftButtonUp" Handler="FolderTableRow_OnMouseLeftButtonUp" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="MixedContentTableRowStyle" BasedOn="{StaticResource MaterialTableRowStyle}" TargetType="DataGridRow">
            <EventSetter Event="MouseLeftButtonUp" Handler="MixedContentTableRow_OnMouseLeftButtonUp" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaterialTableCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaterialTableTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MaterialDifficultyBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#EAF8F0" />
            <Setter Property="CornerRadius" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMedium}" Value="True">
                    <Setter Property="Background" Value="#FFF6DC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHard}" Value="True">
                    <Setter Property="Background" Value="#FDEBEC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaterialDifficultyDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#26976A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMedium}" Value="True">
                    <Setter Property="Fill" Value="#C98200" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHard}" Value="True">
                    <Setter Property="Fill" Value="#D94A4A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaterialDifficultyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#267A59" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMedium}" Value="True">
                    <Setter Property="Foreground" Value="#996400" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHard}" Value="True">
                    <Setter Property="Foreground" Value="#B7353B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <!-- Плитки материалов: те же режимы, что и у папок -->
        <DataTemplate x:Key="MaterialLargeTileTemplate">
            <Border Style="{StaticResource LargeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Width="42" Height="42" HorizontalAlignment="Left" CornerRadius="11">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F0ECFF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                        <Setter Property="Background" Value="#E6FBF8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <materialDesign:PackIcon Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                    <Setter Property="Kind" Value="FileDocumentOutline" />
                                    <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                            <Setter Property="Kind" Value="HelpCircleOutline" />
                                            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="{Binding TypeTitle}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="{Binding TagsText}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MaterialCompactTileTemplate">
            <Border Style="{StaticResource CompactCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" VerticalAlignment="Center" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F0ECFF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                        <Setter Property="Background" Value="#E6FBF8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <materialDesign:PackIcon Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                    <Setter Property="Kind" Value="FileDocumentOutline" />
                                    <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                            <Setter Property="Kind" Value="HelpCircleOutline" />
                                            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="{Binding TypeTitle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Смешанные плитки: папки всегда идут первыми, порядок задаёт MixedContent -->
        <DataTemplate x:Key="MixedLargeTileTemplate">
            <Grid>
                <Button
                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    CommandParameter="{Binding Folder}"
                    Style="{StaticResource CardButtonStyle}"
                    Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource LargeCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Width="42" Height="42" HorizontalAlignment="Left" Background="{Binding FolderColor, Converter={StaticResource LibraryFolderColorConverter}}" CornerRadius="11">
                                <materialDesign:PackIcon Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Kind="{Binding FolderIcon, Converter={StaticResource LibraryFolderIconConverter}}" />
                            </Border>
                            <TextBlock Grid.Row="1" Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="{Binding DetailsText}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Button>
                <Border Style="{StaticResource LargeCardStyle}" Visibility="{Binding IsMaterial, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="42" Height="42" HorizontalAlignment="Left" CornerRadius="11">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F0ECFF" /><Style.Triggers><DataTrigger Binding="{Binding IsQuestion}" Value="True"><Setter Property="Background" Value="#E6FBF8" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <materialDesign:PackIcon Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style><Style TargetType="{x:Type materialDesign:PackIcon}"><Setter Property="Kind" Value="FileDocumentOutline" /><Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" /><Style.Triggers><DataTrigger Binding="{Binding IsQuestion}" Value="True"><Setter Property="Kind" Value="HelpCircleOutline" /><Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" /></DataTrigger></Style.Triggers></Style></materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="{Binding TypeTitle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="{Binding DetailsText}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MixedCompactTileTemplate">
            <Grid>
                <Button
                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    CommandParameter="{Binding Folder}"
                    Style="{StaticResource CardButtonStyle}"
                    Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource CompactCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" VerticalAlignment="Center" Background="{Binding FolderColor, Converter={StaticResource LibraryFolderColorConverter}}" CornerRadius="10">
                                <materialDesign:PackIcon Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Kind="{Binding FolderIcon, Converter={StaticResource LibraryFolderIconConverter}}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="{Binding DetailsText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Button>
                <Border Style="{StaticResource CompactCardStyle}" Visibility="{Binding IsMaterial, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" VerticalAlignment="Center" CornerRadius="10">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F0ECFF" /><Style.Triggers><DataTrigger Binding="{Binding IsQuestion}" Value="True"><Setter Property="Background" Value="#E6FBF8" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <materialDesign:PackIcon Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style><Style TargetType="{x:Type materialDesign:PackIcon}"><Setter Property="Kind" Value="FileDocumentOutline" /><Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" /><Style.Triggers><DataTrigger Binding="{Binding IsQuestion}" Value="True"><Setter Property="Kind" Value="HelpCircleOutline" /><Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" /></DataTrigger></Style.Triggers></Style></materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="{Binding TypeTitle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="LibraryScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryVerticalScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Primary}" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border
                            Margin="2,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>

                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate
            x:Key="LibraryVerticalScrollBarTemplate"
            TargetType="{x:Type ScrollBar}">
            <Grid
                Background="Transparent"
                SnapsToDevicePixels="True">
                <Border
                    Margin="3,2"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5" />

                <Track
                    x:Name="PART_Track"
                    Margin="2"
                    IsDirectionReversed="True"
                    Orientation="Vertical"
                    ViewportSize="NaN">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            Command="{x:Static ScrollBar.PageUpCommand}"
                            Style="{StaticResource LibraryScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb Style="{StaticResource LibraryVerticalScrollThumbStyle}" />
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            Command="{x:Static ScrollBar.PageDownCommand}"
                            Style="{StaticResource LibraryScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>

            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style
            x:Key="LibraryScrollBarStyle"
            BasedOn="{StaticResource {x:Type ScrollBar}}"
            TargetType="{x:Type ScrollBar}">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="16" />
                    <Setter Property="MinWidth" Value="16" />
                    <Setter Property="Margin" Value="6,2,2,2" />
                    <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Border}" />
                    <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Primary}" />
                    <Setter Property="Opacity" Value="0.9" />
                    <Setter Property="Template" Value="{StaticResource LibraryVerticalScrollBarTemplate}" />
                </Trigger>

                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Orientation" Value="Vertical" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Opacity" Value="1" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Mnemora.Brush.SurfaceMuted}">
        <Grid.Resources>
            <Style
                BasedOn="{StaticResource LibraryScrollBarStyle}"
                TargetType="{x:Type ScrollBar}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="FoldersPaneRow" Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="MaterialsPaneRow" Height="2*" MinHeight="200" />
        </Grid.RowDefinitions>

        <!-- Заголовок и breadcrumbs -->
        <Grid Margin="32,22,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding NavigateLibraryCommand}" Style="{StaticResource BreadcrumbButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="17" Height="17" Margin="0,0,5,0" VerticalAlignment="Center" Kind="HomeOutline" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="Библиотека" />
                    </StackPanel>
                </Button>

                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Margin="7,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                    Kind="ChevronRight" />

                                <Grid VerticalAlignment="Center">
                                    <Button
                                        Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}">
                                        <TextBlock FontSize="14" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource BreadcrumbButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="58"
                    Height="58"
                    Background="{Binding CurrentContainerColor, Converter={StaticResource LibraryFolderColorConverter}}"
                    CornerRadius="14">
                    <materialDesign:PackIcon
                        Width="31"
                        Height="31"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Kind="{Binding CurrentContainerIcon, Converter={StaticResource LibraryFolderIconConverter}}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="17,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="{Binding ContainerTitle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="15"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="{Binding ContainerSubtitle}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Height="1"
                    Margin="0,22,0,0"
                    Background="{DynamicResource Mnemora.Brush.Border}" />
        </Grid>

        <!-- Общая панель поиска, сортировки и вида -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="32,16"
            Background="{DynamicResource Mnemora.Brush.ToolbarSurface}"
            Visibility="{Binding HasAnyContent, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Height="50"
                    VerticalContentAlignment="Center"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:HintAssist.Hint="Поиск в этой папке..."
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <ComboBox
                    Grid.Column="2"
                    Height="50"
                    VerticalContentAlignment="Center"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSortOption}"
                    materialDesign:HintAssist.Hint="Сортировка"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    Visibility="{Binding HasAnyContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ToggleButton
                        Command="{Binding ShowTilesViewCommand}"
                        IsChecked="{Binding IsTilesView, Mode=OneWay}"
                        Style="{StaticResource LibraryViewModeButtonStyle}"
                        ToolTip="Визуально">
                        <materialDesign:PackIcon Width="23" Height="23" Kind="ViewGridOutline" />
                    </ToggleButton>
                    <ToggleButton
                        Command="{Binding ShowCompactTilesViewCommand}"
                        IsChecked="{Binding IsCompactTilesView, Mode=OneWay}"
                        Style="{StaticResource LibraryViewModeButtonStyle}"
                        ToolTip="Компактно">
                        <materialDesign:PackIcon Width="23" Height="23" Kind="ViewModule" />
                    </ToggleButton>
                    <ToggleButton
                        Command="{Binding ShowTableViewCommand}"
                        IsChecked="{Binding IsTableView, Mode=OneWay}"
                        Style="{StaticResource LibraryViewModeButtonStyle}"
                        ToolTip="Таблица">
                        <materialDesign:PackIcon Width="23" Height="23" Kind="FormatListBulleted" />
                    </ToggleButton>

                    <ComboBox
                        Width="108"
                        Height="50"
                        Margin="10,0,0,0"
                        VerticalContentAlignment="Center"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding TilesPerRowOptions}"
                        SelectedItem="{Binding SelectedTilesPerRowOption, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        ToolTip="Максимальное количество плиток в строке. «Авто» подбирает количество по ширине окна."
                        Visibility="{Binding IsTilesPerRowSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        materialDesign:HintAssist.Hint="Колонки" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Папки -->
        <Grid Grid.Row="2" Margin="32,0,32,12" Visibility="{Binding IsFoldersOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Grid.RowSpan" Value="3" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMaterialContent}" Value="True">
                            <Setter Property="Grid.RowSpan" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Папки" />
                <TextBlock Style="{StaticResource RangeTextStyle}" Text="{Binding FoldersShownCountText, Converter={StaticResource LibraryRangeCounterTextConverter}}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <loading:LoadingIndicator
                    Margin="0,28,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IndicatorLength="260"
                    IndicatorThickness="6"
                    Message="Загружаем папки..."
                    Visibility="{Binding IsLoadingFolders, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border
                    Padding="16"
                    Background="{DynamicResource Mnemora.Brush.Surface}"
                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding HasFoldersError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Mnemora.Brush.Error}"
                            Text="{Binding FoldersErrorMessage}" />
                        <Button
                            DockPanel.Dock="Right"
                            Margin="16,0,0,0"
                            Command="{Binding RetryFoldersCommand}"
                            Content="Повторить"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </DockPanel>
                </Border>

                <Border
                    Padding="16"
                    Background="{DynamicResource Mnemora.Brush.Surface}"
                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding IsFoldersEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                            Kind="FolderOutline" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                            Text="{Binding FoldersEmptyMessage}" />
                    </Grid>
                </Border>

                <!-- Крупные папки -->
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalContentAlignment="Top"
                    ScrollChanged="FoldersScroll_OnScrollChanged"
                    Visibility="{Binding IsTilesView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl VerticalAlignment="Top" ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid
                                    libraryBehaviors:ResponsiveUniformGridBehavior.DesiredColumns="{Binding DataContext.DesiredTilesPerRow, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    libraryBehaviors:ResponsiveUniformGridBehavior.MinimumItemWidth="300"
                                    libraryBehaviors:ResponsiveUniformGridBehavior.MaximumColumns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,14,0"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource CardButtonStyle}">
                                    <Border Style="{StaticResource LargeCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border
                                                Width="42"
                                                Height="42"
                                                HorizontalAlignment="Left"
                                                Background="{Binding Color, Converter={StaticResource LibraryFolderColorConverter}}"
                                                CornerRadius="11">
                                                <materialDesign:PackIcon
                                                    Width="23"
                                                    Height="23"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Kind="{Binding Icon, Converter={StaticResource LibraryFolderIconConverter}}" />
                                            </Border>
                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="0,12,0,0"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Margin="0,8,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                Text="{Binding ContentsText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Компактные папки -->
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalContentAlignment="Top"
                    ScrollChanged="FoldersScroll_OnScrollChanged"
                    Visibility="{Binding IsCompactTilesView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl VerticalAlignment="Top" ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid
                                    libraryBehaviors:ResponsiveUniformGridBehavior.DesiredColumns="{Binding DataContext.DesiredTilesPerRow, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    libraryBehaviors:ResponsiveUniformGridBehavior.MinimumItemWidth="220"
                                    libraryBehaviors:ResponsiveUniformGridBehavior.MaximumColumns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,12,0"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource CardButtonStyle}">
                                    <Border Style="{StaticResource CompactCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="40"
                                                Height="40"
                                                VerticalAlignment="Center"
                                                Background="{Binding Color, Converter={StaticResource LibraryFolderColorConverter}}"
                                                CornerRadius="10">
                                                <materialDesign:PackIcon
                                                    Width="21"
                                                    Height="21"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Kind="{Binding Icon, Converter={StaticResource LibraryFolderIconConverter}}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                    Text="{Binding ContentsText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Папки таблицей -->
                <Border
                    Background="{DynamicResource Mnemora.Brush.Surface}"
                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True"
                    Visibility="{Binding IsTableView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid
                        ItemsSource="{Binding Folders}"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="False"
                        CellStyle="{StaticResource MaterialTableCellStyle}"
                        ColumnHeaderStyle="{StaticResource MaterialTableColumnHeaderStyle}"
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        RowHeaderWidth="0"
                        RowStyle="{StaticResource FolderTableRowStyle}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.ScrollChanged="FoldersScroll_OnScrollChanged"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Папка" MinWidth="260" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="40"
                                                Height="40"
                                                Background="{Binding Color, Converter={StaticResource LibraryFolderColorConverter}}"
                                                CornerRadius="10">
                                                <materialDesign:PackIcon
                                                    Width="22"
                                                    Height="22"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Kind="{Binding Icon, Converter={StaticResource LibraryFolderIconConverter}}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                    Text="{Binding ContentsText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Header="Вложенные папки"
                                Width="130"
                                Binding="{Binding ChildFoldersCount}"
                                ElementStyle="{StaticResource MaterialTableTextStyle}" />
                            <DataGridTextColumn
                                Header="Материалы"
                                Width="110"
                                Binding="{Binding MaterialsCount}"
                                ElementStyle="{StaticResource MaterialTableTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Догрузка: плавающая плашка не участвует в layout и не сдвигает скролл -->
                <Border
                    Panel.ZIndex="50"
                    Padding="18,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F0061735"
                    CornerRadius="14"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsLoadingNextFoldersPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <loading:LoadingIndicator
                        IndicatorLength="180"
                        IndicatorThickness="5"
                        Message="Загружаем папки..."
                        MessageForeground="White"
                        TrackBrush="#40FFFFFF" />
                </Border>

            </Grid>

            <!-- Нижняя строка больше не используется для обычной догрузки -->
        </Grid>

        <!-- Разделитель между папками и материалами -->
        <GridSplitter
            Grid.Row="3"
            Visibility="Collapsed"
            Height="8"
            Margin="32,0,32,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Cursor="SizeNS"
            DragCompleted="FoldersMaterialsSplitter_OnDragCompleted"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows"
            ShowsPreview="True">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Border}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridSplitter">
                                <Border
                                    Height="2"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="1" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Primary}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasFolderContent}" Value="True" />
                                <Condition Binding="{Binding HasMaterialContent}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <!-- Материалы -->
        <Grid Margin="32,8,32,26" Visibility="{Binding IsMaterialsOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Grid.Row" Value="4" />
                    <Setter Property="Grid.RowSpan" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFolderContent}" Value="False">
                            <Setter Property="Grid.Row" Value="2" />
                            <Setter Property="Grid.RowSpan" Value="3" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Материалы" />
                    <TextBlock Style="{StaticResource RangeTextStyle}" Text="{Binding MaterialsShownCountText, Converter={StaticResource LibraryRangeCounterTextConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton Command="{Binding SelectAllMaterialsCommand}" Content="Все" IsChecked="{Binding IsAllFilter, Mode=OneWay}" Style="{StaticResource MaterialFilterButtonStyle}" />
                    <ToggleButton Command="{Binding SelectArticlesCommand}" Content="Статьи" IsChecked="{Binding IsArticlesFilter, Mode=OneWay}" Style="{StaticResource MaterialFilterButtonStyle}" />
                    <ToggleButton Command="{Binding SelectQuestionsCommand}" Content="Вопросы" IsChecked="{Binding IsQuestionsFilter, Mode=OneWay}" Style="{StaticResource MaterialFilterButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <loading:LoadingIndicator
                    Margin="0,28,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IndicatorLength="300"
                    IndicatorThickness="7"
                    Message="Загружаем материалы..."
                    Visibility="{Binding IsLoadingMaterials, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border
                    Padding="18"
                    Background="{DynamicResource Mnemora.Brush.Surface}"
                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding HasMaterialsError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.Error}" Text="{Binding MaterialsErrorMessage}" />
                        <Button DockPanel.Dock="Right" Margin="16,0,0,0" Command="{Binding RetryMaterialsCommand}" Content="Повторить" Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </DockPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{DynamicResource Mnemora.Brush.Surface}"
                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding IsMaterialsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                            Kind="FileDocumentOutline" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                            Text="{Binding MaterialsEmptyMessage}" />
                    </Grid>
                </Border>

                <!-- Материалы таблицей -->
                <!-- Материалы крупными плитками -->
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalContentAlignment="Top"
                    ScrollChanged="MaterialsScroll_OnScrollChanged"
                    Visibility="{Binding IsTilesView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl VerticalAlignment="Top" ItemsSource="{Binding Materials}" ItemTemplate="{StaticResource MaterialLargeTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid
                                    libraryBehaviors:ResponsiveUniformGridBehavior.DesiredColumns="{Binding DataContext.DesiredTilesPerRow, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    libraryBehaviors:ResponsiveUniformGridBehavior.MinimumItemWidth="300"
                                    libraryBehaviors:ResponsiveUniformGridBehavior.MaximumColumns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Материалы компактными плитками -->
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalContentAlignment="Top"
                    ScrollChanged="MaterialsScroll_OnScrollChanged"
                    Visibility="{Binding IsCompactTilesView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl VerticalAlignment="Top" ItemsSource="{Binding Materials}" ItemTemplate="{StaticResource MaterialCompactTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid
                                    libraryBehaviors:ResponsiveUniformGridBehavior.DesiredColumns="{Binding DataContext.DesiredTilesPerRow, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    libraryBehaviors:ResponsiveUniformGridBehavior.MinimumItemWidth="220"
                                    libraryBehaviors:ResponsiveUniformGridBehavior.MaximumColumns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <Border
                    Background="{DynamicResource Mnemora.Brush.Surface}"
                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasMaterials}" Value="True" />
                                        <Condition Binding="{Binding IsTableView}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DataGrid
                        ItemsSource="{Binding Materials}"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="False"
                        CellStyle="{StaticResource MaterialTableCellStyle}"
                        ColumnHeaderStyle="{StaticResource MaterialTableColumnHeaderStyle}"
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        RowHeaderWidth="0"
                        RowStyle="{StaticResource MaterialTableRowStyle}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.ScrollChanged="MaterialsScroll_OnScrollChanged"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Материал" MinWidth="240" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="40" Height="40" CornerRadius="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F0ECFF" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                                                <Setter Property="Background" Value="#E6FBF8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <materialDesign:PackIcon
                                                    Width="22"
                                                    Height="22"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                            <Setter Property="Kind" Value="FileDocumentOutline" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                                                    <Setter Property="Kind" Value="HelpCircleOutline" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                    Text="{Binding TypeTitle}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Теги" MinWidth="150" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="17"
                                                Height="17"
                                                Margin="0,0,7,0"
                                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                Kind="TagOutline" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                Text="{Binding TagsText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Сложность" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MaterialDifficultyBadgeStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse
                                                    Width="7"
                                                    Height="7"
                                                    Margin="0,0,7,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDifficultyDotStyle}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DifficultyTitle}"
                                                    Style="{StaticResource MaterialDifficultyTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Баллы" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                Kind="StarOutline"
                                                ToolTip="За изучение" />
                                            <TextBlock
                                                Margin="5,0,13,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                Text="{Binding StudyPoints}" />
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Foreground="{DynamicResource Mnemora.Brush.PrimaryDark}"
                                                Kind="Refresh"
                                                ToolTip="За повторение" />
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                Text="{Binding ReviewPoints}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Header="Создан"
                                Width="105"
                                Binding="{Binding CreatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                ElementStyle="{StaticResource MaterialTableTextStyle}" />

                            <DataGridTextColumn
                                Header="Изменён"
                                Width="105"
                                Binding="{Binding UpdatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                ElementStyle="{StaticResource MaterialTableTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Догрузка материалов: плавающая плашка не участвует в layout и не сдвигает скролл -->
                <Border
                    Panel.ZIndex="50"
                    Padding="18,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F0061735"
                    CornerRadius="14"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsLoadingNextMaterialsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <loading:LoadingIndicator
                        IndicatorLength="180"
                        IndicatorThickness="5"
                        Message="Загружаем материалы..."
                        MessageForeground="White"
                        TrackBrush="#40FFFFFF" />
                </Border>
            </Grid>
        </Grid>

        <!-- Смешанное содержимое: три режима, папки всегда первыми -->
        <Grid
            Grid.Row="2"
            Grid.RowSpan="3"
            Margin="32,8,32,26"
            Visibility="{Binding IsMixedContent, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Содержимое" />
                    <TextBlock
                        Style="{StaticResource RangeTextStyle}"
                        Text="{Binding MixedShownCountText, Converter={StaticResource LibraryRangeCounterTextConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton Command="{Binding SelectAllContentCommand}" Content="Все" IsChecked="{Binding IsMixedAllFilter, Mode=OneWay}" Style="{StaticResource MaterialFilterButtonStyle}" />
                    <ToggleButton Command="{Binding SelectFoldersContentCommand}" Content="Папки" IsChecked="{Binding IsMixedFoldersFilter, Mode=OneWay}" Style="{StaticResource MaterialFilterButtonStyle}" />
                    <ToggleButton Command="{Binding SelectArticlesContentCommand}" Content="Статьи" IsChecked="{Binding IsMixedArticlesFilter, Mode=OneWay}" Style="{StaticResource MaterialFilterButtonStyle}" />
                    <ToggleButton Command="{Binding SelectQuestionsContentCommand}" Content="Вопросы" IsChecked="{Binding IsMixedQuestionsFilter, Mode=OneWay}" Style="{StaticResource MaterialFilterButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <loading:LoadingIndicator
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IndicatorLength="300"
                    IndicatorThickness="7"
                    Message="Загружаем содержимое..."
                    Visibility="{Binding IsLoadingMixed, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border
                    Padding="18"
                    Background="{DynamicResource Mnemora.Brush.Surface}"
                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding HasMixedError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.Error}" Text="{Binding MixedErrorMessage}" />
                        <Button DockPanel.Dock="Right" Margin="16,0,0,0" Command="{Binding ReloadCommand}" Content="Повторить" Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </DockPanel>
                </Border>

                <Border
                    Padding="22"
                    Background="{DynamicResource Mnemora.Brush.Surface}"
                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding IsMixedEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                            Kind="FolderMultipleOutline" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                            Text="{Binding MixedEmptyMessage}" />
                    </Grid>
                </Border>

                <!-- Смешанное содержимое крупными плитками: сначала папки, затем материалы -->
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalContentAlignment="Top"
                    ScrollChanged="MixedContentScroll_OnScrollChanged"
                    Visibility="{Binding IsTilesView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl VerticalAlignment="Top" ItemsSource="{Binding MixedContent}" ItemTemplate="{StaticResource MixedLargeTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid
                                    libraryBehaviors:ResponsiveUniformGridBehavior.DesiredColumns="{Binding DataContext.DesiredTilesPerRow, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    libraryBehaviors:ResponsiveUniformGridBehavior.MinimumItemWidth="300"
                                    libraryBehaviors:ResponsiveUniformGridBehavior.MaximumColumns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Смешанное содержимое компактными плитками -->
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalContentAlignment="Top"
                    ScrollChanged="MixedContentScroll_OnScrollChanged"
                    Visibility="{Binding IsCompactTilesView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl VerticalAlignment="Top" ItemsSource="{Binding MixedContent}" ItemTemplate="{StaticResource MixedCompactTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid
                                    libraryBehaviors:ResponsiveUniformGridBehavior.DesiredColumns="{Binding DataContext.DesiredTilesPerRow, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    libraryBehaviors:ResponsiveUniformGridBehavior.MinimumItemWidth="220"
                                    libraryBehaviors:ResponsiveUniformGridBehavior.MaximumColumns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <Border
                    Background="{DynamicResource Mnemora.Brush.Surface}"
                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasMixedItems}" Value="True" />
                                        <Condition Binding="{Binding IsTableView}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DataGrid
                        ItemsSource="{Binding MixedContent}"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="False"
                        CellStyle="{StaticResource MaterialTableCellStyle}"
                        ColumnHeaderStyle="{StaticResource MaterialTableColumnHeaderStyle}"
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        RowHeaderWidth="0"
                        RowStyle="{StaticResource MixedContentTableRowStyle}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.ScrollChanged="MixedContentScroll_OnScrollChanged"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Название" MinWidth="280" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="40" Height="40">
                                                <Border
                                                    Background="{Binding FolderColor, Converter={StaticResource LibraryFolderColorConverter}}"
                                                    CornerRadius="10"
                                                    Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <materialDesign:PackIcon
                                                        Width="22"
                                                        Height="22"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="White"
                                                        Kind="{Binding FolderIcon, Converter={StaticResource LibraryFolderIconConverter}}" />
                                                </Border>

                                                <Border
                                                    CornerRadius="10"
                                                    Visibility="{Binding IsMaterial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F0ECFF" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                                                    <Setter Property="Background" Value="#E6FBF8" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <materialDesign:PackIcon
                                                        Width="22"
                                                        Height="22"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                                <Setter Property="Kind" Value="FileDocumentOutline" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                                                        <Setter Property="Kind" Value="HelpCircleOutline" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                    Text="{Binding TypeTitle}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Детали" MinWidth="210" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                        <Setter Property="Kind" Value="TagOutline" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Kind" Value="FolderOutline" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock Style="{StaticResource MaterialTableTextStyle}" Text="{Binding DetailsText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Сложность" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            Style="{StaticResource MaterialDifficultyBadgeStyle}"
                                            Visibility="{Binding IsMaterial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Style="{StaticResource MaterialDifficultyDotStyle}" />
                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource MaterialDifficultyTextStyle}" Text="{Binding DifficultyTitle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Баллы" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsMaterial, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,5,0" Foreground="{DynamicResource Mnemora.Brush.Secondary}" Kind="StarOutline" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding StudyPoints}" />
                                            <materialDesign:PackIcon Width="18" Height="18" Margin="12,0,5,0" Foreground="{DynamicResource Mnemora.Brush.PrimaryDark}" Kind="Refresh" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding ReviewPoints}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Header="Создан"
                                Width="105"
                                Binding="{Binding CreatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                ElementStyle="{StaticResource MaterialTableTextStyle}" />
                            <DataGridTextColumn
                                Header="Изменён"
                                Width="105"
                                Binding="{Binding UpdatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                ElementStyle="{StaticResource MaterialTableTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Догрузка смешанного списка: overlay не меняет геометрию таблицы -->
                <Border
                    Panel.ZIndex="50"
                    Padding="18,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F0061735"
                    CornerRadius="14"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsLoadingNextMixedPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <loading:LoadingIndicator
                        IndicatorLength="180"
                        IndicatorThickness="5"
                        Message="Загружаем содержимое..."
                        MessageForeground="White"
                        TrackBrush="#40FFFFFF" />
                </Border>
            </Grid>
        </Grid>

        <!-- Пустой контейнер -->
        <Border
            Grid.Row="2"
            Grid.RowSpan="3"
            Margin="32,12,32,32"
            Padding="36"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource Mnemora.Brush.Surface}"
            BorderBrush="{DynamicResource Mnemora.Brush.Border}"
            BorderThickness="1"
            CornerRadius="14"
            Visibility="{Binding IsContainerEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Width="34" Height="34" HorizontalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Kind="FolderOutline" />
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding EmptyStateTitle}" />
                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="Добавьте папку или материал, чтобы начать наполнять библиотеку." />
            </StackPanel>
        </Border>

        <!-- Фатальная ошибка metadata -->
        <Border
            Grid.RowSpan="5"
            Panel.ZIndex="100"
            Width="500"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource Mnemora.Brush.Surface}"
            BorderBrush="{DynamicResource Mnemora.Brush.Border}"
            BorderThickness="1"
            CornerRadius="16"
            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <materialDesign:PackIcon Width="36" Height="36" HorizontalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.Error}" Kind="AlertCircleOutline" />
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="Не удалось открыть папку" />
                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Command="{Binding ReloadCommand}" Content="Повторить" Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button Margin="10,0,0,0" Command="{Binding NavigateLibraryCommand}" Content="В библиотеку" Style="{StaticResource MaterialDesignFlatButton}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <loading:LoadingIndicator
            Grid.RowSpan="5"
            Panel.ZIndex="90"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IndicatorLength="360"
            IndicatorThickness="8"
            Message="Открываем папку..."
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
