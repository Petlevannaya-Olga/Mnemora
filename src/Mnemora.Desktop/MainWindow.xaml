<Window x:Class="Mnemora.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mnemora - место, где знания остаются с тобой"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/Images/Mnemora.ico"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}" />

        <!-- Лёгкий каркас показывается до первого render AppShellView.
             Он находится в MainWindow, поэтому закрывает промежуток,
             когда DataTemplate основной ViewModel ещё не построен. -->
        <Grid Panel.ZIndex="50"
              Background="{StaticResource Mnemora.Brush.SurfaceMuted}"
              IsHitTestVisible="True">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInitializing}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Боковая панель -->
            <Border Grid.Column="0"
                    Background="{StaticResource Mnemora.Brush.SidebarBackground}">
                <StackPanel Margin="28,30">
                    <StackPanel Margin="0,0,0,30"
                                Orientation="Horizontal">
                        <Border Width="42"
                                Height="42"
                                Background="#245A84"
                                CornerRadius="21" />
                        <Border Width="108"
                                Height="22"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="#365477"
                                CornerRadius="6" />
                    </StackPanel>

                    <Border Height="42" Margin="0,0,0,12" Background="#244767" CornerRadius="9" />
                    <Border Height="42" Margin="0,0,0,12" Background="#1B3858" CornerRadius="9" />
                    <Border Height="42" Margin="0,0,0,12" Background="#1B3858" CornerRadius="9" />
                    <Border Height="42" Margin="0,0,0,12" Background="#1B3858" CornerRadius="9" />
                    <Border Height="42" Margin="0,0,0,12" Background="#1B3858" CornerRadius="9" />
                    <Border Height="42" Background="#1B3858" CornerRadius="9" />
                </StackPanel>
            </Border>

            <!-- Рабочая область -->
            <Grid Grid.Column="1" Margin="34,30,34,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="310"
                            Height="34"
                            HorizontalAlignment="Left"
                            Background="#D9DEE8"
                            CornerRadius="8" />
                    <Border Width="430"
                            Height="16"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Background="#E3E7EE"
                            CornerRadius="5" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Height="250"
                                Padding="26"
                                Background="{StaticResource Mnemora.Brush.Surface}"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <Border Width="190"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        Background="#D9DEE8"
                                        CornerRadius="6" />
                                <Border Height="14" Margin="0,24,70,0" Background="#E5E8EF" CornerRadius="4" />
                                <Border Height="14" Margin="0,10,125,0" Background="#E5E8EF" CornerRadius="4" />
                                <Border Height="70" Margin="0,28,0,0" Background="#EEF0F4" CornerRadius="9" />
                            </StackPanel>
                        </Border>

                        <Border Height="180"
                                Margin="0,18,0,0"
                                Padding="26"
                                Background="{StaticResource Mnemora.Brush.Surface}"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <Border Width="150" Height="20" HorizontalAlignment="Left" Background="#D9DEE8" CornerRadius="6" />
                                <Border Height="14" Margin="0,22,90,0" Background="#E5E8EF" CornerRadius="4" />
                                <Border Height="14" Margin="0,10,150,0" Background="#E5E8EF" CornerRadius="4" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Height="210"
                                Padding="24"
                                Background="{StaticResource Mnemora.Brush.Surface}"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <Border Width="130" Height="20" HorizontalAlignment="Left" Background="#D9DEE8" CornerRadius="6" />
                                <Border Width="82" Height="52" Margin="0,24,0,0" HorizontalAlignment="Left" Background="#E8EBF1" CornerRadius="8" />
                                <Border Height="12" Margin="0,22,45,0" Background="#E5E8EF" CornerRadius="4" />
                            </StackPanel>
                        </Border>

                        <Border Height="220"
                                Margin="0,18,0,0"
                                Padding="24"
                                Background="{StaticResource Mnemora.Brush.Surface}"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <Border Width="170" Height="20" HorizontalAlignment="Left" Background="#D9DEE8" CornerRadius="6" />
                                <Border Height="14" Margin="0,24,25,0" Background="#E5E8EF" CornerRadius="4" />
                                <Border Height="14" Margin="0,10,70,0" Background="#E5E8EF" CornerRadius="4" />
                                <Border Height="44" Margin="0,26,0,0" Background="#DDE3EA" CornerRadius="8" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="DialogOverlay"
                Panel.ZIndex="100"
                Background="#A0061735"
                IsHitTestVisible="True"
                Opacity="0"
                Visibility="Collapsed" />
    </Grid>

</Window>
