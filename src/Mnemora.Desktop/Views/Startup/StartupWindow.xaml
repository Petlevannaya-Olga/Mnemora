<Window x:Class="Mnemora.Desktop.Views.Startup.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loading="clr-namespace:Mnemora.Desktop.Controls.Loading"
        Title="Mnemora"
        Width="620"
        Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True">
    <Border CornerRadius="22" BorderBrush="#273B60" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#061735" />
                <GradientStop Offset="0.56" Color="#0A2144" />
                <GradientStop Offset="1" Color="#151B45" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="42,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Width="250"
                   Height="70"
                   HorizontalAlignment="Center"
                   Source="pack://application:,,,/Assets/Images/MnemoraLogo.png"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Grid Grid.Row="1" Margin="0,26,0,22">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="{Binding Title}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <loading:LoadingIndicator
                        Margin="0,30,0,0"
                        IndicatorLength="440"
                        IndicatorThickness="10"
                        IsIndeterminate="False"
                        Maximum="100"
                        Message="{Binding Details}"
                        MessageForeground="#AEBBD1"
                        PercentageForeground="#16CDB7"
                        ShowPercentage="True"
                        TrackBrush="#263C60"
                        Value="{Binding Progress, Mode=OneWay}" />
                </StackPanel>

                <Border Padding="18"
                        Background="#241D2B45"
                        BorderBrush="#5C6B8D"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FFCFD6"
                                   Text="Запуск не завершён" />
                        <TextBlock Margin="0,7,0,0"
                                   FontSize="12"
                                   Foreground="#D9E0EC"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Height="42"
                        Command="{Binding CloseCommand}"
                        Content="Закрыть Mnemora"
                        Background="Transparent"
                        BorderBrush="#536681"
                        BorderThickness="1"
                        Foreground="#DCE4F1"
                        Cursor="Hand" />

                <Button Grid.Column="2"
                        Height="42"
                        Command="{Binding RetryCommand}"
                        Content="Попробовать снова"
                        Background="#16CDB7"
                        BorderThickness="0"
                        Foreground="#061735"
                        FontWeight="SemiBold"
                        Cursor="Hand" />
            </Grid>
        </Grid>
    </Border>
</Window>
