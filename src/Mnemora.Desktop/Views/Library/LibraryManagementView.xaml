<UserControl
    x:Class="Mnemora.Desktop.Views.Library.LibraryManagementView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Mnemora.Desktop.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Loaded="LibraryManagementView_OnLoaded"
    Unloaded="LibraryManagementView_OnUnloaded"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <converters:SectionColorConverter x:Key="SectionColorConverter" />
        <converters:SectionIconConverter x:Key="SectionIconConverter" />
        <converters:TopicColorConverter x:Key="TopicColorConverter" />

        <Style x:Key="ManagementCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="SmallIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#EDE9FE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ModeBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#F7F5FF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#EEE8FF" />
                                <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdvancedEditingToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter Margin="0,0,10,0"
                                              VerticalAlignment="Center" />
                            <Border x:Name="Track"
                                    Width="42"
                                    Height="24"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    Background="#E5E8F0"
                                    CornerRadius="12">
                                <Ellipse x:Name="Thumb"
                                         Width="18"
                                         Height="18"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Fill="White" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Mnemora.Brush.Secondary}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- В простом режиме используем те же карточки и кликабельную область, что в обзоре -->
        <Style x:Key="SectionOverviewCardStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="200" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="SectionNavigationButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileOpenButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OpenBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OpenBackground" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OpenBackground" Property="Background" Value="#F2EEFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>

        <Style x:Key="SectionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F2EEFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopicItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="18,0,0,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                BorderThickness="1,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEE8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FAFBFD" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F5F2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="BorderBrush" Value="#D5E3FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MaterialTypeText}" Value="Вопрос">
                    <Setter Property="Background" Value="#F4F3FF" />
                    <Setter Property="BorderBrush" Value="#DDD8FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DifficultyBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#EAFBF5" />
            <Setter Property="BorderBrush" Value="#C9F1E4" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DifficultyText}" Value="Средне">
                    <Setter Property="Background" Value="#FFF7E9" />
                    <Setter Property="BorderBrush" Value="#FFE0A8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DifficultyText}" Value="Сложно">
                    <Setter Property="Background" Value="#FFF0F0" />
                    <Setter Property="BorderBrush" Value="#FFD2D2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SimpleSectionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryViewModeButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource Mnemora.Brush.SurfaceMuted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Mnemora.Brush.Primary}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E6FBF8" />
                                <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SimpleSectionCompactCardStyle" TargetType="Border">
            <Setter Property="Height" Value="124" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <!-- Таблица простого режима: визуально совпадает с таблицей Обзора. -->
        <Style x:Key="SimpleSectionTableTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
        </Style>

        <Style
            x:Key="SimpleSectionTableNumberStyle"
            BasedOn="{StaticResource SimpleSectionTableTextStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SimpleSectionTableColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#F6F8FC" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SimpleSectionTableRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="MouseLeftButtonUp" Handler="SimpleSectionTableRow_OnMouseLeftButtonUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Grid>
                            <Border
                                x:Name="RowBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                BorderThickness="0,0,0,1" />

                            <Border
                                x:Name="SelectionIndicator"
                                Width="4"
                                Margin="0,9,0,9"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Mnemora.Brush.Primary}"
                                CornerRadius="0,3,3,0"
                                Visibility="Collapsed" />

                            <DataGridCellsPresenter />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#F4F8FC" />
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#E8F9F6" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SimpleSectionTableCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="SimpleSectionTableDateCellStyle"
            BasedOn="{StaticResource SimpleSectionTableCellStyle}"
            TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="SimpleSectionCountIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
        </Style>

        <DataTemplate x:Key="SimpleSectionCardTemplate">
            <Grid>
                <Button Command="{Binding DataContext.OpenSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource SectionNavigationButtonStyle}"
                        ToolTip="Открыть раздел">
                    <Border Style="{StaticResource SectionOverviewCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="58" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <Border Width="54"
                                        Height="54"
                                        Background="{Binding Color, Converter={StaticResource SectionColorConverter}}"
                                        CornerRadius="13">
                                    <materialDesign:PackIcon Width="29"
                                                             Height="29"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="White"
                                                             Kind="{Binding Icon, Converter={StaticResource SectionIconConverter}}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="16,0,12,0"
                                           VerticalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,20,0,0" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopicsCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Padding="10,7" Background="#F5F7FB" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                 Kind="BookOpenPageVariant" />
                                        <TextBlock Margin="7,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                   Text="{Binding TopicsSummaryText}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="10,0,0,0" Padding="10,7" Background="#F5F7FB" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="18"
                                                                 Height="18"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                                 Kind="FileDocumentOutline" />
                                        <TextBlock Margin="7,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                   Text="{Binding MaterialsSummaryText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Margin="0,20,0,0"
                                    Padding="10,7"
                                    HorizontalAlignment="Left"
                                    Background="#F5F7FB"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopicsCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18"
                                                             Height="18"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                             Kind="BookOpenPageVariantOutline" />
                                    <TextBlock Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                               Text="Тем пока нет" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Button>

                <StackPanel Panel.ZIndex="10"
                            Margin="0,10,30,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button Command="{Binding DataContext.EditSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Редактировать раздел">
                        <materialDesign:PackIcon Width="17" Height="17" Kind="PencilOutline" />
                    </Button>
                    <Button Margin="2,0,0,0"
                            Command="{Binding DataContext.DeleteSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Foreground="#C62828"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Удалить раздел">
                        <materialDesign:PackIcon Width="17" Height="17" Kind="DeleteOutline" />
                    </Button>
                </StackPanel>

                <Button Panel.ZIndex="10"
                        Height="42"
                        Margin="22,0,38,38"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Command="{Binding DataContext.AddSimpleTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource Mnemora.SecondaryButton}"
                        ToolTip="Создать тему в разделе">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <materialDesign:PackIcon Width="19" Height="19" Kind="Plus" />
                        <TextBlock Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Создать тему" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TopicsCount}" Value="0">
                                            <Setter Property="Text" Value="Создать первую тему" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SimpleCompactSectionCardTemplate">
            <Grid>
                <!-- Вся основная область карточки открывает раздел. -->
                <Button Command="{Binding DataContext.OpenSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource SectionNavigationButtonStyle}"
                        ToolTip="Открыть раздел">
                    <Border Style="{StaticResource SimpleSectionCompactCardStyle}"
                            ToolTip="{Binding Name}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Верхняя строка: только иконка раздела. Справа поверх неё стоят действия. -->
                            <Border Grid.Row="0"
                                    Width="46"
                                    Height="46"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{Binding Color, Converter={StaticResource SectionColorConverter}}"
                                    CornerRadius="11">
                                <materialDesign:PackIcon Width="25"
                                                         Height="25"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Kind="{Binding Icon, Converter={StaticResource SectionIconConverter}}" />
                            </Border>

                            <!-- Название получает всю ширину карточки и больше не конкурирует с действиями. -->
                            <TextBlock Grid.Row="1"
                                       Margin="0,0,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" />

                            <!-- Короткие счётчики тем и материалов. -->
                            <StackPanel Grid.Row="2"
                                        Margin="0,3,0,0"
                                        Orientation="Horizontal">
                                <StackPanel Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            ToolTip="Количество тем">
                                    <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                             Kind="BookOpenPageVariant" />
                                    <TextBlock Margin="5,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                               Text="{Binding TopicsCount}" />
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            ToolTip="Количество материалов">
                                    <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                             Kind="FileDocumentOutline" />
                                    <TextBlock Margin="5,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                               Text="{Binding MaterialsCount}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Button>

                <!-- Все действия остаются в привычном верхнем правом углу. -->
                <StackPanel Panel.ZIndex="10"
                            Margin="0,14,26,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button Width="27"
                            Height="26"
                            Command="{Binding DataContext.AddSimpleTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Создать тему">
                        <Grid Width="17" Height="17">
                            <materialDesign:PackIcon Width="15"
                                                     Height="15"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Bottom"
                                                     Kind="BookOpenPageVariantOutline" />
                            <Border Width="8"
                                    Height="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Mnemora.Brush.Surface}"
                                    CornerRadius="4">
                                <materialDesign:PackIcon Width="8"
                                                         Height="8"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Kind="Plus" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Width="27"
                            Height="26"
                            Command="{Binding DataContext.EditSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Редактировать раздел">
                        <materialDesign:PackIcon Width="15" Height="15" Kind="PencilOutline" />
                    </Button>

                    <Button Width="27"
                            Height="26"
                            Command="{Binding DataContext.DeleteSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Foreground="#C62828"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Удалить раздел">
                        <materialDesign:PackIcon Width="15" Height="15" Kind="DeleteOutline" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource Mnemora.Brush.SurfaceMuted}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="32,28,32,22">
            <TextBlock Style="{StaticResource Mnemora.Heading}"
                       Text="Управление библиотекой" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource Mnemora.Description}"
                       Text="Создавайте структуру базы знаний и настраивайте свой порядок" />
        </StackPanel>

        <!-- Общая панель поиска -->
        <Grid Grid.Row="1" Margin="32,0,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Height="52"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Поиск по названию раздела..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            <ComboBox Grid.Column="2"
                      Height="52"
                      VerticalContentAlignment="Center"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding SimpleSectionSortOptions}"
                      SelectedItem="{Binding SelectedSimpleSectionSortOption, Mode=TwoWay}"
                      materialDesign:HintAssist.Hint="Сортировка">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSimpleSectionsPage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <StackPanel Grid.Column="3"
                        Margin="4,0,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding IsSimpleSectionsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ToggleButton Command="{Binding ShowSimpleTilesViewCommand}"
                              IsChecked="{Binding IsSimpleTilesView, Mode=OneWay}"
                              Style="{StaticResource LibraryViewModeButtonStyle}"
                              ToolTip="Большие плитки">
                    <materialDesign:PackIcon Width="22" Height="22" Kind="ViewGridOutline" />
                </ToggleButton>
                <ToggleButton Command="{Binding ShowSimpleCompactTilesViewCommand}"
                              IsChecked="{Binding IsSimpleCompactTilesView, Mode=OneWay}"
                              Style="{StaticResource LibraryViewModeButtonStyle}"
                              ToolTip="Маленькие плитки">
                    <materialDesign:PackIcon Width="22" Height="22" Kind="ViewGrid" />
                </ToggleButton>
                <ToggleButton Command="{Binding ShowSimpleTableViewCommand}"
                              IsChecked="{Binding IsSimpleTableView, Mode=OneWay}"
                              Style="{StaticResource LibraryViewModeButtonStyle}"
                              ToolTip="Таблица">
                    <materialDesign:PackIcon Width="22" Height="22" Kind="FormatListBulleted" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- ПРОСТОЙ РЕЖИМ: разделы -->
        <Grid Grid.Row="2"
              Margin="32,0,32,28"
              Visibility="{Binding IsSimpleSectionsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                           Text="Разделы" />

                <Button Grid.Column="1"
                        Height="40"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding AddSectionCommand}"
                        Style="{StaticResource Mnemora.PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18" Height="18" Kind="Plus" />
                        <TextBlock Margin="8,0,0,0" Text="Создать раздел" />
                    </StackPanel>
                </Button>

                <ToggleButton Grid.Column="3"
                              VerticalAlignment="Center"
                              Command="{Binding ToggleEditingModeCommand}"
                              Content="Расширенное редактирование"
                              IsChecked="{Binding IsAdvancedMode, Mode=OneWay}"
                              Style="{StaticResource AdvancedEditingToggleStyle}" />
            </Grid>

            <Grid Grid.Row="1">
                <!-- Большие плитки: виртуализируем строки по 3 карточки. -->
                <ListBox ItemsSource="{Binding SimpleSectionRows}"
                         ItemContainerStyle="{StaticResource SimpleSectionListBoxItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.ScrollChanged="SectionsScroll_OnScrollChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding IsSimpleTilesView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Sections}"
                                          ItemTemplate="{StaticResource SimpleSectionCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Маленькие плитки: виртуализируем строки по 4 карточки. -->
                <ListBox ItemsSource="{Binding SimpleCompactSectionRows}"
                         ItemContainerStyle="{StaticResource SimpleSectionListBoxItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.ScrollChanged="SectionsScroll_OnScrollChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding IsSimpleCompactTilesView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Sections}"
                                          ItemTemplate="{StaticResource SimpleCompactSectionCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Таблица: штатная виртуализация строк DataGrid. -->
                <Border Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="14"
                        Visibility="{Binding IsSimpleTableView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding SimpleSections}"
                              AutoGenerateColumns="False"
                              Background="Transparent"
                              BorderThickness="0"
                              CellStyle="{StaticResource SimpleSectionTableCellStyle}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              ColumnHeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              RowStyle="{StaticResource SimpleSectionTableRowStyle}"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.ScrollChanged="SectionsScroll_OnScrollChanged"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Header="Раздел"
                                MinWidth="260"
                                Width="*"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="42"
                                                Height="42"
                                                Background="{Binding Color, Converter={StaticResource SectionColorConverter}}"
                                                CornerRadius="11">
                                                <materialDesign:PackIcon
                                                    Width="23"
                                                    Height="23"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Kind="{Binding Icon, Converter={StaticResource SectionIconConverter}}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                    Text="{Binding StructureText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Темы"
                                Width="90"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ViewGridOutline" Style="{StaticResource SimpleSectionCountIconStyle}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding TopicsCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Материалы"
                                Width="115"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FormatListBulleted" Style="{StaticResource SimpleSectionCountIconStyle}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding MaterialsCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Статьи"
                                Width="95"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileDocumentOutline" Style="{StaticResource SimpleSectionCountIconStyle}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding ArticlesCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Вопросы"
                                Width="100"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Style="{StaticResource SimpleSectionCountIconStyle}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding QuestionsCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Header="Создан"
                                Width="105"
                                Binding="{Binding CreatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                CellStyle="{StaticResource SimpleSectionTableDateCellStyle}"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}"
                                ElementStyle="{StaticResource SimpleSectionTableTextStyle}" />

                            <DataGridTextColumn
                                Header="Изменён"
                                Width="105"
                                Binding="{Binding UpdatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                CellStyle="{StaticResource SimpleSectionTableDateCellStyle}"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}"
                                ElementStyle="{StaticResource SimpleSectionTableTextStyle}" />

                            <DataGridTextColumn
                                Header="Активность"
                                Width="115"
                                Binding="{Binding LastActivityAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                CellStyle="{StaticResource SimpleSectionTableDateCellStyle}"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}"
                                ElementStyle="{StaticResource SimpleSectionTableTextStyle}" />

                            <!-- Управляющие действия остаются только в Управлении. -->
                            <DataGridTemplateColumn
                                Width="118"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button
                                                Command="{Binding DataContext.AddSimpleTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                ToolTip="Создать тему">
                                                <materialDesign:PackIcon Width="17" Height="17" Kind="BookPlusOutline" />
                                            </Button>
                                            <Button
                                                Command="{Binding DataContext.EditSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                ToolTip="Редактировать раздел">
                                                <materialDesign:PackIcon Width="17" Height="17" Kind="PencilOutline" />
                                            </Button>
                                            <Button
                                                Command="{Binding DataContext.DeleteSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#C62828"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                ToolTip="Удалить раздел">
                                                <materialDesign:PackIcon Width="17" Height="17" Kind="DeleteOutline" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Initial loading. -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsSimpleSectionsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Width="140"
                                 Height="4"
                                 Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                 IsIndeterminate="True" />
                    <TextBlock Margin="0,14,0,0"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Загружаем разделы..." />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoSimpleSectionSearchResults}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Width="50"
                                             Height="50"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                             Kind="Magnify" />
                    <TextBlock Margin="0,15,0,0"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="Разделы не найдены" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Попробуйте изменить поисковый запрос." />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsSimpleSectionsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Width="50"
                                             Height="50"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                             Kind="FolderOutline" />
                    <TextBlock Margin="0,15,0,0"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="Разделов пока нет" />
                </StackPanel>

                <Border Width="480"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource ManagementCardStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <materialDesign:PackIcon Width="42"
                                                 Height="42"
                                                 HorizontalAlignment="Center"
                                                 Foreground="#C62828"
                                                 Kind="AlertCircleOutline" />
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding ReloadCommand}"
                                Content="Повторить"
                                Style="{StaticResource Mnemora.SecondaryButton}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Нижняя строка: счётчик слева + incremental status. -->
            <Grid Grid.Row="2" MinHeight="54" Margin="0,8,0,0">
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="{Binding SimpleSectionsShownCountText}" />

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding IsSimpleSectionsLoadingNextPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Width="110"
                                 Height="4"
                                 Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                 IsIndeterminate="True" />
                    <TextBlock Margin="12,0,0,0"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Загружаем ещё..." />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding HasSimpleSectionsNextPageError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="{Binding SimpleSectionsNextPageErrorMessage}" />
                    <Button Command="{Binding RetryNextSimpleSectionPageCommand}"
                            Content="Повторить"
                            Style="{StaticResource Mnemora.SecondaryButton}" />
                </StackPanel>

            </Grid>
        </Grid>

        <!-- ПРОСТОЙ РЕЖИМ: темы выбранного раздела -->
        <Grid Grid.Row="2"
              Margin="32,0,32,18"
              Visibility="{Binding IsSimpleTopicsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Height="40"
                        Command="{Binding BackSimpleCommand}"
                        Style="{StaticResource Mnemora.SecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18" Height="18" Kind="ArrowLeft" />
                        <TextBlock Margin="8,0,0,0" Text="Разделы" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="{Binding SelectedSection.Name}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Темы раздела" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasTopics, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Topics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="150"
                                        Margin="0,0,18,18"
                                        Padding="20"
                                        Style="{StaticResource ManagementCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="44"
                                                    Height="44"
                                                    VerticalAlignment="Top"
                                                    Background="{Binding Topic.Color, Converter={StaticResource TopicColorConverter}}"
                                                    CornerRadius="11">
                                                <materialDesign:PackIcon Width="24"
                                                                         Height="24"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="White"
                                                                         Kind="{Binding IconKind}" />
                                            </Border>

                                            <Button Grid.Column="1"
                                                    Margin="10,0,6,0"
                                                    Padding="5,2"
                                                    Command="{Binding DataContext.OpenSimpleTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TileOpenButtonStyle}">
                                                <StackPanel>
                                                    <TextBlock FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                               Text="{Binding ItemCountText}"
                                                               Visibility="{Binding HasItemCount, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Button>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.EditTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallIconButtonStyle}"
                                                        ToolTip="Редактировать тему">
                                                    <materialDesign:PackIcon Width="17" Height="17" Kind="PencilOutline" />
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="#C62828"
                                                        Style="{StaticResource SmallIconButtonStyle}"
                                                        ToolTip="Удалить тему">
                                                    <materialDesign:PackIcon Width="17" Height="17" Kind="DeleteOutline" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Margin="56,16,0,0"
                                                   VerticalAlignment="Bottom"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                   Text="{Binding Topic.CreatedAt, StringFormat='Создана {0:dd.MM.yyyy}'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Width="500"
                        Padding="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ManagementCardStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSelectedSection}" Value="True" />
                                        <Condition Binding="{Binding HasTopics}" Value="False" />
                                        <Condition Binding="{Binding IsContextLoading}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <materialDesign:PackIcon Width="44"
                                                 Height="44"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                 Kind="BookOpenPageVariantOutline" />
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                   Text="Тем пока нет" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                   Text="Создайте первую тему в этом разделе" />
                        <Button Margin="0,18,0,0"
                                Height="42"
                                HorizontalAlignment="Center"
                                Command="{Binding AddTopicCommand}"
                                Style="{StaticResource Mnemora.PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="Plus" />
                                <TextBlock Margin="8,0,0,0" Text="Создать тему" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ПРОСТОЙ РЕЖИМ: материалы выбранной темы -->
        <Grid Grid.Row="2"
              Margin="32,0,32,18"
              Visibility="{Binding IsSimpleMaterialsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Height="40"
                        Command="{Binding BackSimpleCommand}"
                        Style="{StaticResource Mnemora.SecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18" Height="18" Kind="ArrowLeft" />
                        <TextBlock Margin="8,0,0,0" Text="Темы" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="{Binding SelectedTopic.Name}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="{Binding SelectedSection.Name, StringFormat='Раздел: {0}'}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource ManagementCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="18,16,18,14"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="{Binding Materials.Count, StringFormat='Материалы ({0})'}" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Materials}"
                              SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                              Visibility="{Binding HasMaterials, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutoGenerateColumns="False"
                              Background="{DynamicResource Mnemora.Brush.Surface}"
                              BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                              BorderThickness="0,1,0,1"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              RowStyle="{StaticResource MaterialRowStyle}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Название" Width="2.4*" MinWidth="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Width="19"
                                                                     Height="19"
                                                                     Margin="8,0,10,0"
                                                                     Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                     Kind="{Binding IconKind}" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Тип" Width="1*" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left" Style="{StaticResource TypeBadgeStyle}">
                                            <TextBlock FontSize="11" Foreground="#315CC7" Text="{Binding MaterialTypeText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Сложность" Width="1*" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left" Style="{StaticResource DifficultyBadgeStyle}">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding DifficultyText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Обновлено"
                                                Width="1*"
                                                MinWidth="118"
                                                Binding="{Binding UpdatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}" />
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button IsEnabled="False"
                                                Style="{StaticResource SmallIconButtonStyle}">
                                            <materialDesign:PackIcon Width="17" Height="17" Kind="PencilOutline" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button IsEnabled="False"
                                                Foreground="#DC2626"
                                                Style="{StaticResource SmallIconButtonStyle}">
                                            <materialDesign:PackIcon Width="17" Height="17" Kind="DeleteOutline" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Margin="18,12,18,14"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="{Binding MaterialsShownCountText}"
                               Visibility="{Binding HasMaterials, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSelectedTopic}" Value="True" />
                                            <Condition Binding="{Binding HasMaterials}" Value="False" />
                                            <Condition Binding="{Binding IsContextLoading}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Width="50"
                                                 Height="50"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                 Kind="FileDocumentOutline" />
                        <TextBlock Margin="0,16,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                   Text="Материалов пока нет" />
                        <TextBlock Margin="0,7,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                   Text="Создайте первый материал в этой теме" />
                        <Button Margin="0,20,0,0"
                                Height="42"
                                MinWidth="190"
                                IsEnabled="False"
                                Style="{StaticResource Mnemora.PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="Plus" />
                                <TextBlock Margin="8,0,0,0" Text="Создать первый материал" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- РАСШИРЕННЫЙ РЕЖИМ -->
        <Grid Grid.Row="2"
              Margin="32,0,32,18"
              Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                           Text="Разделы" />

                <ToggleButton Grid.Column="1"
                              VerticalAlignment="Center"
                              Command="{Binding ToggleEditingModeCommand}"
                              Content="Расширенное редактирование"
                              IsChecked="{Binding IsAdvancedMode, Mode=OneWay}"
                              Style="{StaticResource AdvancedEditingToggleStyle}" />
            </Grid>

            <!-- Иерархия -->
            <Border Grid.Row="1" Style="{StaticResource ManagementCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="18,16,18,14"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="Структура библиотеки" />

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                            BorderThickness="0,1,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ListBox x:Name="SectionsList"
                                     Tag="Sections"
                                     ItemsSource="{Binding Sections}"
                                     SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource SectionItemStyle}"
                                     Style="{StaticResource TreeListBoxStyle}"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="OrderList_OnPreviewMouseLeftButtonDown"
                                     PreviewMouseMove="OrderList_OnPreviewMouseMove"
                                     DragOver="OrderList_OnDragOver"
                                     Drop="OrderList_OnDrop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Height="58" Margin="8,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="38" />
                                                </Grid.ColumnDefinitions>

                                                <Border Tag="DragHandle"
                                                        Cursor="SizeAll"
                                                        Background="Transparent">
                                                    <materialDesign:PackIcon Width="18"
                                                                             Height="18"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                                             Kind="DragVertical" />
                                                </Border>

                                                <materialDesign:PackIcon Grid.Column="1"
                                                                         Width="22"
                                                                         Height="22"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                                         Kind="{Binding IconKind}" />

                                                <TextBlock Grid.Column="2"
                                                           Margin="4,0,8,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <Border Grid.Column="3"
                                                        Margin="4,0"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasItemCount, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Background="#F7F8FB"
                                                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="5">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                               Text="{Binding ItemCountText}" />
                                                </Border>

                                                <Button Grid.Column="4"
                                                        Command="{Binding DataContext.AddTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallIconButtonStyle}"
                                                        ToolTip="Создать тему">
                                                    <materialDesign:PackIcon Width="17"
                                                                             Height="17"
                                                                             Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                             Kind="Plus" />
                                                </Button>

                                                <Button Grid.Column="5"
                                                        Command="{Binding DataContext.EditSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallIconButtonStyle}"
                                                        ToolTip="Редактировать раздел">
                                                    <materialDesign:PackIcon Width="17" Height="17" Kind="PencilOutline" />
                                                </Button>

                                                <Button Grid.Column="6"
                                                        Command="{Binding DataContext.DeleteSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SmallIconButtonStyle}"
                                                        ToolTip="Удалить раздел">
                                                    <materialDesign:PackIcon Width="17" Height="17" Kind="DeleteOutline" />
                                                </Button>
                                            </Grid>

                                            <ListBox Tag="Topics"
                                                     ItemsSource="{Binding DataContext.Topics, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     SelectedItem="{Binding DataContext.SelectedTopic, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                                                     ItemContainerStyle="{StaticResource TopicItemStyle}"
                                                     AllowDrop="True"
                                                     PreviewMouseLeftButtonDown="OrderList_OnPreviewMouseLeftButtonDown"
                                                     PreviewMouseMove="OrderList_OnPreviewMouseMove"
                                                     DragOver="OrderList_OnDragOver"
                                                     Drop="OrderList_OnDrop">
                                                <ListBox.Style>
                                                    <Style TargetType="ListBox" BasedOn="{StaticResource TreeListBoxStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.Style>

                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="56" Margin="8,0,8,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="38" />
                                                                <ColumnDefinition Width="38" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Tag="DragHandle"
                                                                    Cursor="SizeAll"
                                                                    Background="Transparent">
                                                                <materialDesign:PackIcon Width="18"
                                                                                         Height="18"
                                                                                         HorizontalAlignment="Center"
                                                                                         VerticalAlignment="Center"
                                                                                         Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                                                         Kind="DragVertical" />
                                                            </Border>

                                                            <materialDesign:PackIcon Grid.Column="1"
                                                                                     Width="20"
                                                                                     Height="20"
                                                                                     VerticalAlignment="Center"
                                                                                     Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                                     Kind="{Binding IconKind}" />

                                                            <TextBlock Grid.Column="2"
                                                                       Margin="4,0,8,0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="14"
                                                                       Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                                       Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <Border Grid.Column="3"
                                                                    Margin="4,0"
                                                                    Padding="8,3"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasItemCount, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Background="#F7F8FB"
                                                                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5">
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                                           Text="{Binding ItemCountText}" />
                                                            </Border>

                                                            <Button Grid.Column="4"
                                                                    Command="{Binding DataContext.EditTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SmallIconButtonStyle}"
                                                                    ToolTip="Редактировать тему">
                                                                <materialDesign:PackIcon Width="17" Height="17" Kind="PencilOutline" />
                                                            </Button>

                                                            <Button Grid.Column="5"
                                                                    Command="{Binding DataContext.DeleteTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SmallIconButtonStyle}"
                                                                    ToolTip="Удалить тему">
                                                                <materialDesign:PackIcon Width="17" Height="17" Kind="DeleteOutline" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="2"
                            Height="42"
                            Margin="12,8,12,10"
                            Command="{Binding AddSectionCommand}"
                            Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <materialDesign:PackIcon Width="18" Height="18" Kind="Plus" />
                            <TextBlock Margin="8,0,0,0" Text="Создать раздел" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Материалы -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ManagementCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,15,18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                       Text="{Binding SelectedTopic.Name, TargetNullValue=Материалы}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                       Text="{Binding SelectedSection.Name, StringFormat='Раздел: {0}'}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="MaterialsGrid"
                                  Tag="Materials"
                                  ItemsSource="{Binding Materials}"
                                  SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                                  Visibility="{Binding HasMaterials, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutoGenerateColumns="False"
                                  Background="{DynamicResource Mnemora.Brush.Surface}"
                                  BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                  BorderThickness="0,1,0,1"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  RowHeaderWidth="0"
                                  RowStyle="{StaticResource MaterialRowStyle}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="OrderList_OnPreviewMouseLeftButtonDown"
                                  PreviewMouseMove="OrderList_OnPreviewMouseMove"
                                  DragOver="OrderList_OnDragOver"
                                  Drop="OrderList_OnDrop">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Tag="DragHandle" Cursor="SizeAll" Background="Transparent">
                                                <materialDesign:PackIcon Width="17"
                                                                         Height="17"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                                         Kind="DragVertical" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Название" Width="2.2*" MinWidth="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Width="19"
                                                                         Height="19"
                                                                         Margin="2,0,10,0"
                                                                         Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                         Kind="{Binding IconKind}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Тип" Width="1*" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left" Style="{StaticResource TypeBadgeStyle}">
                                                <TextBlock FontSize="11" Foreground="#315CC7" Text="{Binding MaterialTypeText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Сложность" Width="1*" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left" Style="{StaticResource DifficultyBadgeStyle}">
                                                <TextBlock FontSize="11" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding DifficultyText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Обновлено"
                                                    Width="1*"
                                                    MinWidth="112"
                                                    Binding="{Binding UpdatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}" />
                                <DataGridTemplateColumn Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button IsEnabled="False" Style="{StaticResource SmallIconButtonStyle}">
                                                <materialDesign:PackIcon Width="17" Height="17" Kind="PencilOutline" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button IsEnabled="False" Foreground="#DC2626" Style="{StaticResource SmallIconButtonStyle}">
                                                <materialDesign:PackIcon Width="17" Height="17" Kind="DeleteOutline" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasSelectedTopic}" Value="True" />
                                                <Condition Binding="{Binding HasMaterials}" Value="False" />
                                                <Condition Binding="{Binding IsContextLoading}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <materialDesign:PackIcon Width="50"
                                                     Height="50"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                     Kind="FileDocumentOutline" />
                            <TextBlock Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                       Text="Материалов пока нет" />
                            <TextBlock Margin="0,7,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                       Text="Создайте первый материал в этой теме" />
                            <Button Margin="0,20,0,0"
                                    Height="42"
                                    MinWidth="190"
                                    IsEnabled="False"
                                    Style="{StaticResource Mnemora.PrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18" Height="18" Kind="Plus" />
                                    <TextBlock Margin="8,0,0,0" Text="Создать первый материал" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedTopic}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <materialDesign:PackIcon Width="44"
                                                     Height="44"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                     Kind="ArrowLeft" />
                            <TextBlock Margin="0,14,0,0"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                       Text="Выберите тему" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                       Text="Материалы выбранной темы появятся здесь" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="18,12,18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                   Text="Перетаскивайте строки, чтобы изменить пользовательский порядок"
                                   Visibility="{Binding HasMaterials, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                   Text="{Binding MaterialsShownCountText}"
                                   Visibility="{Binding HasMaterials, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижняя плашка порядка: только расширенный режим или пока есть несохранённые изменения -->
        <Border Grid.Row="3"
                Margin="32,0,32,24"
                Padding="14,11"
                Visibility="{Binding ShowOrderFooter, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ManagementCardStyle}" />
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Width="19"
                                         Height="19"
                                         Margin="0,2,10,0"
                                         Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                         Kind="InformationOutline" />

                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="12" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource Mnemora.Brush.Secondary}" Text="Мой порядок" />
                        <Run Text=" — ваш персональный порядок отображения разделов, тем и материалов." />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Этот порядок будет использоваться в библиотеке и в фильтре «Мой порядок»." />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <StackPanel Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding HasUnsavedOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Ellipse Width="8" Height="8" Fill="#F59E0B" />
                        <TextBlock Margin="7,0,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                   Text="Есть несохранённые изменения" />
                    </StackPanel>

                    <Button Height="40"
                            MinWidth="166"
                            Command="{Binding SaveOrderCommand}"
                            Style="{StaticResource Mnemora.PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="17" Height="17" Kind="ContentSaveOutline" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="Сохранить порядок" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Общая загрузка / ошибка -->
        <Border Grid.Row="2"
                Margin="32,0,32,18"
                Panel.ZIndex="50"
                Background="#CCF7F8FB"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="220"
                             Height="4"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource Mnemora.Brush.Primary}" />
                <TextBlock Margin="0,14,0,0"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="Загружаем библиотеку..." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="100"
                Padding="36"
                Panel.ZIndex="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="14"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Width="420">
                <materialDesign:PackIcon Width="42"
                                         Height="42"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                         Kind="AlertCircleOutline" />
                <TextBlock Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                           Text="Не удалось загрузить управление библиотекой" />
                <TextBlock Margin="0,8,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="{Binding ErrorMessage}" />
                <Button Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ReloadCommand}"
                        Content="Попробовать снова"
                        Style="{StaticResource Mnemora.SecondaryButton}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
