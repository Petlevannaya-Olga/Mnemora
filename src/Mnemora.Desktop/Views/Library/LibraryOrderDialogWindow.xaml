<Window
    x:Class="Mnemora.Desktop.Views.Library.LibraryOrderDialogWindow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="900"
    Height="660"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True">


    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="OrderGridColumnHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="OrderGridCellStyle"
               TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="OrderGridRowStyle"
               TargetType="DataGridRow">
            <Setter Property="Height" Value="58" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8F7FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F2EEFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <!-- Тень отдельным слоем, чтобы не размывать содержимое. -->
        <Border Margin="1"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="28"
                    Color="#061735"
                    Opacity="0.30"
                    ShadowDepth="7" />
            </Border.Effect>
        </Border>

        <Border Padding="30,26,30,28"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="50"
                            Height="50"
                            Background="#F2EEFF"
                            CornerRadius="13">
                        <materialDesign:PackIcon
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                            Kind="SwapVertical" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="16,0"
                                VerticalAlignment="Center">
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                            Text="{Binding DialogTitle}" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                Text="Перетащите строки в нужном порядке" />
                            <TextBlock
                                Margin="10,0,0,0"
                                FontSize="13"
                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                Text="{Binding ContextText}"
                                Visibility="{Binding HasContext, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Click="Cancel_OnClick"
                            Style="{StaticResource Mnemora.DialogCloseButton}">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Kind="Close" />
                    </Button>
                </Grid>

                <!-- Таблица -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="12">
                    <AdornerDecorator>
                        <DataGrid
                            x:Name="OrderGrid"
                            ItemsSource="{Binding Items}"
                            AllowDrop="True"
                            AutoGenerateColumns="False"
                            Background="{DynamicResource Mnemora.Brush.Surface}"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserResizeRows="False"
                            CanUserSortColumns="False"
                            CellStyle="{StaticResource OrderGridCellStyle}"
                            ColumnHeaderStyle="{StaticResource OrderGridColumnHeaderStyle}"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            GridLinesVisibility="None"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            PreviewMouseLeftButtonDown="OrderGrid_OnPreviewMouseLeftButtonDown"
                            PreviewMouseMove="OrderGrid_OnPreviewMouseMove"
                            DragOver="OrderGrid_OnDragOver"
                            DragLeave="OrderGrid_OnDragLeave"
                            Drop="OrderGrid_OnDrop"
                            RowHeaderWidth="0"
                            RowStyle="{StaticResource OrderGridRowStyle}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                                Tag="DragHandle"
                                                Cursor="SizeAll"
                                                Background="Transparent"
                                                ToolTip="Перетащить">
                                                <materialDesign:PackIcon
                                                    Width="19"
                                                    Height="19"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                    Kind="DragVertical" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="64"
                                    Header="№"
                                    Binding="{Binding Position}" />

                                <DataGridTemplateColumn
                                    Width="*"
                                    MinWidth="300"
                                    Header="Название">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border
                                                    Width="34"
                                                    Height="34"
                                                    Margin="0,0,12,0"
                                                    Background="#EEF4FF"
                                                    CornerRadius="9">
                                                    <materialDesign:PackIcon
                                                        Width="19"
                                                        Height="19"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                        Kind="{Binding IconKind}" />
                                                </Border>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn
                                    Width="220"
                                    Header="Детали"
                                    Binding="{Binding DetailsText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </AdornerDecorator>
                </Border>

                <!-- Кнопки -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="Фиолетовая линия показывает точное место вставки" />

                    <Button
                        Grid.Column="1"
                        MinWidth="116"
                        Height="42"
                        Click="Cancel_OnClick"
                        Content="Отмена"
                        Style="{StaticResource Mnemora.SecondaryButton}" />

                    <Button
                        Grid.Column="3"
                        MinWidth="174"
                        Height="42"
                        Click="Save_OnClick"
                        Style="{StaticResource Mnemora.PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Kind="ContentSaveOutline" />
                            <TextBlock
                                Margin="9,0,0,0"
                                VerticalAlignment="Center"
                                Text="Сохранить порядок" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
