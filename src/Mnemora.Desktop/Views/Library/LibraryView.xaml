<UserControl
    x:Class="Mnemora.Desktop.Views.Library.LibraryView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Mnemora.Desktop.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Loaded="LibraryView_OnLoaded"
    Unloaded="LibraryView_OnUnloaded"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True">

    <UserControl.Resources>

        <converters:SectionColorConverter
            x:Key="SectionColorConverter" />

        <converters:SectionIconConverter
            x:Key="SectionIconConverter" />

        <Style
            x:Key="SectionMenuButtonStyle"
            BasedOn="{StaticResource MaterialDesignFlatButton}"
            TargetType="Button">

            <Setter
                Property="Height"
                Value="48" />

            <Setter
                Property="MinWidth"
                Value="0" />

            <Setter
                Property="Padding"
                Value="10,0" />

            <Setter
                Property="Margin"
                Value="0,1" />

            <Setter
                Property="Background"
                Value="Transparent" />

            <Setter
                Property="Foreground"
                Value="{DynamicResource Mnemora.Brush.TextPrimary}" />

            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />

            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />

        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource Mnemora.Brush.SurfaceMuted}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->

        <Grid Margin="32,28,32,24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">

                <TextBlock
                    Style="{StaticResource Mnemora.Heading}"
                    Text="Библиотека" />

                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource Mnemora.Description}"
                    Text="Организуйте знания по разделам и темам" />

            </StackPanel>

            <!-- Переключатель вида -->

            <Border
                Grid.Column="1"
                Width="110"
                Padding="4"
                VerticalAlignment="Center"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="10">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Подробный список -->

                    <Button
                        Grid.Column="0"
                        Height="38"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding ShowTableViewCommand}"
                        ToolTip="Подробный список">

                        <Button.Style>
                            <Style
                                BasedOn="{StaticResource MaterialDesignFlatButton}"
                                TargetType="Button">

                                <Setter
                                    Property="Background"
                                    Value="Transparent" />

                                <Setter
                                    Property="Foreground"
                                    Value="{DynamicResource Mnemora.Brush.TextSecondary}" />

                                <Setter
                                    Property="MinWidth"
                                    Value="0" />

                                <Setter
                                    Property="MinHeight"
                                    Value="0" />

                                <Setter
                                    Property="Padding"
                                    Value="0" />

                                <Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Center" />

                                <Setter
                                    Property="VerticalContentAlignment"
                                    Value="Center" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding IsTableView}"
                                        Value="True">

                                        <Setter
                                            Property="Background"
                                            Value="#EEFFFC" />

                                        <Setter
                                            Property="Foreground"
                                            Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Kind="ViewAgendaOutline" />

                    </Button>

                    <!-- Плитки -->

                    <Button
                        Grid.Column="1"
                        Height="38"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding ShowTilesViewCommand}"
                        ToolTip="Плитки">

                        <Button.Style>
                            <Style
                                BasedOn="{StaticResource MaterialDesignFlatButton}"
                                TargetType="Button">

                                <Setter
                                    Property="Background"
                                    Value="Transparent" />

                                <Setter
                                    Property="Foreground"
                                    Value="{DynamicResource Mnemora.Brush.TextSecondary}" />

                                <Setter
                                    Property="MinWidth"
                                    Value="0" />

                                <Setter
                                    Property="MinHeight"
                                    Value="0" />

                                <Setter
                                    Property="Padding"
                                    Value="0" />

                                <Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Center" />

                                <Setter
                                    Property="VerticalContentAlignment"
                                    Value="Center" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding IsTilesView}"
                                        Value="True">

                                        <Setter
                                            Property="Background"
                                            Value="#F1ECFF" />

                                        <Setter
                                            Property="Foreground"
                                            Value="{DynamicResource Mnemora.Brush.Secondary}" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Kind="ViewGridOutline" />

                    </Button>

                </Grid>

            </Border>

            <Button
                Grid.Column="3"
                MinWidth="190"
                Command="{Binding AddSectionCommand}"
                Style="{StaticResource Mnemora.PrimaryButton}">

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="21"
                        Height="21"
                        VerticalAlignment="Center"
                        Kind="Plus" />

                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Text="Создать раздел" />

                </StackPanel>

            </Button>

        </Grid>

        <!-- Содержимое -->

        <Grid
            Grid.Row="1"
            Margin="32,0,32,28">

            <!-- Загрузка -->

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <StackPanel.Style>
                    <Style TargetType="StackPanel">

                        <Setter
                            Property="Visibility"
                            Value="Collapsed" />

                        <Style.Triggers>

                            <DataTrigger
                                Binding="{Binding IsLoading}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </StackPanel.Style>

                <ProgressBar
                    Width="220"
                    Height="4"
                    Foreground="{DynamicResource Mnemora.Brush.Primary}"
                    IsIndeterminate="True" />

                <TextBlock
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Text="Загружаем библиотеку..." />

            </StackPanel>

            <!-- Ошибка -->

            <Border
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="16">

                <Border.Style>
                    <Style TargetType="Border">

                        <Setter
                            Property="Visibility"
                            Value="Collapsed" />

                        <Style.Triggers>

                            <MultiDataTrigger>

                                <MultiDataTrigger.Conditions>

                                    <Condition
                                        Binding="{Binding HasError}"
                                        Value="True" />

                                    <Condition
                                        Binding="{Binding IsLoading}"
                                        Value="False" />

                                </MultiDataTrigger.Conditions>

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />

                            </MultiDataTrigger>

                        </Style.Triggers>

                    </Style>
                </Border.Style>

                <StackPanel Width="420">

                    <materialDesign:PackIcon
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                        Kind="AlertCircleOutline" />

                    <TextBlock
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="Не удалось загрузить библиотеку" />

                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="{Binding ErrorMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ReloadCommand}"
                        Content="Попробовать снова"
                        Style="{StaticResource Mnemora.SecondaryButton}" />

                </StackPanel>

            </Border>

            <!-- Пустая библиотека -->

            <Border
                Padding="48"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="16">

                <Border.Style>
                    <Style TargetType="Border">

                        <Setter
                            Property="Visibility"
                            Value="Collapsed" />

                        <Style.Triggers>

                            <DataTrigger
                                Binding="{Binding IsEmpty}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </Border.Style>

                <StackPanel
                    Width="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <materialDesign:PackIcon
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.Primary}"
                        Kind="FolderOutline" />

                    <TextBlock
                        Margin="0,22,0,0"
                        HorizontalAlignment="Center"
                        FontSize="25"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="В библиотеке пока нет разделов" />

                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="Создайте первый раздел, а затем добавьте в него темы и материалы."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Margin="0,28,0,0"
                        MinWidth="210"
                        HorizontalAlignment="Center"
                        Command="{Binding AddSectionCommand}"
                        Style="{StaticResource Mnemora.PrimaryButton}">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Width="21"
                                Height="21"
                                VerticalAlignment="Center"
                                Kind="Plus" />

                            <TextBlock
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Text="Создать раздел" />

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Border>

            <!-- Подробный режим -->

            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">

                        <Setter
                            Property="Visibility"
                            Value="Collapsed" />

                        <Style.Triggers>

                            <MultiDataTrigger>

                                <MultiDataTrigger.Conditions>

                                    <Condition
                                        Binding="{Binding HasSections}"
                                        Value="True" />

                                    <Condition
                                        Binding="{Binding IsLoading}"
                                        Value="False" />

                                    <Condition
                                        Binding="{Binding HasError}"
                                        Value="False" />

                                    <Condition
                                        Binding="{Binding IsTableView}"
                                        Value="True" />

                                </MultiDataTrigger.Conditions>

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />

                            </MultiDataTrigger>

                        </Style.Triggers>

                    </Style>
                </ScrollViewer.Style>

                <ItemsControl ItemsSource="{Binding Sections}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border
                                Margin="0,0,0,18"
                                Padding="24"
                                Background="{DynamicResource Mnemora.Brush.Surface}"
                                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="16">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Заголовок раздела -->

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="48"
                                            Height="48"
                                            Background="{Binding Color,
                                                Converter={StaticResource SectionColorConverter}}"
                                            CornerRadius="12">

                                            <materialDesign:PackIcon
                                                Width="27"
                                                Height="27"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                Kind="{Binding Icon,
                                                    Converter={StaticResource SectionIconConverter}}" />

                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="16,0,20,0"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                FontSize="21"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="14"
                                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                Text="{Binding Topics.Count,
                                                    StringFormat='Тем: {0}'}" />

                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            Height="42"
                                            MinWidth="160"
                                            Padding="18,0"
                                            Command="{Binding DataContext.AddTopicCommand,
                                                Source={x:Reference Root}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Mnemora.SecondaryButton}">

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon
                                                    Width="19"
                                                    Height="19"
                                                    VerticalAlignment="Center"
                                                    Kind="Plus" />

                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="Добавить тему" />

                                            </StackPanel>

                                        </Button>

                                        <!-- Действия с разделом -->

                                        <materialDesign:PopupBox
                                            Grid.Column="2"
                                            PlacementMode="BottomAndAlignRightEdges"
                                            ToolTip="Действия с разделом">

                                            <materialDesign:PopupBox.ToggleContent>

                                                <materialDesign:PackIcon
                                                    Width="22"
                                                    Height="22"
                                                    Kind="DotsVertical" />

                                            </materialDesign:PopupBox.ToggleContent>

                                            <!-- Обычный Content PopupBox -->

                                            <Border
                                                Width="220"
                                                Padding="6"
                                                Background="{DynamicResource Mnemora.Brush.Surface}"
                                                CornerRadius="10">

                                                <StackPanel>

                                                    <Button
                                                        Command="{Binding DataContext.EditSectionCommand,
                    Source={x:Reference Root}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SectionMenuButtonStyle}">

                                                        <Grid>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border
                                                                Width="32"
                                                                Height="32"
                                                                Background="#EEFFFC"
                                                                CornerRadius="8">

                                                                <materialDesign:PackIcon
                                                                    Width="18"
                                                                    Height="18"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource Mnemora.Brush.PrimaryDark}"
                                                                    Kind="PencilOutline" />

                                                            </Border>

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                                Text="Редактировать" />

                                                        </Grid>

                                                    </Button>

                                                    <Button
                                                        Command="{Binding DataContext.DeleteSectionCommand,
                    Source={x:Reference Root}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SectionMenuButtonStyle}">

                                                        <Grid>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border
                                                                Width="32"
                                                                Height="32"
                                                                Background="#FFF1F1"
                                                                CornerRadius="8">

                                                                <materialDesign:PackIcon
                                                                    Width="18"
                                                                    Height="18"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="#C62828"
                                                                    Kind="DeleteOutline" />

                                                            </Border>

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                Foreground="#C62828"
                                                                Text="Удалить" />

                                                        </Grid>

                                                    </Button>

                                                </StackPanel>

                                            </Border>

                                        </materialDesign:PopupBox>

                                    </Grid>

                                    <!-- Темы -->

                                    <Grid
                                        Grid.Row="1"
                                        Margin="0,22,0,0">

                                        <!-- Пустой раздел -->

                                        <Border
                                            Padding="20"
                                            Background="{DynamicResource Mnemora.Brush.SurfaceMuted}"
                                            CornerRadius="10">

                                            <Border.Style>
                                                <Style TargetType="Border">

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding Topics.Count}"
                                                            Value="0">

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>
                                            </Border.Style>

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon
                                                    Width="22"
                                                    Height="22"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                    Kind="BookOpenPageVariantOutline" />

                                                <TextBlock
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                    Text="В этом разделе пока нет тем" />

                                            </StackPanel>

                                        </Border>

                                        <!-- Карточки тем -->

                                        <ItemsControl ItemsSource="{Binding Topics}">

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Border
                                                        Width="250"
                                                        Height="112"
                                                        Margin="0,0,14,14"
                                                        Padding="18"
                                                        Background="{DynamicResource Mnemora.Brush.SurfaceMuted}"
                                                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="12">

                                                        <Grid>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <materialDesign:PackIcon
                                                                Width="25"
                                                                Height="25"
                                                                VerticalAlignment="Top"
                                                                Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                Kind="BookmarkOutline" />

                                                            <StackPanel
                                                                Grid.Column="1"
                                                                Margin="13,0,12,0">

                                                                <TextBlock
                                                                    FontSize="16"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    TextWrapping="Wrap" />

                                                                <TextBlock
                                                                    Margin="0,7,0,0"
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                                    Text="{Binding CreatedAt,
                                                                        StringFormat='Создана {0:dd.MM.yyyy}'}" />

                                                            </StackPanel>

                                                            <materialDesign:PackIcon
                                                                Grid.Column="2"
                                                                Width="19"
                                                                Height="19"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                Kind="ArrowRight" />

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </Grid>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

            <!-- Режим плиток -->

            <ScrollViewer
                x:Name="TilesScrollViewer"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">

                        <Setter
                            Property="Visibility"
                            Value="Collapsed" />

                        <Style.Triggers>

                            <MultiDataTrigger>

                                <MultiDataTrigger.Conditions>

                                    <Condition
                                        Binding="{Binding HasSections}"
                                        Value="True" />

                                    <Condition
                                        Binding="{Binding IsLoading}"
                                        Value="False" />

                                    <Condition
                                        Binding="{Binding HasError}"
                                        Value="False" />

                                    <Condition
                                        Binding="{Binding IsTilesView}"
                                        Value="True" />

                                </MultiDataTrigger.Conditions>

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />

                            </MultiDataTrigger>

                        </Style.Triggers>

                    </Style>
                </ScrollViewer.Style>

                <ItemsControl
                    Width="{Binding ViewportWidth,
        ElementName=TilesScrollViewer}"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Sections}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>

                            <UniformGrid
                                Columns="3"
                                HorizontalAlignment="Stretch" />

                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border
                                MinHeight="224"
                                Margin="0,0,18,18"
                                Padding="22"
                                Background="{DynamicResource Mnemora.Brush.Surface}"
                                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="16">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="52"
                                            Height="52"
                                            Background="{Binding Color,
                                                Converter={StaticResource SectionColorConverter}}"
                                            CornerRadius="13">

                                            <materialDesign:PackIcon
                                                Width="29"
                                                Height="29"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                Kind="{Binding Icon,
                                                    Converter={StaticResource SectionIconConverter}}" />

                                        </Border>

                                        <materialDesign:PopupBox
                                            Grid.Column="2"
                                            PlacementMode="BottomAndAlignRightEdges"
                                            ToolTip="Действия с разделом">

                                            <materialDesign:PopupBox.ToggleContent>

                                                <materialDesign:PackIcon
                                                    Width="22"
                                                    Height="22"
                                                    Kind="DotsVertical" />

                                            </materialDesign:PopupBox.ToggleContent>

                                            <StackPanel
                                                Width="210"
                                                Margin="4">

                                                <Button
                                                    Command="{Binding DataContext.EditSectionCommand,
                                                        Source={x:Reference Root}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Редактировать"
                                                    Style="{StaticResource SectionMenuButtonStyle}" />

                                                <Button
                                                    Command="{Binding DataContext.DeleteSectionCommand,
                                                        Source={x:Reference Root}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Удалить"
                                                    Foreground="#C62828"
                                                    Style="{StaticResource SectionMenuButtonStyle}" />

                                            </StackPanel>

                                        </materialDesign:PopupBox>

                                    </Grid>

                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="0,18,0,18">

                                        <TextBlock
                                            FontSize="21"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />

                                        <StackPanel
                                            Margin="0,10,0,0"
                                            Orientation="Horizontal">

                                            <TextBlock
                                                FontSize="14"
                                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                Text="{Binding Topics.Count,
                                                    StringFormat='Тем: {0}'}" />

                                            <TextBlock
                                                Margin="12,0"
                                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                Text="•" />

                                            <TextBlock
                                                FontSize="14"
                                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                Text="{Binding CreatedAt,
                                                    StringFormat='Создан {0:dd.MM.yyyy}'}" />

                                        </StackPanel>

                                    </StackPanel>

                                    <Button
                                        Grid.Row="2"
                                        Height="42"
                                        Command="{Binding DataContext.AddTopicCommand,
                                            Source={x:Reference Root}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource Mnemora.SecondaryButton}">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon
                                                Width="19"
                                                Height="19"
                                                Kind="Plus" />

                                            <TextBlock
                                                Margin="10,0,0,0"
                                                Text="Добавить тему" />

                                        </StackPanel>

                                    </Button>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Grid>

</UserControl>