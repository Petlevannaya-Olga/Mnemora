<UserControl
    x:Class="Mnemora.Desktop.Views.Library.LibraryOverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Mnemora.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loading="clr-namespace:Mnemora.Desktop.Controls.Loading"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="LibraryOverviewView_OnLoaded"
    Unloaded="LibraryOverviewView_OnUnloaded"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:SectionColorConverter x:Key="SectionColorConverter" />
        <converters:SectionIconConverter x:Key="SectionIconConverter" />

        <Style x:Key="SectionOverviewCardStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="220" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="SectionCompactCardStyle" TargetType="Border">
            <Setter Property="Height" Value="82" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="SectionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionNavigationButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LibraryViewModeButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource Mnemora.Brush.SurfaceMuted}" />
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Mnemora.Brush.Primary}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E6FBF8" />
                                <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTableTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
        </Style>

        <Style
            x:Key="SectionTableNumberStyle"
            BasedOn="{StaticResource SectionTableTextStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionTableColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#F6F8FC" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTableRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="MouseLeftButtonUp" Handler="SectionTableRow_OnMouseLeftButtonUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Grid>
                            <Border
                                x:Name="RowBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                BorderThickness="0,0,0,1" />

                            <Border
                                x:Name="SelectionIndicator"
                                Width="4"
                                Margin="0,9,0,9"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Mnemora.Brush.Primary}"
                                CornerRadius="0,3,3,0"
                                Visibility="Collapsed" />

                            <DataGridCellsPresenter />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#F4F8FC" />
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#E8F9F6" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTableCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="SectionTableDateCellStyle"
            BasedOn="{StaticResource SectionTableCellStyle}"
            TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="SectionCountIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
        </Style>
        <Style x:Key="LibraryScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryVerticalScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Primary}" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border
                            Margin="2,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>

                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate
            x:Key="LibraryVerticalScrollBarTemplate"
            TargetType="{x:Type ScrollBar}">
            <Grid
                Background="Transparent"
                SnapsToDevicePixels="True">
                <Border
                    Margin="3,2"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5" />

                <Track
                    x:Name="PART_Track"
                    Margin="2"
                    IsDirectionReversed="True"
                    Orientation="Vertical"
                    ViewportSize="NaN">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            Command="{x:Static ScrollBar.PageUpCommand}"
                            Style="{StaticResource LibraryScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb Style="{StaticResource LibraryVerticalScrollThumbStyle}" />
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            Command="{x:Static ScrollBar.PageDownCommand}"
                            Style="{StaticResource LibraryScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>

            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style
            x:Key="LibraryScrollBarStyle"
            BasedOn="{StaticResource {x:Type ScrollBar}}"
            TargetType="{x:Type ScrollBar}">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="16" />
                    <Setter Property="MinWidth" Value="16" />
                    <Setter Property="Margin" Value="6,2,2,2" />
                    <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Border}" />
                    <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Primary}" />
                    <Setter Property="Opacity" Value="0.9" />
                    <Setter Property="Template" Value="{StaticResource LibraryVerticalScrollBarTemplate}" />
                </Trigger>

                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Orientation" Value="Vertical" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Opacity" Value="1" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Mnemora.Brush.SurfaceMuted}">
        <Grid.Resources>
            <Style
                BasedOn="{StaticResource LibraryScrollBarStyle}"
                TargetType="{x:Type ScrollBar}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,28,32,22">
            <TextBlock Style="{StaticResource Mnemora.Heading}" Text="Библиотека" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource Mnemora.Description}"
                Text="Разделы базы знаний" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="32,0,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Height="52"
                VerticalContentAlignment="Center"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                materialDesign:HintAssist.Hint="Поиск по разделам..."
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            <ComboBox
                Grid.Column="2"
                Height="52"
                VerticalContentAlignment="Center"
                DisplayMemberPath="Name"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSortOption}"
                materialDesign:HintAssist.Hint="Сортировка"
                Style="{StaticResource MaterialDesignOutlinedComboBox}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <ToggleButton
                    Command="{Binding ShowTilesViewCommand}"
                    IsChecked="{Binding IsTilesView, Mode=OneWay}"
                    Style="{StaticResource LibraryViewModeButtonStyle}"
                    ToolTip="Плитки">
                    <materialDesign:PackIcon Width="24" Height="24" Kind="ViewGridOutline" />
                </ToggleButton>

                <ToggleButton
                    Command="{Binding ShowCompactTilesViewCommand}"
                    IsChecked="{Binding IsCompactTilesView, Mode=OneWay}"
                    Style="{StaticResource LibraryViewModeButtonStyle}"
                    ToolTip="Компактные плитки">
                    <materialDesign:PackIcon Width="24" Height="24" Kind="ViewModule" />
                </ToggleButton>

                <ToggleButton
                    Command="{Binding ShowTableViewCommand}"
                    IsChecked="{Binding IsTableView, Mode=OneWay}"
                    Style="{StaticResource LibraryViewModeButtonStyle}"
                    ToolTip="Таблица">
                    <materialDesign:PackIcon Width="24" Height="24" Kind="FormatListBulleted" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="32,0,32,28">
            <loading:LoadingIndicator
                Panel.ZIndex="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IndicatorLength="360"
                IndicatorThickness="8"
                Message="Загружаем разделы...">
                <loading:LoadingIndicator.Style>
                    <Style TargetType="{x:Type loading:LoadingIndicator}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </loading:LoadingIndicator.Style>
            </loading:LoadingIndicator>

            <Border
                Width="480"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="16"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">

                <StackPanel>
                    <materialDesign:PackIcon
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                        Kind="AlertCircleOutline" />

                    <TextBlock
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="Не удалось загрузить библиотеку" />

                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="{Binding ErrorMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ReloadCommand}"
                        Content="Попробовать снова"
                        Style="{StaticResource Mnemora.SecondaryButton}" />
                </StackPanel>
            </Border>

            <Border
                Padding="48"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="16"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon
                        Width="68"
                        Height="68"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.Primary}"
                        Kind="FolderOutline" />

                    <TextBlock
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="Разделов пока нет" />

                    <TextBlock
                        Margin="0,9,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="Создать первый раздел можно в управлении библиотекой." />
                </StackPanel>
            </Border>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding HasNoSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">

                <materialDesign:PackIcon
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Kind="Magnify" />

                <TextBlock
                    Margin="0,18,0,0"
                    FontSize="21"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                    Text="Разделы не найдены" />

                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Text="Попробуйте изменить поисковый запрос." />
            </StackPanel>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasSections}" Value="True" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding HasError}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="0,0,0,18"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                    Text="Разделы" />

                <!-- Подробные плитки -->

                <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding SectionRows}"
                    ItemContainerStyle="{StaticResource SectionListBoxItemStyle}"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.ScrollChanged="SectionsScroll_OnScrollChanged"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    Visibility="{Binding IsTilesView, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding DataContext.OpenSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SectionNavigationButtonStyle}"
                                            ToolTip="Открыть раздел">

                                            <Border Style="{StaticResource SectionOverviewCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border
                                                            Width="54"
                                                            Height="54"
                                                            Background="{Binding Color, Converter={StaticResource SectionColorConverter}}"
                                                            CornerRadius="13">
                                                            <materialDesign:PackIcon
                                                                Width="29"
                                                                Height="29"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="White"
                                                                Kind="{Binding Icon, Converter={StaticResource SectionIconConverter}}" />
                                                        </Border>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="16,0,12,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="18"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="Wrap" />

                                                        <Border
                                                            Grid.Column="2"
                                                            Padding="10,5"
                                                            VerticalAlignment="Top"
                                                            Background="#E6FBF8"
                                                            CornerRadius="7"
                                                            Visibility="{Binding HasPlannedMaterials, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            d:Visibility="Visible">

                                                            <TextBlock
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Mnemora.Brush.PrimaryDark}"
                                                                Text="{Binding PlannedText}"
                                                                d:Text="3 в плане" />
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Margin="0,16,0,0"
                                                        FontSize="14"
                                                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                        Text="{Binding StructureText}" />

                                                    <StackPanel
                                                        Grid.Row="2"
                                                        Margin="0,15,0,0"
                                                        Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        d:Visibility="Visible">

                                                        <TextBlock
                                                            FontSize="13"
                                                            Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                            Text="{Binding ProgressText}"
                                                            d:Text="12 из 18 изучено" />

                                                        <ProgressBar
                                                            Height="5"
                                                            Margin="0,9,0,0"
                                                            Maximum="100"
                                                            Background="#E6E8F1"
                                                            BorderThickness="0"
                                                            Foreground="{StaticResource Mnemora.Brush.BrandGradient}"
                                                            Value="{Binding ProgressPercentage, Mode=OneWay}"
                                                            d:Value="67" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="4" Margin="0,18,0,0">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                            Text="{Binding ActivityText}" />

                                                        <TextBlock
                                                            Margin="0,10,0,0"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                            Text="{Binding MaterialTypesText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Компактные плитки -->

                <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding CompactSectionRows}"
                    ItemContainerStyle="{StaticResource SectionListBoxItemStyle}"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.ScrollChanged="SectionsScroll_OnScrollChanged"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    Visibility="{Binding IsCompactTilesView, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding DataContext.OpenSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SectionNavigationButtonStyle}"
                                            ToolTip="Открыть раздел">

                                            <Border
                                                Style="{StaticResource SectionCompactCardStyle}"
                                                ToolTip="{Binding Name}">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Width="46"
                                                        Height="46"
                                                        Background="{Binding Color, Converter={StaticResource SectionColorConverter}}"
                                                        CornerRadius="11">
                                                        <materialDesign:PackIcon
                                                            Width="25"
                                                            Height="25"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="White"
                                                            Kind="{Binding Icon, Converter={StaticResource SectionIconConverter}}" />
                                                    </Border>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="13,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Таблица -->

                <Border
                    Grid.Row="1"
                    Background="{DynamicResource Mnemora.Brush.Surface}"
                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="14"
                    Visibility="{Binding IsTableView, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <DataGrid
                        x:Name="SectionsTable"
                        ItemsSource="{Binding Sections}"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0"
                        CellStyle="{StaticResource SectionTableCellStyle}"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="False"
                        ColumnHeaderStyle="{StaticResource SectionTableColumnHeaderStyle}"
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        RowHeaderWidth="0"
                        RowStyle="{StaticResource SectionTableRowStyle}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.ScrollChanged="SectionsScroll_OnScrollChanged"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        SizeChanged="SectionsTable_OnSizeChanged"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Header="Раздел"
                                MinWidth="260"
                                Width="*"
                                HeaderStyle="{StaticResource SectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="42"
                                                Height="42"
                                                Background="{Binding Color, Converter={StaticResource SectionColorConverter}}"
                                                CornerRadius="11">
                                                <materialDesign:PackIcon
                                                    Width="23"
                                                    Height="23"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Kind="{Binding Icon, Converter={StaticResource SectionIconConverter}}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                    Text="{Binding StructureText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Темы"
                                Width="90"
                                HeaderStyle="{StaticResource SectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ViewGridOutline" Style="{StaticResource SectionCountIconStyle}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding TopicsCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Материалы"
                                Width="115"
                                HeaderStyle="{StaticResource SectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FormatListBulleted" Style="{StaticResource SectionCountIconStyle}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding MaterialsCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Статьи"
                                Width="95"
                                HeaderStyle="{StaticResource SectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileDocumentOutline" Style="{StaticResource SectionCountIconStyle}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding ArticlesCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Вопросы"
                                Width="100"
                                HeaderStyle="{StaticResource SectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Style="{StaticResource SectionCountIconStyle}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding QuestionsCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Header="Создан"
                                Width="105"
                                Binding="{Binding CreatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                CellStyle="{StaticResource SectionTableDateCellStyle}"
                                HeaderStyle="{StaticResource SectionTableColumnHeaderStyle}"
                                ElementStyle="{StaticResource SectionTableTextStyle}" />

                            <DataGridTextColumn
                                Header="Изменён"
                                Width="105"
                                Binding="{Binding UpdatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                CellStyle="{StaticResource SectionTableDateCellStyle}"
                                HeaderStyle="{StaticResource SectionTableColumnHeaderStyle}"
                                ElementStyle="{StaticResource SectionTableTextStyle}" />

                            <DataGridTextColumn
                                Header="Активность"
                                Width="115"
                                Binding="{Binding LastActivityAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                CellStyle="{StaticResource SectionTableDateCellStyle}"
                                HeaderStyle="{StaticResource SectionTableColumnHeaderStyle}"
                                ElementStyle="{StaticResource SectionTableTextStyle}" />

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Диапазон текущей страницы -->

                <Grid Grid.Row="2" MinHeight="72">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="{Binding SectionsShownCountText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNextPageError}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <loading:LoadingIndicator
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IndicatorLength="200"
                        IndicatorThickness="6"
                        Message="Загружаем разделы..."
                        Visibility="{Binding IsLoadingNextPage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding HasNextPageError, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <TextBlock
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                            Text="{Binding NextPageErrorMessage}" />

                        <Button
                            Command="{Binding RetryNextPageCommand}"
                            Content="Повторить"
                            Style="{StaticResource Mnemora.SecondaryButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
