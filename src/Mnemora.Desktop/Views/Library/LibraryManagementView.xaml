                <StackPanel Panel.ZIndex="10"
                            Margin="0,10,30,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button Command="{Binding DataContext.EditSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Редактировать раздел">
                        <materialDesign:PackIcon Width="17" Height="17" Kind="PencilOutline" />
                    </Button>
                    <Button Margin="2,0,0,0"
                            Command="{Binding DataContext.DeleteSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Foreground="#C62828"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Удалить раздел">
                        <materialDesign:PackIcon Width="17" Height="17" Kind="DeleteOutline" />
                    </Button>
                </StackPanel>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SimpleCompactSectionCardTemplate">
            <Grid>
                <!-- Вся основная область карточки открывает раздел. -->
                <Button Command="{Binding DataContext.OpenSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource SectionNavigationButtonStyle}"
                        ToolTip="Открыть раздел">
                    <Border Style="{StaticResource SimpleSectionCompactCardStyle}"
                            ToolTip="{Binding Name}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Верхняя строка: иконка раздела. Действия остаются справа поверх карточки. -->
                            <Border Grid.Row="0"
                                    Width="46"
                                    Height="46"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{Binding Color, Converter={StaticResource SectionColorConverter}}"
                                    CornerRadius="11">
                                <materialDesign:PackIcon Width="25"
                                                         Height="25"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Kind="{Binding Icon, Converter={StaticResource SectionIconConverter}}" />
                            </Border>

                            <!-- Нижняя строка: название слева, компактные счётчики справа. -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           MinWidth="0"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Bottom"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />

                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal">
                                    <StackPanel Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                ToolTip="Количество папок">
                                        <materialDesign:PackIcon Width="16"
                                                                 Height="16"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                 Kind="FolderOutline" />
                                        <TextBlock Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                   Text="{Binding FoldersCount}" />
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                ToolTip="Количество материалов">
                                        <materialDesign:PackIcon Width="16"
                                                                 Height="16"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                                 Kind="FileDocumentOutline" />
                                        <TextBlock Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                   Text="{Binding MaterialsCount}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Button>

                <!-- Редактирование и удаление остаются в привычном верхнем правом углу. -->
                <StackPanel Panel.ZIndex="10"
                            Margin="0,14,26,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button Width="27"
                            Height="26"
                            Command="{Binding DataContext.EditSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Редактировать раздел">
                        <materialDesign:PackIcon Width="15" Height="15" Kind="PencilOutline" />
                    </Button>

                    <Button Width="27"
                            Height="26"
                            Command="{Binding DataContext.DeleteSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Foreground="#C62828"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Удалить раздел">
                        <materialDesign:PackIcon Width="15" Height="15" Kind="DeleteOutline" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Простой режим: карточки тем в стиле Обзора/Управления. -->
        <Style x:Key="SimpleTopicCardStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="154" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <DataTemplate x:Key="SimpleTopicCardTemplate">
            <Grid>
                <Button Command="{Binding DataContext.OpenSimpleTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource SectionNavigationButtonStyle}"
                        ToolTip="Открыть тему">
                    <Border Style="{StaticResource SimpleTopicCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="74" />
                                </Grid.ColumnDefinitions>

                                <Border Width="54"
                                        Height="54"
                                        Background="{Binding TopicColor, Converter={StaticResource TopicColorConverter}}"
                                        CornerRadius="13">
                                    <materialDesign:PackIcon Width="29"
                                                             Height="29"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="White"
                                                             Kind="{Binding IconKind}" />
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Margin="16,0,12,0"
                                           VerticalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Margin="0,20,0,0"
                                    Padding="10,7"
                                    HorizontalAlignment="Left"
                                    Background="#F5F7FB"
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18"
                                                             Height="18"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                             Kind="FileDocumentOutline" />
                                    <TextBlock Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                               Text="{Binding TopicMaterialsSummaryText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Button>

                <StackPanel Panel.ZIndex="10"
                            Margin="0,14,16,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button Command="{Binding DataContext.EditTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Редактировать тему">
                        <materialDesign:PackIcon Width="17" Height="17" Kind="PencilOutline" />
                    </Button>
                    <Button Command="{Binding DataContext.DeleteTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Foreground="#C62828"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Удалить тему">
                        <materialDesign:PackIcon Width="17" Height="17" Kind="DeleteOutline" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SimpleCompactTopicCardTemplate">
            <Grid>
                <Button Command="{Binding DataContext.OpenSimpleTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource SectionNavigationButtonStyle}"
                        ToolTip="Открыть тему">
                    <Border Style="{StaticResource SimpleSectionCompactCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Width="46"
                                    Height="46"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{Binding TopicColor, Converter={StaticResource TopicColorConverter}}"
                                    CornerRadius="11">
                                <materialDesign:PackIcon Width="25"
                                                         Height="25"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="White"
                                                         Kind="{Binding IconKind}" />
                            </Border>

                            <!-- Нижняя строка: название темы слева, количество материалов справа. -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           MinWidth="0"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Bottom"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />

                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal"
                                            ToolTip="Количество материалов">
                                    <materialDesign:PackIcon Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                             Kind="FileDocumentOutline" />
                                    <TextBlock Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                               Text="{Binding TopicMaterialsCount}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Button>

                <StackPanel Panel.ZIndex="10"
                            Margin="0,14,26,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button Width="27"
                            Height="26"
                            Command="{Binding DataContext.EditTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Редактировать тему">
                        <materialDesign:PackIcon Width="15" Height="15" Kind="PencilOutline" />
                    </Button>
                    <Button Width="27"
                            Height="26"
                            Command="{Binding DataContext.DeleteTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Foreground="#C62828"
                            Style="{StaticResource SmallIconButtonStyle}"
                            ToolTip="Удалить тему">
                        <materialDesign:PackIcon Width="15" Height="15" Kind="DeleteOutline" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="SimpleTopicTableRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="MouseLeftButtonUp" Handler="SimpleTopicTableRow_OnMouseLeftButtonUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Grid>
                            <Border x:Name="RowBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                    BorderThickness="0,0,0,1" />
                            <Border x:Name="SelectionIndicator"
                                    Width="4"
                                    Margin="0,9,0,9"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Mnemora.Brush.Primary}"
                                    CornerRadius="0,3,3,0"
                                    Visibility="Collapsed" />
                            <DataGridCellsPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#F4F8FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#E8F9F6" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SimpleMaterialTableRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Grid>
                            <Border x:Name="RowBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                    BorderThickness="0,0,0,1" />
                            <Border x:Name="SelectionIndicator"
                                    Width="4"
                                    Margin="0,9,0,9"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Mnemora.Brush.Primary}"
                                    CornerRadius="0,3,3,0"
                                    Visibility="Collapsed" />
                            <DataGridCellsPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#F4F8FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#E8F9F6" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryVerticalScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Primary}" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border
                            Margin="2,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate
            x:Key="LibraryVerticalScrollBarTemplate"
            TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
                <Border
                    Margin="3,2"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5" />

                <Track
                    x:Name="PART_Track"
                    Margin="2"
                    IsDirectionReversed="True"
                    Orientation="Vertical"
                    ViewportSize="NaN">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            Command="{x:Static ScrollBar.PageUpCommand}"
                            Style="{StaticResource LibraryScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource LibraryVerticalScrollThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            Command="{x:Static ScrollBar.PageDownCommand}"
                            Style="{StaticResource LibraryScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style
            x:Key="LibraryScrollBarStyle"
            BasedOn="{StaticResource {x:Type ScrollBar}}"
            TargetType="{x:Type ScrollBar}">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="16" />
                    <Setter Property="MinWidth" Value="16" />
                    <Setter Property="Margin" Value="6,2,2,2" />
                    <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Border}" />
                    <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Primary}" />
                    <Setter Property="Opacity" Value="0.9" />
                    <Setter Property="Template" Value="{StaticResource LibraryVerticalScrollBarTemplate}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Orientation" Value="Vertical" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Opacity" Value="1" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource Mnemora.Brush.SurfaceMuted}">
        <Grid.Resources>
            <Style
                BasedOn="{StaticResource LibraryScrollBarStyle}"
                TargetType="{x:Type ScrollBar}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок показываем только на корневом уровне.
             На вложенных уровнях контекст задают хлебные крошки и шапка выбранного элемента. -->
        <StackPanel Grid.Row="0" Margin="32,28,32,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSimpleSectionsPage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Style="{StaticResource Mnemora.Heading}"
                       Text="Управление библиотекой" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource Mnemora.Description}"
                       Text="Создавайте структуру базы знаний и настраивайте свой порядок" />

            <!-- Отделяем контекст страницы от рабочей панели инструментов. -->
            <Border Height="1"
                    Margin="0,22,0,0"
                    Background="{DynamicResource Mnemora.Brush.Border}" />
        </StackPanel>

        <!-- Панель управления разделами: тот же полноширинный toolbar, что в обзоре. -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="32,16"
                Background="{DynamicResource Mnemora.Brush.ToolbarSurface}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSimpleSectionsPage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Height="52"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Поиск по названию раздела..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <ComboBox Grid.Column="2"
                          Height="52"
                          VerticalContentAlignment="Center"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding SimpleSectionSortOptions}"
                          SelectedItem="{Binding SelectedSimpleSectionSortOption, Mode=TwoWay}"
                          materialDesign:HintAssist.Hint="Сортировка"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                <Button Grid.Column="4"
                        Height="44"
                        MinWidth="190"
                        VerticalAlignment="Center"
                        Click="ConfigureSectionsOrder_OnClick"
                        Style="{StaticResource Mnemora.SecondaryButton}"
                        Visibility="{Binding HasSimpleSections, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 VerticalAlignment="Center"
                                                 Kind="SwapVertical" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Настроить порядок" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="6"
                        Height="44"
                        MinWidth="160"
                        VerticalAlignment="Center"
                        Command="{Binding AddSectionCommand}"
                        Style="{StaticResource Mnemora.PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18" Height="18" Kind="Plus" />
                        <TextBlock Margin="8,0,0,0" Text="Создать раздел" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ПРОСТОЙ РЕЖИМ: разделы -->
        <Grid Grid.Row="2"
              Margin="32,8,32,28"
              Visibility="{Binding IsSimpleSectionsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,18"
                Orientation="Horizontal"
                Visibility="{Binding HasSimpleSections, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                    Text="Разделы" />

                <TextBlock
                    Margin="12,2,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="Normal"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Opacity="0.68"
                    Text="{Binding SimpleSectionsShownCountText, Converter={StaticResource LibraryRangeCounterTextConverter}}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <!-- Таблица: штатная виртуализация строк DataGrid. -->
                <Border Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="14"
                        Visibility="{Binding HasSimpleSections, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding SimpleSections}"
                              AutoGenerateColumns="False"
                              Background="Transparent"
                              BorderThickness="0"
                              CellStyle="{StaticResource SimpleSectionTableCellStyle}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              ColumnHeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              RowStyle="{StaticResource SimpleSectionTableRowStyle}"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.ScrollChanged="SectionsScroll_OnScrollChanged"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SizeChanged="SimpleSectionsTable_OnSizeChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Header="Раздел"
                                MinWidth="260"
                                Width="*"
                                HeaderStyle="{StaticResource SimpleSectionTableFirstColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="42"
                                                Height="42"
                                                Background="{Binding Color, Converter={StaticResource SectionColorConverter}}"
                                                CornerRadius="11">
                                                <materialDesign:PackIcon
                                                    Width="23"
                                                    Height="23"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Kind="{Binding Icon, Converter={StaticResource SectionIconConverter}}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                    Text="{Binding StructureText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Папки"
                                Width="90"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderOutline" Style="{StaticResource SimpleSectionCountIconStyle}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding FoldersCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Материалы"
                                Width="115"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FormatListBulleted" Style="{StaticResource SimpleSectionCountIconStyle}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding MaterialsCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Статьи"
                                Width="95"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileDocumentOutline" Style="{StaticResource SimpleSectionCountIconStyle}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding ArticlesCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn
                                Header="Вопросы"
                                Width="100"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Style="{StaticResource SimpleSectionCountIconStyle}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding QuestionsCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Header="Создан"
                                Width="105"
                                Binding="{Binding CreatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                CellStyle="{StaticResource SimpleSectionTableDateCellStyle}"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}"
                                ElementStyle="{StaticResource SimpleSectionTableTextStyle}" />

                            <DataGridTextColumn
                                Header="Изменён"
                                Width="105"
                                Binding="{Binding UpdatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                CellStyle="{StaticResource SimpleSectionTableDateCellStyle}"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}"
                                ElementStyle="{StaticResource SimpleSectionTableTextStyle}" />

                            <DataGridTextColumn
                                Header="Активность"
                                Width="115"
                                Binding="{Binding LastActivityAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                CellStyle="{StaticResource SimpleSectionTableDateCellStyle}"
                                HeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}"
                                ElementStyle="{StaticResource SimpleSectionTableTextStyle}" />

                            <!-- Управляющие действия остаются только в Управлении. -->
                            <DataGridTemplateColumn
                                Width="82"
                                CellStyle="{StaticResource SimpleSectionTableActionsCellStyle}"
                                HeaderStyle="{StaticResource SimpleSectionTableLastColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button
                                                Command="{Binding DataContext.EditSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                ToolTip="Редактировать раздел">
                                                <materialDesign:PackIcon Width="17" Height="17" Kind="PencilOutline" />
                                            </Button>
                                            <Button
                                                Command="{Binding DataContext.DeleteSimpleSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#C62828"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                ToolTip="Удалить раздел">
                                                <materialDesign:PackIcon Width="17" Height="17" Kind="DeleteOutline" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Догрузка как в Обзоре: overlay не участвует в layout и не двигает скролл. -->
                <Border
                    Panel.ZIndex="50"
                    Padding="18,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DelayedLoadingHostStyle}"
                    Background="#F0061735"
                    CornerRadius="14"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsSimpleSectionsPaging, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <loading:LoadingIndicator
                        IndicatorLength="180"
                        IndicatorThickness="5"
                        Message="Загружаем разделы..."
                        MessageForeground="White"
                        TrackBrush="#40FFFFFF" />
                </Border>

                <!-- Initial loading: светлый вариант, как в Обзоре. -->
                <loading:LoadingIndicator Panel.ZIndex="50"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IndicatorLength="360"
                                          IndicatorThickness="8"
                                          Message="Загружаем разделы..."
                                          Visibility="{Binding IsSimpleSectionsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoSimpleSectionSearchResults}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Width="50"
                                             Height="50"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                             Kind="Magnify" />
                    <TextBlock Margin="0,15,0,0"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="Разделы не найдены" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Попробуйте изменить поисковый запрос." />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsSimpleSectionsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Width="50"
                                             Height="50"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                             Kind="FolderOutline" />
                    <TextBlock Margin="0,15,0,0"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="Разделов пока нет" />
                </StackPanel>

                <Border Width="480"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource ManagementCardStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <materialDesign:PackIcon Width="42"
                                                 Height="42"
                                                 HorizontalAlignment="Center"
                                                 Foreground="#C62828"
                                                 Kind="AlertCircleOutline" />
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding ReloadCommand}"
                                Content="Повторить"
                                Style="{StaticResource Mnemora.SecondaryButton}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ошибка догрузки остаётся отдельной служебной строкой, как в Обзоре. -->
            <Grid Grid.Row="2" MinHeight="72">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSimpleSectionsNextPageError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="{Binding SimpleSectionsNextPageErrorMessage}" />
                    <Button
                        Command="{Binding RetryNextSimpleSectionPageCommand}"
                        Content="Повторить"
                        Style="{StaticResource Mnemora.SecondaryButton}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- УПРАВЛЕНИЕ КОНКРЕТНЫМ РАЗДЕЛОМ: дерево папок + материалы выбранного контейнера. -->
        <Grid Grid.Row="2"
              Margin="32,24,32,28"
              Visibility="{Binding IsSectionStructurePage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Margin="0,0,0,18"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Command="{Binding BackSimpleCommand}"
                    Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                    Style="{StaticResource TileOpenButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="18"
                                             Height="18"
                                             VerticalAlignment="Center"
                                             Kind="ChevronLeft" />
                    <TextBlock Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Text="Назад к разделам" />
                </StackPanel>
            </Button>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="58"
                        Height="58"
                        Background="{Binding SectionStructure.Section.Color, Converter={StaticResource SectionColorConverter}}"
                        CornerRadius="14">
                    <materialDesign:PackIcon Width="30"
                                             Height="30"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="White"
                                             Kind="{Binding SectionStructure.Section.Icon, Converter={StaticResource SectionIconConverter}}" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="{Binding SectionStructure.Section.Name}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Структура раздела" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Height="1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Mnemora.Brush.Border}" />

            <Grid Grid.Row="3">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SectionStructure.IsSectionEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Root-контейнер раздела не показываем как папку: его материалы доступны через «Без папки». -->
                <Border Grid.Column="0"
                        Padding="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ManagementCardStyle}">
                            <Setter Property="Width" Value="320" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SectionStructure.IsTreeCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="20,18,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                       Text="Структура" />

                            <Button Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Command="{Binding SectionStructure.ToggleTreeCommand}"
                                    ToolTip="Свернуть дерево папок">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SmallIconButtonStyle}" />
                                </Button.Style>
                                <materialDesign:PackIcon Width="16"
                                                         Height="16"
                                                         Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                         Kind="ChevronLeft" />
                            </Button>
                        </Grid>

                        <Button Grid.Row="1"
                                MinHeight="38"
                                Margin="12,0,12,8"
                                Padding="8,6"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding SectionStructure.SelectRootMaterialsCommand}"
                                Cursor="Hand"
                                ToolTip="Материалы, которые лежат непосредственно в разделе">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SectionStructure.HasRootMaterials}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.72" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding SectionStructure.IsRootSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="19"
                                                         Height="19"
                                                         Margin="0,0,9,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                         Kind="FileDocumentOutline" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=FontWeight}"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           Text="Без папки" />
                            </StackPanel>
                        </Button>


                        <Border Grid.Row="2"
                                Panel.ZIndex="50"
                                Padding="18,14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource DelayedLoadingHostStyle}"
                                Background="#F0061735"
                                CornerRadius="14"
                                IsHitTestVisible="False"
                                Visibility="{Binding SectionStructure.IsLoadingFolders, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <loading:LoadingIndicator IndicatorLength="180"
                                                      IndicatorThickness="5"
                                                      Message="Загружаем папки..."
                                                      MessageForeground="White"
                                                      TrackBrush="#40FFFFFF" />
                        </Border>

                        <TreeView Grid.Row="2"
                                  Margin="8,0,8,12"
                                  Padding="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ItemsSource="{Binding SectionStructure.RootNode.Children}"
                                  SelectedItemChanged="SectionStructureTree_OnSelectedItemChanged"
                                  ScrollViewer.ScrollChanged="SectionStructureTree_OnScrollChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <TreeView.Style>
                                <Style TargetType="TreeView" BasedOn="{StaticResource MaterialDesignTreeView}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SectionStructure.HasFolders}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.Style>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Setter Property="materialDesign:TreeViewAssist.ShowSelection" Value="False" />
                                    <EventSetter Event="Expanded" Handler="SectionStructureTreeItem_OnExpanded" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavigationNode}" Value="True">
                                            <Setter Property="Cursor" Value="Hand" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Cursor" Value="Hand" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                            <Setter Property="Focusable" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoadMore}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                            <Setter Property="Focusable" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type viewModels:LibrarySectionManagementTreeNodeViewModel}"
                                                          ItemsSource="{Binding Children}">
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="MinHeight" Value="38" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                        <Setter Property="Height" Value="1" />
                                                        <Setter Property="MinHeight" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLoadMore}" Value="True">
                                                        <Setter Property="Height" Value="1" />
                                                        <Setter Property="MinHeight" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border Padding="8,6" Background="Transparent">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNavigationNode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <materialDesign:PackIcon Width="19"
                                                                             Height="19"
                                                                             Margin="0,0,9,0"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{Binding Color, Converter={StaticResource LibraryFolderColorConverter}}"
                                                                             Kind="{Binding Icon, Converter={StaticResource LibraryFolderIconConverter}}" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Border Width="1"
                                                        Height="1"
                                                        Background="Transparent"
                                                        IsHitTestVisible="False">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLoadMore}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <StackPanel Margin="4,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <materialDesign:PackIcon Width="17"
                                                                             Height="17"
                                                                             Margin="0,0,7,0"
                                                                             Foreground="#C62828"
                                                                             Kind="AlertCircleOutline" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="#C62828"
                                                               Text="{Binding Name}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="Transparent">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="24" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SectionStructure.IsTreeCollapsed}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Width="32"
                                Height="32"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Command="{Binding SectionStructure.ToggleTreeCommand}"
                                ToolTip="Показать дерево папок">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SmallIconButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SectionStructure.IsTreeCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <materialDesign:PackIcon Width="18"
                                                     Height="18"
                                                     Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                     Kind="SitemapOutline" />
                        </Button>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                       Text="Материалы" />
                            <TextBlock Margin="10,1,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                       Text="{Binding SectionStructure.MaterialsShownCountText, Converter={StaticResource LibraryRangeCounterTextConverter}}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Border Background="{DynamicResource Mnemora.Brush.Surface}"
                                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                CornerRadius="14"
                                Visibility="{Binding SectionStructure.HasMaterials, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid x:Name="SectionStructureMaterialsTable"
                                      AutoGenerateColumns="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      CellStyle="{StaticResource SimpleSectionTableCellStyle}"
                                      ColumnHeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}"
                                      EnableColumnVirtualization="True"
                                      EnableRowVirtualization="True"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding SectionStructure.Materials}"
                                      RowHeaderWidth="0"
                                      RowStyle="{StaticResource SimpleMaterialTableRowStyle}"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.ScrollChanged="SectionStructureMaterialsScroll_OnScrollChanged"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      SizeChanged="SimpleSectionsTable_OnSizeChanged"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="2.5*"
                                                            MinWidth="280"
                                                            Header="Материал"
                                                            HeaderStyle="{StaticResource SimpleSectionTableFirstColumnHeaderStyle}">
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style BasedOn="{StaticResource SimpleSectionTableCellStyle}" TargetType="DataGridCell">
                                                <Setter Property="Padding" Value="16,8,14,8" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="44"
                                                            Height="44"
                                                            VerticalAlignment="Center"
                                                            Background="#EEF4FF"
                                                            CornerRadius="11">
                                                        <materialDesign:PackIcon Width="23"
                                                                                 Height="23"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                                 Kind="{Binding IconKind}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="130" Header="Тип">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border HorizontalAlignment="Left" Style="{StaticResource TypeBadgeStyle}">
                                                    <TextBlock FontSize="11"
                                                               Foreground="#315CC7"
                                                               Text="{Binding MaterialTypeText}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="140" Header="Вопросы">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                           Text="{Binding ArticleQuestionCountText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="130" Header="Сложность">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border HorizontalAlignment="Left" Style="{StaticResource DifficultyBadgeStyle}">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                               Text="{Binding DifficultyText}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Width="130"
                                                        Binding="{Binding UpdatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                                        CellStyle="{StaticResource SimpleSectionTableDateCellStyle}"
                                                        Header="Изменён"
                                                        HeaderStyle="{StaticResource SimpleSectionTableLastColumnHeaderStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Panel.ZIndex="50"
                                Padding="18,14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource DelayedLoadingHostStyle}"
                                Background="#F0061735"
                                CornerRadius="14"
                                IsHitTestVisible="False"
                                Visibility="{Binding SectionStructure.IsMaterialsPaging, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <loading:LoadingIndicator IndicatorLength="180"
                                                      IndicatorThickness="5"
                                                      Message="Загружаем материалы..."
                                                      MessageForeground="White"
                                                      TrackBrush="#40FFFFFF" />
                        </Border>

                        <Border Panel.ZIndex="50"
                                Padding="18,14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource DelayedLoadingHostStyle}"
                                Background="#F0061735"
                                CornerRadius="14"
                                IsHitTestVisible="False"
                                Visibility="{Binding SectionStructure.IsLoadingMaterials, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <loading:LoadingIndicator IndicatorLength="300"
                                                      IndicatorThickness="7"
                                                      Message="Загружаем материалы..."
                                                      MessageForeground="White"
                                                      TrackBrush="#40FFFFFF" />
                        </Border>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding SectionStructure.IsMaterialsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon Width="54"
                                                     Height="54"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                     Kind="FileDocumentOutline" />
                            <TextBlock Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                       Text="{Binding SectionStructure.EmptyMaterialsTitle}" />
                            <TextBlock Margin="0,7,0,0"
                                       MaxWidth="430"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                       Text="{Binding SectionStructure.EmptyMaterialsDescription}" />
                            <Button Margin="0,18,0,0"
                                    Height="42"
                                    MinWidth="180"
                                    Command="{Binding StartCreateSectionStructureMaterialCommand}"
                                    Style="{StaticResource Mnemora.PrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18" Height="18" Kind="Plus" />
                                    <TextBlock Margin="8,0,0,0" Text="Создать материал" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Width="430"
                                Padding="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource ManagementCardStyle}"
                                Visibility="{Binding SectionStructure.HasMaterialsError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <materialDesign:PackIcon Width="38"
                                                         Height="38"
                                                         HorizontalAlignment="Center"
                                                         Foreground="#C62828"
                                                         Kind="AlertCircleOutline" />
                                <TextBlock Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                           Text="{Binding SectionStructure.MaterialsErrorMessage}"
                                           TextWrapping="Wrap" />
                                <Button Margin="0,16,0,0"
                                        HorizontalAlignment="Center"
                                        Command="{Binding SectionStructure.RetryMaterialsCommand}"
                                        Content="Повторить"
                                        Style="{StaticResource Mnemora.SecondaryButton}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="3"
                  Visibility="{Binding SectionStructure.IsSectionEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel MaxWidth="620"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="76"
                            Height="76"
                            HorizontalAlignment="Center"
                            Background="#EEFFFC"
                            CornerRadius="20">
                        <materialDesign:PackIcon Width="42"
                                                 Height="42"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Mnemora.Brush.PrimaryDark}"
                                                 Kind="FolderPlusOutline" />
                    </Border>

                    <TextBlock Margin="0,22,0,0"
                               HorizontalAlignment="Center"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="Раздел пока пуст" />

                    <TextBlock Margin="0,9,0,0"
                               MaxWidth="560"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               LineHeight="21"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Добавьте первый материал или создайте папку, чтобы начать формировать структуру." />

                    <StackPanel Margin="0,24,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Height="44"
                                MinWidth="190"
                                Command="{Binding StartCreateSectionStructureMaterialCommand}"
                                Style="{StaticResource Mnemora.PrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="FileDocumentPlusOutline" />
                                <TextBlock Margin="8,0,0,0" Text="Создать материал" />
                            </StackPanel>
                        </Button>

                        <Button Height="44"
                                MinWidth="180"
                                Margin="12,0,0,0"
                                Command="{Binding CreateSectionStructureFolderCommand}"
                                Style="{StaticResource Mnemora.SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="FolderPlusOutline" />
                                <TextBlock Margin="8,0,0,0" Text="Создать папку" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ПРОСТОЙ РЕЖИМ: темы выбранного раздела -->
        <Grid Grid.Row="2"
              Margin="32,28,32,28"
              Visibility="{Binding IsSimpleTopicsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Back-link как в Обзоре: текущий раздел не дублируем в хлебных крошках. -->
            <Button Grid.Row="0"
                    Margin="0,0,0,20"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding BackSimpleCommand}"
                    Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                    Style="{StaticResource TileOpenButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="18"
                                             Height="18"
                                             VerticalAlignment="Center"
                                             Kind="ChevronLeft" />
                    <TextBlock Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Text="Разделы" />
                </StackPanel>
            </Button>

            <!-- Шапка выбранного раздела. -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="64"
                        Height="64"
                        Background="{Binding SelectedSection.Color, Converter={StaticResource SectionColorConverter}}"
                        CornerRadius="15">
                    <materialDesign:PackIcon Width="34"
                                             Height="34"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="White"
                                             Kind="{Binding SelectedSection.IconKind}" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="{Binding SelectedSection.Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Темы раздела" />
                </StackPanel>
            </Grid>

            <!-- Поиск, сортировка и режим отображения — как в Обзоре и на уровне разделов. -->
            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Height="52"
                         VerticalContentAlignment="Center"
                         Text="{Binding SimpleTopicSearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Поиск по названию темы..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <ComboBox Grid.Column="2"
                          Height="52"
                          VerticalContentAlignment="Center"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding SimpleTopicSortOptions}"
                          SelectedItem="{Binding SelectedSimpleTopicSortOption, Mode=TwoWay}"
                          materialDesign:HintAssist.Hint="Сортировка"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal">
                    <ToggleButton Command="{Binding ShowSimpleTilesViewCommand}"
                                  IsChecked="{Binding IsSimpleTilesView, Mode=OneWay}"
                                  Style="{StaticResource LibraryViewModeButtonStyle}"
                                  ToolTip="Большие плитки">
                        <materialDesign:PackIcon Width="22" Height="22" Kind="ViewGridOutline" />
                    </ToggleButton>
                    <ToggleButton Command="{Binding ShowSimpleCompactTilesViewCommand}"
                                  IsChecked="{Binding IsSimpleCompactTilesView, Mode=OneWay}"
                                  Style="{StaticResource LibraryViewModeButtonStyle}"
                                  ToolTip="Маленькие плитки">
                        <materialDesign:PackIcon Width="22" Height="22" Kind="ViewGrid" />
                    </ToggleButton>
                    <ToggleButton Command="{Binding ShowSimpleTableViewCommand}"
                                  IsChecked="{Binding IsSimpleTableView, Mode=OneWay}"
                                  Style="{StaticResource LibraryViewModeButtonStyle}"
                                  ToolTip="Таблица">
                        <materialDesign:PackIcon Width="22" Height="22" Kind="FormatListBulleted" />
                    </ToggleButton>
                </StackPanel>

                <Button Grid.Column="6"
                        Height="44"
                        MinWidth="190"
                        VerticalAlignment="Center"
                        Click="ConfigureTopicsOrder_OnClick"
                        Style="{StaticResource Mnemora.SecondaryButton}"
                        Visibility="{Binding HasSimpleTopicSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 VerticalAlignment="Center"
                                                 Kind="SwapVertical" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Настроить порядок" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="3">
                <!-- Большие плитки: виртуализируем строки по 3 карточки. -->
                <ListBox ItemsSource="{Binding SimpleTopicRows}"
                         ItemContainerStyle="{StaticResource SimpleSectionListBoxItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.ScrollChanged="TopicsScroll_OnScrollChanged"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSimpleTopics}" Value="True" />
                                        <Condition Binding="{Binding IsSimpleTilesView}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding DataContext.AddTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        ToolTip="Создать тему">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CreateLargeEntityTileButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirstRow}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="48" Height="48" HorizontalAlignment="Center" Background="#26FFFFFF" CornerRadius="24">
                                            <materialDesign:PackIcon Width="25" Height="25"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Foreground="White" Kind="BookPlusOutline" />
                                        </Border>
                                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="White" Text="Создать тему" />
                                    </StackPanel>
                                </Button>

                                <ItemsControl Grid.Column="1" Grid.ColumnSpan="2"
                                              ItemsSource="{Binding Topics}"
                                              ItemTemplate="{StaticResource SimpleTopicCardTemplate}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirstRow}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <ItemsControl Grid.Column="0" Grid.ColumnSpan="3"
                                              ItemsSource="{Binding Topics}"
                                              ItemTemplate="{StaticResource SimpleTopicCardTemplate}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirstRow}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Компактные плитки: 4 карточки в строке, как на уровне разделов. -->
                <ListBox ItemsSource="{Binding SimpleCompactTopicRows}"
                         ItemContainerStyle="{StaticResource SimpleSectionListBoxItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.ScrollChanged="TopicsScroll_OnScrollChanged"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSimpleTopics}" Value="True" />
                                        <Condition Binding="{Binding IsSimpleCompactTilesView}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding DataContext.AddTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        ToolTip="Создать тему">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CreateCompactEntityTileButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirstRow}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="20" Height="20"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="White" Kind="BookPlusOutline" />
                                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Text="Создать тему" />
                                    </StackPanel>
                                </Button>

                                <ItemsControl Grid.Column="1" Grid.ColumnSpan="3"
                                              ItemsSource="{Binding Topics}"
                                              ItemTemplate="{StaticResource SimpleCompactTopicCardTemplate}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirstRow}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <ItemsControl Grid.Column="0" Grid.ColumnSpan="4"
                                              ItemsSource="{Binding Topics}"
                                              ItemTemplate="{StaticResource SimpleCompactTopicCardTemplate}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirstRow}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Таблица в тех же стилях, что и таблица разделов/Обзор. -->
                <Border Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSimpleTopics}" Value="True" />
                                        <Condition Binding="{Binding IsSimpleTableView}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <DataGrid ItemsSource="{Binding SimpleTopics}"
                              AutoGenerateColumns="False"
                              Background="Transparent"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              ColumnHeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              HorizontalScrollBarVisibility="Disabled"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              RowStyle="{StaticResource SimpleTopicTableRowStyle}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.ScrollChanged="TopicsScroll_OnScrollChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*" MinWidth="270" Header="Тема">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource SimpleSectionTableCellStyle}">
                                        <Setter Property="Padding" Value="16,8,14,8" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="44"
                                                    Height="44"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding TopicColor, Converter={StaticResource TopicColorConverter}}"
                                                    CornerRadius="11">
                                                <materialDesign:PackIcon Width="23"
                                                                         Height="23"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="White"
                                                                         Kind="{Binding IconKind}" />
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                           Text="{Binding TopicMaterialsSummaryText}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="112" Header="Материалы">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource SimpleSectionTableCellStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Style="{StaticResource SimpleSectionCountIconStyle}" Kind="FormatListBulleted" />
                                            <TextBlock Style="{StaticResource SimpleSectionTableNumberStyle}" Text="{Binding TopicMaterialsCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="100" Header="Статьи">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource SimpleSectionTableCellStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Style="{StaticResource SimpleSectionCountIconStyle}" Kind="FileDocumentOutline" />
                                            <TextBlock Style="{StaticResource SimpleSectionTableNumberStyle}" Text="{Binding TopicArticlesCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="100" Header="Вопросы">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource SimpleSectionTableCellStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon Style="{StaticResource SimpleSectionCountIconStyle}" Kind="HelpCircleOutline" />
                                            <TextBlock Style="{StaticResource SimpleSectionTableNumberStyle}" Text="{Binding TopicQuestionsCount}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Width="118"
                                                Binding="{Binding TopicCreatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                                CellStyle="{StaticResource SimpleSectionTableDateCellStyle}"
                                                Header="Создана" />

                            <DataGridTextColumn Width="124"
                                                Binding="{Binding TopicLastActivityAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                                CellStyle="{StaticResource SimpleSectionTableDateCellStyle}"
                                                Header="Активность" />

                            <DataGridTemplateColumn Width="88" Header="">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource SimpleSectionTableCellStyle}">
                                        <Setter Property="Padding" Value="4,8,10,8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.EditTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SmallIconButtonStyle}"
                                                    ToolTip="Редактировать тему">
                                                <materialDesign:PackIcon Width="16" Height="16" Kind="PencilOutline" />
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="#C62828"
                                                    Style="{StaticResource SmallIconButtonStyle}"
                                                    ToolTip="Удалить тему">
                                                <materialDesign:PackIcon Width="16" Height="16" Kind="DeleteOutline" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Пустой раздел занимает всё свободное место, без дополнительной карточки. -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSimpleTopicsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <materialDesign:PackIcon Width="58"
                                             Height="58"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                             Kind="BookOpenPageVariantOutline" />
                    <TextBlock Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="В разделе пока нет тем" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Создайте первую тему в этом разделе" />
                    <Button Height="42"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding AddTopicCommand}"
                            Style="{StaticResource Mnemora.PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="18" Height="18" Kind="BookPlusOutline" />
                            <TextBlock Margin="8,0,0,0" Text="Создать первую тему" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasNoSimpleTopicSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Width="48"
                                             Height="48"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                             Kind="Magnify" />
                    <TextBlock Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="Темы не найдены" />
                    <TextBlock Margin="0,7,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Попробуйте изменить поисковый запрос" />
                </StackPanel>

                <Border Panel.ZIndex="50"
                        Padding="18,14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource DelayedLoadingHostStyle}"
                        Background="#F0061735"
                        CornerRadius="14"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsContextLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <loading:LoadingIndicator IndicatorLength="360"
                                              IndicatorThickness="8"
                                              Message="Загружаем темы..."
                                              MessageForeground="White"
                                              TrackBrush="#40FFFFFF" />
                </Border>
            </Grid>

            <Grid Grid.Row="4" MinHeight="72" Margin="0,8,0,0">
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="{Binding SimpleTopicsShownCountText}"
                           Visibility="{Binding HasSimpleTopicSource, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Padding="14,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource DelayedLoadingHostStyle}"
                        Background="#F0061735"
                        CornerRadius="12"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsSimpleTopicsPaging, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <loading:LoadingIndicator IndicatorLength="200"
                                              IndicatorThickness="6"
                                              Message="Загружаем темы..."
                                              MessageForeground="White"
                                              TrackBrush="#40FFFFFF" />
                </Border>

                <Button Height="42"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding AddTopicCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Mnemora.PrimaryButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSimpleTopicSource}" Value="True" />
                                        <Condition Binding="{Binding IsSimpleTableView}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18" Height="18" Kind="BookPlusOutline" />
                        <TextBlock Margin="8,0,0,0" Text="Создать тему" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ПРОСТОЙ РЕЖИМ: материалы выбранной темы -->
        <Grid Grid.Row="2"
              Margin="32,28,32,28"
              Visibility="{Binding IsSimpleMaterialsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Back-link как на уровне тем: текущую тему не дублируем в крошках. -->
            <Button Grid.Row="0"
                    Margin="0,0,0,20"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding BackSimpleCommand}"
                    Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                    Style="{StaticResource TileOpenButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="18"
                                             Height="18"
                                             VerticalAlignment="Center"
                                             Kind="ChevronLeft" />
                    <TextBlock Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Text="Темы" />
                </StackPanel>
            </Button>

            <!-- Шапка выбранной темы — по тому же шаблону, что шапка раздела. -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="64"
                        Height="64"
                        Background="{Binding SelectedTopic.TopicColor, Converter={StaticResource TopicColorConverter}}"
                        CornerRadius="15">
                    <materialDesign:PackIcon Width="34"
                                             Height="34"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="White"
                                             Kind="{Binding SelectedTopic.IconKind}" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="{Binding SelectedTopic.Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Материалы темы" />
                </StackPanel>
            </Grid>

            <!-- Поиск + тип материала + сортировка — как в Обзоре. -->
            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Height="52"
                         VerticalContentAlignment="Center"
                         Text="{Binding SimpleMaterialSearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Поиск по материалам..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ToggleButton Command="{Binding SelectAllSimpleMaterialsCommand}"
                                  Content="Все"
                                  IsChecked="{Binding IsSimpleAllMaterialsFilter, Mode=OneWay}"
                                  Style="{StaticResource MaterialFilterButtonStyle}" />
                    <ToggleButton Command="{Binding SelectSimpleArticlesCommand}"
                                  Content="Статьи"
                                  IsChecked="{Binding IsSimpleArticlesFilter, Mode=OneWay}"
                                  Style="{StaticResource MaterialFilterButtonStyle}" />
                    <ToggleButton Command="{Binding SelectSimpleQuestionsCommand}"
                                  Content="Вопросы"
                                  IsChecked="{Binding IsSimpleQuestionsFilter, Mode=OneWay}"
                                  Style="{StaticResource MaterialFilterButtonStyle}" />
                </StackPanel>

                <ComboBox Grid.Column="4"
                          Height="52"
                          VerticalContentAlignment="Center"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding SimpleMaterialSortOptions}"
                          SelectedItem="{Binding SelectedSimpleMaterialSortOption, Mode=TwoWay}"
                          materialDesign:HintAssist.Hint="Сортировка"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                <Button Grid.Column="6"
                        Height="44"
                        MinWidth="190"
                        VerticalAlignment="Center"
                        Click="ConfigureMaterialsOrder_OnClick"
                        Style="{StaticResource Mnemora.SecondaryButton}"
                        Visibility="{Binding HasSimpleMaterialSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 VerticalAlignment="Center"
                                                 Kind="SwapVertical" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Настроить порядок" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="3">
                <!-- Таблица материалов: те же таблицные стили, что в управлении разделами/темами. -->
                <Border Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="14"
                        Visibility="{Binding HasSimpleMaterials, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding SimpleMaterials}"
                              SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              Background="{DynamicResource Mnemora.Brush.Surface}"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              CellStyle="{StaticResource SimpleSectionTableCellStyle}"
                              ColumnHeaderStyle="{StaticResource SimpleSectionTableColumnHeaderStyle}"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              RowStyle="{StaticResource SimpleMaterialTableRowStyle}"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.ScrollChanged="MaterialsScroll_OnScrollChanged"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="2.5*" MinWidth="280" Header="Материал">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource SimpleSectionTableCellStyle}">
                                        <Setter Property="Padding" Value="16,8,14,8" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="44"
                                                    Height="44"
                                                    VerticalAlignment="Center"
                                                    Background="#EEF4FF"
                                                    CornerRadius="11">
                                                <materialDesign:PackIcon Width="23"
                                                                         Height="23"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                         Kind="{Binding IconKind}" />
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="130" Header="Тип">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left" Style="{StaticResource TypeBadgeStyle}">
                                            <TextBlock FontSize="11"
                                                       Foreground="#315CC7"
                                                       Text="{Binding MaterialTypeText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="140" Header="Вопросы">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                   Text="{Binding ArticleQuestionCountText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="130" Header="Сложность">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left" Style="{StaticResource DifficultyBadgeStyle}">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                       Text="{Binding DifficultyText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Width="130"
                                                Binding="{Binding UpdatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                                                CellStyle="{StaticResource SimpleSectionTableDateCellStyle}"
                                                Header="Изменён" />

                            <DataGridTemplateColumn Width="88" Header="">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource SimpleSectionTableActionsCellStyle}">
                                        <Setter Property="Padding" Value="4,8,10,8" />
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button IsEnabled="False"
                                                    Style="{StaticResource SmallIconButtonStyle}"
                                                    ToolTip="Редактирование материала подключим вместе с Desktop-формой">
                                                <materialDesign:PackIcon Width="16" Height="16" Kind="PencilOutline" />
                                            </Button>
                                            <Button IsEnabled="False"
                                                    Foreground="#C62828"
                                                    Style="{StaticResource SmallIconButtonStyle}"
                                                    ToolTip="Удаление материала подключим вместе с Desktop-формой">
                                                <materialDesign:PackIcon Width="16" Height="16" Kind="DeleteOutline" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Пустая тема занимает всё свободное место, как в Обзоре. -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsSimpleMaterialsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Width="62"
                                             Height="62"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                             Kind="FileDocumentOutline" />
                    <TextBlock Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="В теме пока нет материалов" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Создайте первый материал в этой теме" />
                    <Button Margin="0,20,0,0"
                            Height="44"
                            MinWidth="220"
                            Command="{Binding StartCreateMaterialCommand}"
                            Style="{StaticResource Mnemora.PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="18" Height="18" Kind="Plus" />
                            <TextBlock Margin="8,0,0,0" Text="Создать первый материал" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasNoSimpleMaterialResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Width="54"
                                             Height="54"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                             Kind="Magnify" />
                    <TextBlock Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                               Text="Материалы не найдены" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="Измените запрос или выбранный фильтр." />
                </StackPanel>

                <loading:LoadingIndicator Panel.ZIndex="50"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IndicatorLength="360"
                                          IndicatorThickness="8"
                                          Message="Загружаем материалы..."
                                          Visibility="{Binding IsContextLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <!-- Служебная строка: счётчик слева, создание — справа, как в табличном режиме выше. -->
            <Grid Grid.Row="4"
                  MinHeight="72"
                  Margin="0,8,0,0"
                  Visibility="{Binding HasSimpleMaterialSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="{Binding SimpleMaterialsShownCountText}" />

                <Border Padding="14,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource DelayedLoadingHostStyle}"
                        Background="#F0061735"
                        CornerRadius="12"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsSimpleMaterialsPaging, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <loading:LoadingIndicator IndicatorLength="200"
                                              IndicatorThickness="6"
                                              Message="Загружаем материалы..."
                                              MessageForeground="White"
                                              TrackBrush="#40FFFFFF" />
                </Border>

                <Button Height="44"
                        MinWidth="180"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding StartCreateMaterialCommand}"
                        Style="{StaticResource Mnemora.PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18" Height="18" Kind="Plus" />
                        <TextBlock Margin="8,0,0,0" Text="Создать материал" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Общая загрузка / ошибка -->
        <Border Grid.Row="2"
                Margin="32,0,32,18"
                Panel.ZIndex="50"
                Background="#88F7F8FB"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Child.Child.IsPresented}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Padding="20,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DelayedLoadingHostStyle}"
                    Background="#F0061735"
                    CornerRadius="14"
                    IsHitTestVisible="False">
                <loading:LoadingIndicator IndicatorLength="380"
                                          IndicatorThickness="9"
                                          Message="Загружаем библиотеку..."
                                          MessageForeground="White"
                                          TrackBrush="#40FFFFFF" />
            </Border>
        </Border>

        <Border Grid.Row="2"
                Margin="100"
                Padding="36"
                Panel.ZIndex="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="14"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Width="420">
                <materialDesign:PackIcon Width="42"
                                         Height="42"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                         Kind="AlertCircleOutline" />
                <TextBlock Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                           Text="Не удалось загрузить управление библиотекой" />
                <TextBlock Margin="0,8,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="{Binding ErrorMessage}" />
                <Button Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ReloadCommand}"
                        Content="Попробовать снова"
                        Style="{StaticResource Mnemora.SecondaryButton}" />
            </StackPanel>
        </Border>

        <!-- Создание материала открывается поверх текущей темы.
             Видимость контролирует LibraryManagementViewModel,
             а состояние мастера живёт в отдельном CreateMaterialViewModel. -->
        <Grid Grid.RowSpan="4"
              Panel.ZIndex="100"
              Visibility="{Binding IsCreatingMaterial, Converter={StaticResource BooleanToVisibilityConverter}}">
            <views:CreateMaterialView DataContext="{Binding CreateMaterial}" />
        </Grid>
    </Grid>
</UserControl>
