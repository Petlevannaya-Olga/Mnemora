<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Базовые цвета Mnemora -->

    <Color x:Key="Mnemora.Color.Navy">#061735</Color>
    <Color x:Key="Mnemora.Color.NavyLight">#102A59</Color>
    <Color x:Key="Mnemora.Color.Teal">#16CDB7</Color>
    <Color x:Key="Mnemora.Color.TealDark">#00A997</Color>
    <Color x:Key="Mnemora.Color.Purple">#7C4DFF</Color>
    <Color x:Key="Mnemora.Color.Surface">#FFFFFF</Color>
    <Color x:Key="Mnemora.Color.SurfaceMuted">#F7F8FE</Color>
    <Color x:Key="Mnemora.Color.TextPrimary">#111B52</Color>
    <Color x:Key="Mnemora.Color.TextSecondary">#62698A</Color>
    <Color x:Key="Mnemora.Color.Border">#E1E4F2</Color>
    <Color x:Key="Mnemora.Color.Error">#D94A4A</Color>
    <Color x:Key="Mnemora.Color.Warning">#C98200</Color>

    <!-- Кисти -->

    <SolidColorBrush x:Key="Mnemora.Brush.Error" Color="{StaticResource Mnemora.Color.Error}" />
    
    <SolidColorBrush x:Key="Mnemora.Brush.Warning" Color="{StaticResource Mnemora.Color.Warning}" />
    
    <SolidColorBrush
        x:Key="Mnemora.Brush.Navy"
        Color="{StaticResource Mnemora.Color.Navy}" />

    <SolidColorBrush
        x:Key="Mnemora.Brush.Primary"
        Color="{StaticResource Mnemora.Color.Teal}" />

    <SolidColorBrush
        x:Key="Mnemora.Brush.PrimaryDark"
        Color="{StaticResource Mnemora.Color.TealDark}" />

    <SolidColorBrush
        x:Key="Mnemora.Brush.Secondary"
        Color="{StaticResource Mnemora.Color.Purple}" />

    <SolidColorBrush
        x:Key="Mnemora.Brush.Surface"
        Color="{StaticResource Mnemora.Color.Surface}" />

    <SolidColorBrush
        x:Key="Mnemora.Brush.SurfaceMuted"
        Color="{StaticResource Mnemora.Color.SurfaceMuted}" />

    <SolidColorBrush
        x:Key="Mnemora.Brush.TextPrimary"
        Color="{StaticResource Mnemora.Color.TextPrimary}" />

    <SolidColorBrush
        x:Key="Mnemora.Brush.TextSecondary"
        Color="{StaticResource Mnemora.Color.TextSecondary}" />

    <SolidColorBrush
        x:Key="Mnemora.Brush.Border"
        Color="{StaticResource Mnemora.Color.Border}" />

    <!-- Фон онбординга -->

    <LinearGradientBrush
        x:Key="Mnemora.Brush.OnboardingBackground"
        StartPoint="0,0"
        EndPoint="1,1">

        <GradientStop
            Offset="0"
            Color="#04142F" />

        <GradientStop
            Offset="0.52"
            Color="#0A2758" />

        <GradientStop
            Offset="1"
            Color="#281166" />
    </LinearGradientBrush>
    
    <!-- Фон боковой панели -->

    <LinearGradientBrush
        x:Key="Mnemora.Brush.SidebarBackground"
        StartPoint="0,0"
        EndPoint="0,1">

        <GradientStop
            Offset="0"
            Color="#061735" />

        <GradientStop
            Offset="0.55"
            Color="#08224B" />

        <GradientStop
            Offset="1"
            Color="#04142F" />

    </LinearGradientBrush>

    <!-- Фирменный градиент -->

    <LinearGradientBrush
        x:Key="Mnemora.Brush.BrandGradient"
        StartPoint="0,0"
        EndPoint="1,0">

        <GradientStop
            Offset="0"
            Color="{StaticResource Mnemora.Color.Teal}" />

        <GradientStop
            Offset="1"
            Color="{StaticResource Mnemora.Color.Purple}" />
    </LinearGradientBrush>

</ResourceDictionary>