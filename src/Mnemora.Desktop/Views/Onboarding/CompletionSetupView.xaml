<UserControl x:Class="Mnemora.Desktop.Views.Onboarding.CompletionSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignWidth="1600"
             d:DesignHeight="900"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="OnboardingOutlineButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="52" />
            <Setter Property="Padding"
                    Value="20,0" />
            <Setter Property="Foreground"
                    Value="{StaticResource Mnemora.Brush.PrimaryDark}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource Mnemora.Brush.Primary}" />
            <Setter Property="BorderThickness"
                    Value="1.5" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F0FFFC" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsRowStyle"
               TargetType="Border">
            <Setter Property="Height"
                    Value="50" />
            <Setter Property="Padding"
                    Value="16,0" />
            <Setter Property="Background"
                    Value="{StaticResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="8" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource Mnemora.Brush.OnboardingBackground}"
          ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Логотип -->

        <Image Grid.Row="0"
               Source="pack://application:,,,/Assets/Images/MnemoraLogo.png"
               Width="360"
               Height="90"
               Margin="28,12,28,10"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True" />

        <!-- Шаги онбординга -->

        <Grid Grid.Row="1"
              MaxWidth="820"
              Margin="24,0,24,0"
              HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CheckBold"
                                         Width="18"
                                         Height="18"
                                         Foreground="{StaticResource Mnemora.Brush.Primary}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Height="3"
                    Margin="4,0"
                    Background="{StaticResource Mnemora.Brush.Primary}"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <Border Grid.Row="0"
                    Grid.Column="2"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CheckBold"
                                         Width="18"
                                         Height="18"
                                         Foreground="{StaticResource Mnemora.Brush.Primary}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="3"
                    Height="3"
                    Margin="4,0"
                    Background="{StaticResource Mnemora.Brush.Primary}"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <Border Grid.Row="0"
                    Grid.Column="4"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CheckBold"
                                         Width="18"
                                         Height="18"
                                         Foreground="{StaticResource Mnemora.Brush.Primary}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="5"
                    Height="3"
                    Margin="4,0"
                    Background="{StaticResource Mnemora.Brush.Primary}"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <Border Grid.Row="0"
                    Grid.Column="6"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CheckBold"
                                         Width="18"
                                         Height="18"
                                         Foreground="{StaticResource Mnemora.Brush.Primary}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="7"
                    Height="3"
                    Margin="4,0"
                    Background="{StaticResource Mnemora.Brush.Primary}"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <Border Grid.Row="0"
                    Grid.Column="8"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <TextBlock Text="5"
                           Foreground="{StaticResource Mnemora.Brush.Primary}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Профиль"
                       Foreground="#C9CFE3"
                       FontSize="14"
                       TextAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Grid.Column="2"
                       Text="Хранилище"
                       Foreground="#C9CFE3"
                       FontSize="14"
                       TextAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Grid.Column="4"
                       Text="Редактор"
                       Foreground="#C9CFE3"
                       FontSize="14"
                       TextAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Grid.Column="6"
                       Text="ИИ"
                       Foreground="#C9CFE3"
                       FontSize="14"
                       TextAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Grid.Column="8"
                       Text="Начало"
                       Foreground="{StaticResource Mnemora.Brush.Primary}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextAlignment="Center" />

        </Grid>

        <!-- Карточка -->

        <Grid Grid.Row="2">

            <StackPanel Margin="0,40,0,0"
                        VerticalAlignment="Top">

                <Border Height="580"
                        MaxWidth="724"
                        Margin="48,0"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource Mnemora.Brush.Surface}"
                        CornerRadius="22">

                    <Border.Effect>
                        <DropShadowEffect Color="#020A20"
                                          BlurRadius="28"
                                          ShadowDepth="8"
                                          Opacity="0.34" />
                    </Border.Effect>

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Содержимое -->

                        <Grid Grid.Row="0"
                              Margin="56,32,56,14">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Иконка -->

                            <Grid Grid.Row="0"
                                  Width="76"
                                  Height="76"
                                  HorizontalAlignment="Center">

                                <Ellipse Fill="{StaticResource Mnemora.Brush.SurfaceMuted}"
                                         StrokeThickness="3">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Stroke"
                                                    Value="{StaticResource Mnemora.Brush.BrandGradient}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCompletionError}"
                                                             Value="True">
                                                    <Setter Property="Stroke"
                                                            Value="#E57373" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <materialDesign:PackIcon Width="38"
                                                         Height="38"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="{x:Type materialDesign:PackIcon}">
                                            <Setter Property="Kind"
                                                    Value="BookOpenPageVariantOutline" />
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource Mnemora.Brush.BrandGradient}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCompletionError}"
                                                             Value="True">
                                                    <Setter Property="Kind"
                                                            Value="AlertCircleOutline" />
                                                    <Setter Property="Foreground"
                                                            Value="#C62828" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Grid>

                            <!-- Заголовок -->

                            <StackPanel Grid.Row="1"
                                        Margin="0,20,0,12">

                                <TextBlock Text="{Binding CompletionTitle}"
                                    Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                    FontSize="27"
                                    FontWeight="Bold"
                                    TextAlignment="Center" />

                                <TextBlock Text="{Binding CompletionSubtitle}"
                                           Margin="0,4,0,0"
                                           FontSize="16"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource Mnemora.Brush.TextSecondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCompletionError}"
                                                             Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="#A52222" />
                                                    <Setter Property="FontWeight"
                                                            Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       Text="Ваши настройки"
                                       Margin="0,0,0,8"
                                       Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <!-- Настройки -->

                            <StackPanel Grid.Row="3">

                                <!-- Профиль -->

                                <Border Style="{StaticResource SettingsRowStyle}">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0"
                                                                 Kind="AccountOutline"
                                                                 Width="24"
                                                                 Height="24"
                                                                 Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                                 VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="Профиль"
                                                   Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding UserName}"
                                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <materialDesign:PackIcon Grid.Column="3"
                                                                 Width="25"
                                                                 Height="25"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                    <Setter Property="Kind"
                                                            Value="CheckCircleOutline" />
                                                    <Setter Property="Foreground"
                                                            Value="#12B84F" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasProfileError}"
                                                                     Value="True">
                                                            <Setter Property="Kind"
                                                                    Value="CloseCircleOutline" />
                                                            <Setter Property="Foreground"
                                                                    Value="#C62828" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Grid>

                                </Border>

                                <!-- Хранилище -->

                                <Border Margin="0,6,0,0"
                                        Style="{StaticResource SettingsRowStyle}">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0"
                                                                 Kind="FolderOutline"
                                                                 Width="24"
                                                                 Height="24"
                                                                 Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                                 VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="Хранилище"
                                                   Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StorageStatus}"
                                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center">
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxWidth="560"
                                                         Padding="12,8">
                                                    <TextBlock Text="{Binding PlacementTarget.DataContext.StorageStatus, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}"
                                                               Width="520"
                                                               TextWrapping="Wrap" />
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>

                                        <materialDesign:PackIcon Grid.Column="3"
                                                                 Width="25"
                                                                 Height="25"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                    <Setter Property="Kind"
                                                            Value="CheckCircleOutline" />
                                                    <Setter Property="Foreground"
                                                            Value="#12B84F" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasStorageError}"
                                                                     Value="True">
                                                            <Setter Property="Kind"
                                                                    Value="CloseCircleOutline" />
                                                            <Setter Property="Foreground"
                                                                    Value="#C62828" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Grid>

                                </Border>

                                <!-- Редактор -->

                                <Border Margin="0,6,0,0"
                                        Style="{StaticResource SettingsRowStyle}">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0"
                                                                 Kind="FileDocumentOutline"
                                                                 Width="24"
                                                                 Height="24"
                                                                 Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                                 VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="Редактор"
                                                   Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding EditorStatus}"
                                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <materialDesign:PackIcon Grid.Column="3"
                                                                 Width="25"
                                                                 Height="25"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                    <Setter Property="Kind"
                                                            Value="MinusCircleOutline" />
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Mnemora.Brush.TextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditorConfigured}"
                                                                     Value="True">
                                                            <Setter Property="Kind"
                                                                    Value="CheckCircleOutline" />
                                                            <Setter Property="Foreground"
                                                                    Value="#12B84F" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasEditorError}"
                                                                     Value="True">
                                                            <Setter Property="Kind"
                                                                    Value="CloseCircleOutline" />
                                                            <Setter Property="Foreground"
                                                                    Value="#C62828" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Grid>

                                </Border>

                                <!-- ИИ -->

                                <Border Margin="0,6,0,0"
                                        Style="{StaticResource SettingsRowStyle}">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0"
                                                                 Kind="CreationOutline"
                                                                 Width="24"
                                                                 Height="24"
                                                                 Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                                 VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="ИИ"
                                                   Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AiStatus}"
                                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <materialDesign:PackIcon Grid.Column="3"
                                                                 Width="25"
                                                                 Height="25"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center">

                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                    <Setter Property="Kind"
                                                            Value="MinusCircleOutline" />
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Mnemora.Brush.TextSecondary}" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAiConfigured}"
                                                                     Value="True">
                                                            <Setter Property="Kind"
                                                                    Value="CheckCircleOutline" />
                                                            <Setter Property="Foreground"
                                                                    Value="#12B84F" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasAiError}"
                                                                     Value="True">
                                                            <Setter Property="Kind"
                                                                    Value="CloseCircleOutline" />
                                                            <Setter Property="Foreground"
                                                                    Value="#C62828" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Grid>

                                </Border>

                            </StackPanel>

                            <StackPanel Grid.Row="4"
                                        Margin="8,14,8,0">

                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCompletionError}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon Kind="CogOutline"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                             VerticalAlignment="Center" />

                                    <TextBlock Text="Все настройки можно изменить позже"
                                               Margin="10,0,0,0"
                                               Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                               FontSize="14"
                                               VerticalAlignment="Center" />

                                </StackPanel>

                            </StackPanel>

                        </Grid>

                        <!-- Нижняя панель -->

                        <Border Grid.Row="1"
                                Padding="42,16"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="0,1,0,0">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding BackCommand}">

                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource OnboardingOutlineButtonStyle}">
                                            <Setter Property="MinWidth"
                                                    Value="120" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCompletionError}"
                                                             Value="True">
                                                    <Setter Property="MinWidth"
                                                            Value="270" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="21"
                                                                 Height="21"
                                                                 VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                    <Setter Property="Kind"
                                                            Value="ArrowLeft" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasStorageError}"
                                                                     Value="True">
                                                            <Setter Property="Kind"
                                                                    Value="FolderOutline" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasEditorError}"
                                                                     Value="True">
                                                            <Setter Property="Kind"
                                                                    Value="FileDocumentOutline" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>

                                        <TextBlock Text="{Binding BackButtonText}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Command="{Binding OpenMnemoraCommand}"
                                        Style="{StaticResource Mnemora.PrimaryButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding PrimaryActionText}"
                                                   VerticalAlignment="Center" />

                                        <materialDesign:PackIcon Width="21"
                                                                 Height="21"
                                                                 Margin="18,0,0,0"
                                                                 VerticalAlignment="Center">

                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                    <Setter Property="Kind"
                                                            Value="ArrowRight" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCompletionError}"
                                                                     Value="True">
                                                            <Setter Property="Kind"
                                                                    Value="Refresh" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCompleting}"
                                                                     Value="True">
                                                            <Setter Property="Kind"
                                                                    Value="ClockOutline" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>

                                        </materialDesign:PackIcon>

                                    </StackPanel>
                                </Button>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>

                <TextBlock Text="Шаг 5 из 5"
                           Margin="0,24,0,0"
                           Foreground="White"
                           FontSize="15"
