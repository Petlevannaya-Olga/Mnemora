<UserControl x:Class="Mnemora.Desktop.Views.Sections.SelectSectionIconDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="820"
             Height="680"
             Background="Transparent">

    <UserControl.InputBindings>
        <KeyBinding
            Key="Escape"
            Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="22">

        <Border
            Padding="30,26,30,30"
            Background="{StaticResource Mnemora.Brush.Surface}"
            BorderBrush="{StaticResource Mnemora.Brush.Border}"
            BorderThickness="1"
            CornerRadius="18">

            <Border.Effect>
                <DropShadowEffect
                    Color="#061735"
                    BlurRadius="26"
                    ShadowDepth="7"
                    Opacity="0.28" />
            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="50"
                        Height="50"
                        Background="#EEFFFC"
                        CornerRadius="13">

                        <materialDesign:PackIcon
                            Kind="ShapeOutline"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Mnemora.Brush.PrimaryDark}" />

                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Выберите иконку"
                            Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                            FontSize="22"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Margin="0,3,0,0"
                            Text="Иконка поможет быстрее находить раздел в библиотеке"
                            Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                            FontSize="13" />

                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Mnemora.DialogCloseButton}">

                        <materialDesign:PackIcon
                            Kind="Close"
                            Width="20"
                            Height="20"
                            Foreground="{Binding Foreground,
                                RelativeSource={RelativeSource AncestorType=Button}}" />

                    </Button>

                </Grid>

                <!-- Поиск и категории -->

                <Grid
                    Grid.Row="1"
                    Margin="0,24,0,18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        materialDesign:HintAssist.Hint="Поиск иконки"
                        materialDesign:TextFieldAssist.HasClearButton="True" />

                    <ComboBox
                        Grid.Column="2"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}"
                        materialDesign:HintAssist.Hint="Категория" />

                </Grid>

                <!-- Иконки -->

                <Border
                    Grid.Row="2"
                    Padding="8"
                    Background="{StaticResource Mnemora.Brush.SurfaceMuted}"
                    BorderBrush="{StaticResource Mnemora.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12">

                    <ListBox
                        ItemsSource="{Binding IconsView}"
                        SelectedItem="{Binding SelectedIcon}"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.CanContentScroll="False"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">

                                <Setter Property="Margin" Value="5" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="ToolTip" Value="{Binding Category}" />

                                <Setter Property="Template">
                                    <Setter.Value>

                                        <ControlTemplate TargetType="ListBoxItem">

                                            <Border
                                                x:Name="IconBorder"
                                                Width="94"
                                                Height="88"
                                                Padding="7"
                                                Background="{StaticResource Mnemora.Brush.Surface}"
                                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Cursor="Hand">

                                                <StackPanel VerticalAlignment="Center">

                                                    <materialDesign:PackIcon
                                                        x:Name="Icon"
                                                        Kind="{Binding Kind}"
                                                        Width="33"
                                                        Height="33"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{StaticResource Mnemora.Brush.TextSecondary}" />

                                                    <TextBlock
                                                        x:Name="IconName"
                                                        Margin="3,8,3,0"
                                                        HorizontalAlignment="Center"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap"
                                                        TextTrimming="CharacterEllipsis"
                                                        Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                        FontSize="11"
                                                        LineHeight="13"
                                                        MaxHeight="28"
                                                        Text="{Binding Name}" />

                                                </StackPanel>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger
                                                    Property="IsMouseOver"
                                                    Value="True">

                                                    <Setter
                                                        TargetName="IconBorder"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource Mnemora.Brush.Primary}" />

                                                    <Setter
                                                        TargetName="IconBorder"
                                                        Property="Background"
                                                        Value="#F1FFFD" />

                                                </Trigger>

                                                <Trigger
                                                    Property="IsSelected"
                                                    Value="True">

                                                    <Setter
                                                        TargetName="IconBorder"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource Mnemora.Brush.PrimaryDark}" />

                                                    <Setter
                                                        TargetName="IconBorder"
                                                        Property="BorderThickness"
                                                        Value="2" />

                                                    <Setter
                                                        TargetName="IconBorder"
                                                        Property="Background"
                                                        Value="#E4FFFB" />

                                                    <Setter
                                                        TargetName="Icon"
                                                        Property="Foreground"
                                                        Value="{StaticResource Mnemora.Brush.PrimaryDark}" />

                                                    <Setter
                                                        TargetName="IconName"
                                                        Property="Foreground"
                                                        Value="{StaticResource Mnemora.Brush.TextPrimary}" />

                                                    <Setter
                                                        TargetName="IconName"
                                                        Property="FontWeight"
                                                        Value="SemiBold" />

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Setter.Value>
                                </Setter>

                            </Style>
                        </ListBox.ItemContainerStyle>

                    </ListBox>

                </Border>

                <!-- Кнопки -->

                <Grid
                    Grid.Row="3"
                    Margin="0,22,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Content="Отмена"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Mnemora.SecondaryButton}" />

                    <Button
                        Grid.Column="2"
                        Command="{Binding SelectCommand}"
                        Style="{StaticResource Mnemora.PrimaryButton}"
                        IsDefault="True">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="Выбрать иконку" />

                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Kind="Check" />

                        </StackPanel>

                    </Button>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>