<Window x:Class="Mnemora.Desktop.Views.Dialogs.ExitOnboardingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Настройка не завершена"
        Width="540"
        Height="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <Style x:Key="DialogOutlineButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="48" />
            <Setter Property="Padding"
                    Value="22,0" />
            <Setter Property="Foreground"
                    Value="{StaticResource Mnemora.Brush.PrimaryDark}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource Mnemora.Brush.Primary}" />
            <Setter Property="BorderThickness"
                    Value="1.5" />
            <Setter Property="FontSize"
                    Value="15" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F0FFFC" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="48" />
            <Setter Property="Padding"
                    Value="24,0" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="15" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{StaticResource Mnemora.Brush.BrandGradient}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.9" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <Border Background="{StaticResource Mnemora.Brush.Surface}"
                CornerRadius="20">

            <Border.Effect>
                <DropShadowEffect Color="#061735"
                                  BlurRadius="28"
                                  ShadowDepth="8"
                                  Opacity="0.32" />
            </Border.Effect>

            <Grid Margin="34,28,34,28">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="50"
                            Height="50"
                            Background="{StaticResource Mnemora.Brush.SurfaceMuted}"
                            CornerRadius="25">

                        <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                 Width="28"
                                                 Height="28"
                                                 Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="16,0,16,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Настройка не завершена"
                                   Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                   FontSize="21"
                                   FontWeight="Bold" />

                        <TextBlock Text="Вы действительно хотите выйти?"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                   FontSize="14" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Width="34"
                            Height="34"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Click="ContinueSetup_Click">

                        <materialDesign:PackIcon Kind="Close"
                                                 Width="21"
                                                 Height="21"
                                                 Foreground="{StaticResource Mnemora.Brush.TextSecondary}" />
                    </Button>
                </Grid>

                <!-- Сообщение -->

                <TextBlock x:Name="MessageText"
                           Grid.Row="1"
                           Margin="0,24,0,0"
                           Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                           FontSize="15"
                           LineHeight="23"
                           TextWrapping="Wrap" />

                <Border Grid.Row="2"
                        Margin="0,18,0,20"
                        Padding="14,11"
                        Background="{StaticResource Mnemora.Brush.SurfaceMuted}"
                        CornerRadius="8"
                        VerticalAlignment="Top">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ContentSaveOutline"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                 VerticalAlignment="Center" />

                        <TextBlock Text="Имя и путь к хранилищу уже сохранены"
                                   Margin="10,0,0,0"
                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Кнопки -->

                <Grid Grid.Row="3">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Выйти"
                            Click="Exit_Click"
                            Style="{StaticResource DialogOutlineButtonStyle}" />

                    <Button Grid.Column="2"
                            Content="Продолжить настройку"
                            Click="ContinueSetup_Click"
                            Style="{StaticResource DialogPrimaryButtonStyle}" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>