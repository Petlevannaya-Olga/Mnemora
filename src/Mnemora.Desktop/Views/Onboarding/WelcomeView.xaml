<UserControl x:Class="Mnemora.Desktop.Views.Onboarding.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignWidth="1600"
             d:DesignHeight="900"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <Style x:Key="WelcomeFeatureCardStyle"
               TargetType="Border">
            <Setter Property="Height"
                    Value="166" />
            <Setter Property="Padding"
                    Value="24,22" />
            <Setter Property="Background"
                    Value="#12FFFFFF" />
            <Setter Property="BorderBrush"
                    Value="#30FFFFFF" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="18" />
        </Style>

        <Style x:Key="WelcomePrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="70" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="21" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="BorderBrush"
                    Value="#70FFFFFF" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{StaticResource Mnemora.Brush.BrandGradient}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <Border.Effect>
                                <DropShadowEffect Color="#16CDB7"
                                                  BlurRadius="22"
                                                  ShadowDepth="0"
                                                  Opacity="0.28" />
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.9" />
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.74" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="White" />
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource Mnemora.Brush.OnboardingBackground}"
          ClipToBounds="True">

        <!-- Декоративный фон -->

        <Viewbox Stretch="Fill"
                 IsHitTestVisible="False">
            <Canvas Width="1600"
                    Height="900">

                <Ellipse Width="690"
                         Height="690"
                         Canvas.Left="1120"
                         Canvas.Top="-220">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0"
                                          Color="#487C4DFF" />
                            <GradientStop Offset="1"
                                          Color="#007C4DFF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="620"
                         Height="620"
                         Canvas.Left="-280"
                         Canvas.Top="510">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0"
                                          Color="#3216CDB7" />
                            <GradientStop Offset="1"
                                          Color="#0016CDB7" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Path Data="M0,210 L92,254 L165,224 L236,312 L314,280
                            M92,254 L48,350 L142,402
                            M236,312 L290,390 L374,420"
                      Stroke="#16CDB7"
                      StrokeThickness="1.2"
                      Opacity="0.11" />

                <Path Data="M1260,118 L1342,164 L1420,130 L1495,214 L1600,178
                            M1342,164 L1310,252 L1390,302
                            M1495,214 L1450,322 L1554,380 L1600,350"
                      Stroke="#8F6BFF"
                      StrokeThickness="1.2"
                      Opacity="0.14" />

                <Ellipse Width="8"
                         Height="8"
                         Canvas.Left="88"
                         Canvas.Top="250"
                         Fill="#16CDB7"
                         Opacity="0.35" />
                <Ellipse Width="8"
                         Height="8"
                         Canvas.Left="232"
                         Canvas.Top="308"
                         Fill="#16CDB7"
                         Opacity="0.3" />
                <Ellipse Width="8"
                         Height="8"
                         Canvas.Left="1338"
                         Canvas.Top="160"
                         Fill="#8F6BFF"
                         Opacity="0.42" />
                <Ellipse Width="8"
                         Height="8"
                         Canvas.Left="1491"
                         Canvas.Top="210"
                         Fill="#8F6BFF"
                         Opacity="0.42" />

            </Canvas>
        </Viewbox>

        <!-- Основное содержимое -->

        <Grid MaxWidth="980"
              Margin="42,28"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Grid.Row="0"
                   Source="pack://application:,,,/Assets/Images/MnemoraLogo.png"
                   Width="500"
                   Height="138"
                   HorizontalAlignment="Center"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True" />

            <TextBlock Grid.Row="1"
                       Text="Персональное пространство для знаний"
                       Margin="0,28,0,0"
                       Foreground="White"
                       FontSize="38"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="2"
                       MaxWidth="820"
                       Margin="28,12,28,0"
                       HorizontalAlignment="Center"
                       Foreground="#BEC6DF"
                       FontSize="18"
                       LineHeight="27"
                       Text="Сохраняйте материалы, тренируйтесь и проверяйте свои ответы с помощью ИИ"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="3"
                  Margin="0,34,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource WelcomeFeatureCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                 Width="48"
                                                 Height="48"
                                                 Foreground="{StaticResource Mnemora.Brush.BrandGradient}"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="Markdown и вложения"
                                   Margin="0,18,0,0"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Medium"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource WelcomeFeatureCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ShieldLock"
                                                 Width="48"
                                                 Height="48"
                                                 Foreground="{StaticResource Mnemora.Brush.BrandGradient}"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="Данные остаются на устройстве"
                                   Margin="0,18,0,0"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Medium"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource WelcomeFeatureCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Brain"
                                                 Width="48"
                                                 Height="48"
                                                 Foreground="{StaticResource Mnemora.Brush.BrandGradient}"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="Обучение с поддержкой ИИ"
                                   Margin="0,18,0,0"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Medium"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </Grid>

            <Button Grid.Row="4"
                    Width="540"
                    Margin="0,38,0,0"
                    HorizontalAlignment="Center"
                    Command="{Binding StartCommand}"
                    Style="{StaticResource WelcomePrimaryButtonStyle}">
                <Grid Width="460">
                    <TextBlock Text="Начать настройку"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <materialDesign:PackIcon Kind="ArrowRight"
                                             Width="25"
                                             Height="25"
                                             Margin="0,0,20,0"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center" />
                </Grid>
            </Button>

        </Grid>

    </Grid>

</UserControl>
