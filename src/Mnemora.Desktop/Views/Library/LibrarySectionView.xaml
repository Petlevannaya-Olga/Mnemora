<UserControl
    x:Class="Mnemora.Desktop.Views.Library.LibrarySectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Mnemora.Desktop.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Loaded="LibrarySectionView_OnLoaded"
    Unloaded="LibrarySectionView_OnUnloaded"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:SectionColorConverter x:Key="SectionColorConverter" />
        <converters:SectionIconConverter x:Key="SectionIconConverter" />
        <converters:TopicColorConverter x:Key="TopicColorConverter" />
        <converters:TopicIconConverter x:Key="TopicIconConverter" />

        <Style x:Key="BreadcrumbButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopicCardStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="176" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="TopicRowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopicNavigationButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Mnemora.Brush.SurfaceMuted}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="32,24,32,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Command="{Binding NavigateBackCommand}" Style="{StaticResource BreadcrumbButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="19" Height="19" VerticalAlignment="Center" Kind="ChevronLeft" />
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontSize="14" Text="Библиотека" />
                </StackPanel>
            </Button>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="58"
                    Height="58"
                    Background="{Binding Section.Color, Converter={StaticResource SectionColorConverter}}"
                    CornerRadius="14">
                    <materialDesign:PackIcon
                        Width="31"
                        Height="31"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Kind="{Binding Section.Icon, Converter={StaticResource SectionIconConverter}}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="17,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="{Binding SectionTitle}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="16"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="Темы раздела" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="32,0,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <TextBox
                Height="52"
                VerticalContentAlignment="Center"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                materialDesign:HintAssist.Hint="Поиск по темам..."
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            <ComboBox
                Grid.Column="2"
                Height="52"
                VerticalContentAlignment="Center"
                DisplayMemberPath="Name"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSortOption}"
                materialDesign:HintAssist.Hint="Сортировка"
                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
        </Grid>

        <Grid Grid.Row="2" Margin="32,0,32,28">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ProgressBar
                    Width="220"
                    Height="4"
                    Foreground="{DynamicResource Mnemora.Brush.Primary}"
                    IsIndeterminate="True" />

                <TextBlock
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Text="Загружаем темы..." />
            </StackPanel>

            <Border
                Width="480"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <materialDesign:PackIcon
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                        Kind="AlertCircleOutline" />

                    <TextBlock
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="Не удалось загрузить раздел" />

                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="{Binding ErrorMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ReloadCommand}"
                        Content="Попробовать снова"
                        Style="{StaticResource Mnemora.SecondaryButton}" />
                </StackPanel>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <materialDesign:PackIcon
                    Width="62"
                    Height="62"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource Mnemora.Brush.Primary}"
                    Kind="BookOpenPageVariantOutline" />

                <TextBlock
                    Margin="0,18,0,0"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                    Text="В разделе пока нет тем" />

                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Text="Создать тему можно в управлении библиотекой." />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoSearchResults}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <materialDesign:PackIcon
                    Width="54"
                    Height="54"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Kind="Magnify" />

                <TextBlock
                    Margin="0,18,0,0"
                    FontSize="21"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                    Text="Темы не найдены" />

                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Text="Попробуйте изменить поисковый запрос." />
            </StackPanel>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasTopics}" Value="True" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding HasError}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox
                    ItemsSource="{Binding TopicRows}"
                    ItemContainerStyle="{StaticResource TopicRowItemStyle}"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.ScrollChanged="TopicsScroll_OnScrollChanged"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Topics}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding DataContext.OpenTopicCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TopicNavigationButtonStyle}"
                                            ToolTip="Открыть тему">

                                            <Border Style="{StaticResource TopicCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border
                                                            Width="52"
                                                            Height="52"
                                                            Background="{Binding Color, Converter={StaticResource TopicColorConverter}}"
                                                            CornerRadius="13">

                                                            <materialDesign:PackIcon
                                                                Width="28"
                                                                Height="28"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="White"
                                                                Kind="{Binding Icon, Converter={StaticResource TopicIconConverter}}" />
                                                        </Border>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="15,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="18"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="Wrap" />
                                                    </Grid>

                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Margin="0,15,0,0"
                                                        FontSize="14"
                                                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                        Text="{Binding MaterialsText}" />

                                                    <StackPanel Grid.Row="3" Margin="0,18,0,0">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                            Text="{Binding ActivityText}" />

                                                        <Grid Margin="0,9,0,0">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                                Text="{Binding MaterialTypesText}" />

                                                            <materialDesign:PackIcon
                                                                Width="21"
                                                                Height="21"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                Kind="ChevronRight" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1" MinHeight="52">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding IsLoadingNextPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar
                            Width="120"
                            Height="4"
                            Foreground="{DynamicResource Mnemora.Brush.Primary}"
                            IsIndeterminate="True" />

                        <TextBlock
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                            Text="Загружаем ещё..." />
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding HasNextPageError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                            Text="{Binding NextPageErrorMessage}" />

                        <Button
                            Command="{Binding RetryNextPageCommand}"
                            Content="Повторить"
                            Style="{StaticResource Mnemora.SecondaryButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>