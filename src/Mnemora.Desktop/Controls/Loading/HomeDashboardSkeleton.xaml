<UserControl
    x:Class="Mnemora.Desktop.Controls.Loading.HomeDashboardSkeleton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loading="clr-namespace:Mnemora.Desktop.Controls.Loading"
    IsHitTestVisible="False">

    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <loading:SkeletonBlock Width="210" Height="24" HorizontalAlignment="Left" />

        <StackPanel Grid.Row="2">
            <loading:SkeletonBlock Width="380" Height="18" HorizontalAlignment="Left" />
            <loading:SkeletonBlock Width="280" Height="12" Margin="0,12,0,0" HorizontalAlignment="Left" />
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="20" Background="#F8FAFC" CornerRadius="10">
                <StackPanel>
                    <loading:SkeletonBlock Width="108" Height="14" HorizontalAlignment="Left" />
                    <loading:SkeletonBlock Height="11" Margin="0,18,0,0" />
                    <loading:SkeletonBlock Width="210" Height="11" Margin="0,10,0,0" HorizontalAlignment="Left" />
                    <loading:SkeletonBlock Width="132" Height="38" Margin="0,24,0,0" HorizontalAlignment="Left" CornerRadius="9" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="20" Background="#F8FAFC" CornerRadius="10">
                <StackPanel>
                    <loading:SkeletonBlock Width="96" Height="14" HorizontalAlignment="Left" />
                    <loading:SkeletonBlock Width="64" Height="34" Margin="0,18,0,0" HorizontalAlignment="Left" />
                    <loading:SkeletonBlock Height="9" Margin="0,18,0,0" CornerRadius="5" />
                    <loading:SkeletonBlock Width="220" Height="11" Margin="0,11,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
