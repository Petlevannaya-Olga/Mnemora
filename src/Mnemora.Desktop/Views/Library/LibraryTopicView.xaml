<UserControl
    x:Class="Mnemora.Desktop.Views.Library.LibraryTopicView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Mnemora.Desktop.Converters"
    xmlns:loading="clr-namespace:Mnemora.Desktop.Controls.Loading"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Loaded="LibraryTopicView_OnLoaded"
    Unloaded="LibraryTopicView_OnUnloaded"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:TopicColorConverter x:Key="TopicColorConverter" />
        <converters:TopicIconConverter x:Key="TopicIconConverter" />

        <Style x:Key="BreadcrumbButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaterialFilterButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="46" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource Mnemora.Brush.SurfaceMuted}" />
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Mnemora.Brush.Primary}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E6FBF8" />
                                <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialTableTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="66" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Grid>
                            <Border
                                x:Name="RowBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                BorderThickness="0,0,0,1" />

                            <Border
                                x:Name="SelectionIndicator"
                                Width="4"
                                Margin="0,8,0,8"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Mnemora.Brush.Primary}"
                                CornerRadius="0,3,3,0"
                                Visibility="Collapsed" />

                            <DataGridCellsPresenter />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#F3F6FC" />
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#E6FBF8" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DifficultyBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#EAF8F0" />
            <Setter Property="CornerRadius" Value="8" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMedium}" Value="True">
                    <Setter Property="Background" Value="#FFF6DC" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsHard}" Value="True">
                    <Setter Property="Background" Value="#FDEBEC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DifficultyDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#26976A" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMedium}" Value="True">
                    <Setter Property="Fill" Value="#C98200" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsHard}" Value="True">
                    <Setter Property="Fill" Value="#D94A4A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DifficultyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#267A59" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMedium}" Value="True">
                    <Setter Property="Foreground" Value="#996400" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsHard}" Value="True">
                    <Setter Property="Foreground" Value="#B7353B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LibraryScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryVerticalScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Primary}" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border
                            Margin="2,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>

                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate
            x:Key="LibraryVerticalScrollBarTemplate"
            TargetType="{x:Type ScrollBar}">
            <Grid
                Background="Transparent"
                SnapsToDevicePixels="True">
                <Border
                    Margin="3,2"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5" />

                <Track
                    x:Name="PART_Track"
                    Margin="2"
                    IsDirectionReversed="True"
                    Orientation="Vertical"
                    ViewportSize="NaN">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            Command="{x:Static ScrollBar.PageUpCommand}"
                            Style="{StaticResource LibraryScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb Style="{StaticResource LibraryVerticalScrollThumbStyle}" />
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            Command="{x:Static ScrollBar.PageDownCommand}"
                            Style="{StaticResource LibraryScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>

            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style
            x:Key="LibraryScrollBarStyle"
            BasedOn="{StaticResource {x:Type ScrollBar}}"
            TargetType="{x:Type ScrollBar}">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="16" />
                    <Setter Property="MinWidth" Value="16" />
                    <Setter Property="Margin" Value="6,2,2,2" />
                    <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Border}" />
                    <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Primary}" />
                    <Setter Property="Opacity" Value="0.9" />
                    <Setter Property="Template" Value="{StaticResource LibraryVerticalScrollBarTemplate}" />
                </Trigger>

                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Orientation" Value="Vertical" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Opacity" Value="1" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Mnemora.Brush.SurfaceMuted}">
        <Grid.Resources>
            <Style
                BasedOn="{StaticResource LibraryScrollBarStyle}"
                TargetType="{x:Type ScrollBar}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="32,24,32,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding NavigateLibraryCommand}" Style="{StaticResource BreadcrumbButtonStyle}">
                    <TextBlock FontSize="14" Text="Библиотека" />
                </Button>

                <materialDesign:PackIcon
                    Width="18"
                    Height="18"
                    Margin="7,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Kind="ChevronRight" />

                <Button Command="{Binding NavigateBackCommand}" Style="{StaticResource BreadcrumbButtonStyle}">
                    <TextBlock FontSize="14" Text="{Binding Topic.SectionName}" />
                </Button>

                <materialDesign:PackIcon
                    Width="18"
                    Height="18"
                    Margin="7,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Kind="ChevronRight" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Text="{Binding TopicTitle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="58"
                    Height="58"
                    Background="{Binding Topic.Color, Converter={StaticResource TopicColorConverter}}"
                    CornerRadius="14">
                    <materialDesign:PackIcon
                        Width="31"
                        Height="31"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Kind="{Binding Topic.Icon, Converter={StaticResource TopicIconConverter}}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="17,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="{Binding TopicTitle}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="16"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="Материалы темы" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Height="1"
                    Margin="0,22,0,0"
                    Background="{DynamicResource Mnemora.Brush.Border}" />
        </Grid>

        <Grid Grid.Row="1" Margin="32,0,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <TextBox
                Height="52"
                VerticalContentAlignment="Center"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                materialDesign:HintAssist.Hint="Поиск по материалам..."
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ToggleButton
                    Command="{Binding SelectAllMaterialsCommand}"
                    Content="Все"
                    IsChecked="{Binding IsAllFilter, Mode=OneWay}"
                    Style="{StaticResource MaterialFilterButtonStyle}" />

                <ToggleButton
                    Command="{Binding SelectArticlesCommand}"
                    Content="Статьи"
                    IsChecked="{Binding IsArticlesFilter, Mode=OneWay}"
                    Style="{StaticResource MaterialFilterButtonStyle}" />

                <ToggleButton
                    Command="{Binding SelectQuestionsCommand}"
                    Content="Вопросы"
                    IsChecked="{Binding IsQuestionsFilter, Mode=OneWay}"
                    Style="{StaticResource MaterialFilterButtonStyle}" />
            </StackPanel>

            <ComboBox
                Grid.Column="3"
                Height="52"
                VerticalContentAlignment="Center"
                DisplayMemberPath="Name"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSortOption}"
                materialDesign:HintAssist.Hint="Сортировка"
                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
        </Grid>

        <Grid Grid.Row="2" Margin="32,0,32,28">
            <loading:LoadingIndicator
                Panel.ZIndex="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IndicatorLength="360"
                IndicatorThickness="8"
                Message="Загружаем материалы...">
                <loading:LoadingIndicator.Style>
                    <Style TargetType="{x:Type loading:LoadingIndicator}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </loading:LoadingIndicator.Style>
            </loading:LoadingIndicator>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasMaterials}" Value="True" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding HasError}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="14">

                <DataGrid
                    ItemsSource="{Binding Materials}"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    BorderThickness="0"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    CanUserSortColumns="False"
                    EnableColumnVirtualization="True"
                    EnableRowVirtualization="True"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    RowHeaderWidth="0"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.ScrollChanged="MaterialsScroll_OnScrollChanged"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Материал" MinWidth="240" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40" Height="40" CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F0ECFF" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                                            <Setter Property="Background" Value="#E6FBF8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <materialDesign:PackIcon
                                                Width="22"
                                                Height="22"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                        <Setter Property="Kind" Value="FileDocumentOutline" />
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Mnemora.Brush.Secondary}" />

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                                                <Setter Property="Kind" Value="HelpCircleOutline" />
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                Text="{Binding TypeTitle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Теги" MinWidth="150" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="17"
                                            Height="17"
                                            Margin="0,0,7,0"
                                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                            Kind="TagOutline" />

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                            Text="{Binding TagsText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Сложность" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DifficultyBadgeStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse
                                                Width="7"
                                                Height="7"
                                                Margin="0,0,7,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource DifficultyDotStyle}" />

                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding DifficultyTitle}"
                                                Style="{StaticResource DifficultyTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Баллы" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="18"
                                            Height="18"
                                            Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                            Kind="StarOutline"
                                            ToolTip="За изучение" />

                                        <TextBlock
                                            Margin="5,0,13,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                            Text="{Binding StudyPoints}" />

                                        <materialDesign:PackIcon
                                            Width="18"
                                            Height="18"
                                            Foreground="{DynamicResource Mnemora.Brush.PrimaryDark}"
                                            Kind="Refresh"
                                            ToolTip="За повторение" />

                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                            Text="{Binding ReviewPoints}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Header="Создан"
                            Width="105"
                            Binding="{Binding CreatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                            ElementStyle="{StaticResource MaterialTableTextStyle}" />

                        <DataGridTextColumn
                            Header="Изменён"
                            Width="105"
                            Binding="{Binding UpdatedAtLocal, StringFormat={}{0:dd.MM.yyyy}}"
                            ElementStyle="{StaticResource MaterialTableTextStyle}" />
                    </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="1" MinHeight="72">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="{Binding MaterialsShownCountText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNextPageError}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <loading:LoadingIndicator
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IndicatorLength="200"
                        IndicatorThickness="6"
                        Message="Загружаем материалы..."
                        Visibility="{Binding IsLoadingNextPage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding HasNextPageError, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="{Binding NextPageErrorMessage}" />
                        <Button Command="{Binding RetryNextPageCommand}" Content="Повторить" Style="{StaticResource Mnemora.SecondaryButton}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">

                <materialDesign:PackIcon
                    Width="62"
                    Height="62"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource Mnemora.Brush.Primary}"
                    Kind="FileDocumentOutline" />

                <TextBlock
                    Margin="0,18,0,0"
                    FontSize="22"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                    Text="В теме пока нет материалов" />

                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    HorizontalAlignment="Center"
                    Text="Создать материал можно в управлении библиотекой." />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding HasNoSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">

                <materialDesign:PackIcon
                    Width="54"
                    Height="54"
                    HorizontalAlignment="Center"
