<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Mnemora.Desktop.Converters" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="Mnemora.Desktop.Views.Library.CreateMaterialView" x:Name="Root" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:TopicColorConverter x:Key="TopicColorConverter"/>

        <!-- Хлебная крошка — тот же спокойный back-link, что и на страницах управления. -->
        <Style x:Key="CreateMaterial.BreadcrumbButton" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.72"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- Сброс выбранного Markdown-файла. -->
        <Style x:Key="CreateMaterial.ClearFileButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearFileBackground"
                                Width="30"
                                Height="30"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClearFileBackground"
                                        Property="Background"
                                        Value="#F1EDFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ClearFileBackground"
                                        Property="Background"
                                        Value="#E9E3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Компактная кнопка выбора иконки для узкой колонки второго шага. -->
        <Style x:Key="CreateMaterial.IconPickerButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Secondary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F7F5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F1EDFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Спокойная альтернативная карточка: акцент появляется только при наведении. -->
        <Style x:Key="CreateMaterial.TemplateSourceButton" TargetType="Button">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TemplateCardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TemplateCardBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Mnemora.Brush.Secondary}" />
                                <Setter TargetName="TemplateCardBorder"
                                        Property="Background"
                                        Value="#FAF9FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TemplateCardBorder"
                                        Property="Background"
                                        Value="#F7F5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка выбора типа. Вся карточка является RadioButton. -->
        <Style x:Key="CreateMaterial.TypeCard" TargetType="RadioButton">
            <Setter Property="Width" Value="350"/>
            <Setter Property="Height" Value="296"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>

                            <Border x:Name="SelectedMark" Width="28" Height="28" Margin="0,14,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource Mnemora.Brush.Secondary}" CornerRadius="14" Visibility="Collapsed">
                                <materialDesign:PackIcon Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Kind="Check"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FAF9FF"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#DAD3F8"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F7F5FF"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Secondary}"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <Style x:Key="CreateMaterial.TagChip" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#F1EDFF"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>


        <!-- Локальные стили третьего шага. Только визуальный макет. -->
        <Style x:Key="CreateMaterial.ContentFileCard" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="CreateMaterial.PreviewIconButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#F4F0FF" />
                                <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#ECE6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateMaterial.PreviewModeButton" TargetType="RadioButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#F8F5FF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#F1EDFF" />
                                <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Mnemora.Brush.SurfaceMuted}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Grid.Row="0" Margin="32,28,32,0" HorizontalAlignment="Left" Style="{StaticResource CreateMaterial.BreadcrumbButton}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Kind="ChevronLeft"/>
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="14" Text="Темы"/>
            </StackPanel>
        </Button>

        <Grid Grid.Row="1" Margin="32,20,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="64" Height="64" Background="{Binding SelectedTopic.TopicColor, Converter={StaticResource TopicColorConverter}}" CornerRadius="15">
                <materialDesign:PackIcon Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Kind="{Binding SelectedTopic.IconKind}"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="{Binding SelectedTopic.Name, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Margin="0,5,0,0" FontSize="14" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="Создать материал"/>
            </StackPanel>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Margin="0,14,0,0" Background="{DynamicResource Mnemora.Brush.Border}"/>
        </Grid>

        <TabControl x:Name="WizardTabs" Grid.Row="2" SelectedIndex="0" Background="Transparent" BorderThickness="0" Padding="0" Margin="0">
    <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent" />
        </ControlTemplate>
    </TabControl.Template>
<TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"
              Margin="72,16,72,4"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Компактный stepper: круг и подпись находятся в одной строке. -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Width="36"
                        Height="36"
                        Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.BrandGradient}"
                        BorderThickness="2"
                        CornerRadius="18">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                               Text="1" />
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                           Text="Тип материала" />
            </StackPanel>

            <Border Grid.Column="1"
                    Height="3"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Mnemora.Brush.BrandGradient}"
                    CornerRadius="2" />

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Width="36"
                        Height="36"
                        Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                        BorderThickness="2"
                        CornerRadius="18">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="2" />
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="Материал" />
            </StackPanel>

            <Border Grid.Column="3"
                    Height="2"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Mnemora.Brush.Border}" />

            <StackPanel Grid.Column="4"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Width="36"
                        Height="36"
                        Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                        BorderThickness="2"
                        CornerRadius="18">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="3" />
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="Проверка" />
            </StackPanel>

            <Border Grid.Column="5"
                    Height="2"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Mnemora.Brush.Border}" />

            <StackPanel Grid.Column="6"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Width="36"
                        Height="36"
                        Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                        BorderThickness="2"
                        CornerRadius="18">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                               Text="4" />
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                           Text="Обучение и связи" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="32,28,32,20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border MaxWidth="900" Padding="36,28,36,30" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource Mnemora.Brush.Surface}" BorderBrush="{DynamicResource Mnemora.Brush.Border}" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="ArticleChoiceRadio" Grid.Column="0" GroupName="CreateMaterialType" Style="{StaticResource CreateMaterial.TypeCard}">
                            <Grid Margin="26,20,26,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Width="60" Height="60" HorizontalAlignment="Center" Background="#F1EDFF" CornerRadius="30">
                                    <materialDesign:PackIcon Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.Secondary}" Kind="FileDocumentOutline"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                    <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="Статья"/>
                                    <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="Теория, конспект или подробный разбор"/>
                                </StackPanel>

                                <Border Grid.Row="2" Height="1" Margin="0,16,0,14" Background="{DynamicResource Mnemora.Brush.Border}"/>

                                <StackPanel Grid.Row="3">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.Secondary}" Kind="BookOpenPageVariantOutline"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="Сохраняй теорию и разборы"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.Secondary}" Kind="FormatListBulleted"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="Структурируй материал с оглавлением"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.Secondary}" Kind="HelpCircleOutline"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="Закрепляй знания вопросами с ИИ-проверкой"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="QuestionChoiceRadio" Grid.Column="2" GroupName="CreateMaterialType" Style="{StaticResource CreateMaterial.TypeCard}">
                            <Grid Margin="26,20,26,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Width="60" Height="60" HorizontalAlignment="Center" Background="#E8FAF7" CornerRadius="30">
                                    <materialDesign:PackIcon Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.Primary}" Kind="HelpCircleOutline"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                    <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="Вопрос"/>
                                    <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource Mnemora.Brush.TextSecondary}" Text="Практика и проверка знаний"/>
                                </StackPanel>

                                <Border Grid.Row="2" Height="1" Margin="0,16,0,14" Background="{DynamicResource Mnemora.Brush.Border}"/>

                                <StackPanel Grid.Row="3">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.Primary}" Kind="HelpCircleOutline"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="Создавай вопросы для практики"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.Primary}" Kind="Check"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="Добавляй эталонные ответы"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource Mnemora.Brush.Primary}" Kind="InformationOutline"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Mnemora.Brush.TextPrimary}" Text="Получай ИИ-проверку и обратную связь"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="32,16" Background="{DynamicResource Mnemora.Brush.Surface}" BorderBrush="{DynamicResource Mnemora.Brush.Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button HorizontalAlignment="Left" Command="{Binding CancelCreateMaterialCommand}" Style="{StaticResource Mnemora.SecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Kind="ChevronLeft"/>
                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Назад к материалам"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" MinWidth="132" Height="44" Click="GoToBasicStep_OnClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Mnemora.PrimaryButton}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=ArticleChoiceRadio}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=QuestionChoiceRadio}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Далее"/>
                        <materialDesign:PackIcon Width="18" Height="18" Margin="7,0,0,0" VerticalAlignment="Center" Kind="ChevronRight"/>
                    </StackPanel>
