<UserControl
    x:Class="Mnemora.Desktop.Views.Shell.AppShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:notifications="clr-namespace:Mnemora.Desktop.Notifications">

    <UserControl.Resources>
        <Style x:Key="SidebarNavigationButtonStyle"
               TargetType="ToggleButton">

            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="14,4" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#173B67" />
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#245A84" />

                                <Setter Property="Foreground"
                                        Value="{StaticResource Mnemora.Brush.Primary}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75" />
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="SidebarSubmenuButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="30,2,14,2" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="#DDE4F3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#14365F" />
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#245A84" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                        Value="{StaticResource Mnemora.Brush.Primary}" />
                                <Setter Property="Foreground" Value="{StaticResource Mnemora.Brush.Primary}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Подпись пункта меню -->

        <Style
            x:Key="SidebarTextStyle"
            TargetType="TextBlock">

            <Setter
                Property="Margin"
                Value="13,0,0,0" />

            <Setter
                Property="FontSize"
                Value="15" />

            <Setter
                Property="VerticalAlignment"
                Value="Center" />

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding IsSidebarExpanded}"
                    Value="False">

                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- Стрелка справа -->

        <Style
            x:Key="SidebarChevronStyle"
            TargetType="{x:Type materialDesign:PackIcon}">

            <Setter
                Property="Width"
                Value="20" />

            <Setter
                Property="Height"
                Value="20" />

            <Setter
                Property="VerticalAlignment"
                Value="Center" />

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding IsSidebarExpanded}"
                    Value="False">

                    <Setter
                        Property="Visibility"
                        Value="Collapsed" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="SidebarGroupButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="14,4" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#14365F" />
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#173B67" />
                                <Setter Property="Foreground" Value="{StaticResource Mnemora.Brush.Primary}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotificationAccentStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static notifications:NotificationKind.Error}">
                    <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Error}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Kind}" Value="{x:Static notifications:NotificationKind.Warning}">
                    <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Warning}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Kind}" Value="{x:Static notifications:NotificationKind.Information}">
                    <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Secondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotificationIconStyle" TargetType="{x:Type materialDesign:PackIcon}">
            <Setter Property="Kind" Value="CheckCircleOutline" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.PrimaryDark}" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static notifications:NotificationKind.Error}">
                    <Setter Property="Kind" Value="AlertCircleOutline" />
                    <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Error}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Kind}" Value="{x:Static notifications:NotificationKind.Warning}">
                    <Setter Property="Kind" Value="AlertOutline" />
                    <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Warning}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Kind}" Value="{x:Static notifications:NotificationKind.Information}">
                    <Setter Property="Kind" Value="InformationOutline" />
                    <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.Secondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotificationCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{DynamicResource Mnemora.Brush.SurfaceMuted}" />
                                <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Mnemora.Brush.SurfaceMuted}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->

        <Border
            Grid.Column="0"
            Background="{StaticResource Mnemora.Brush.SidebarBackground}"
            ClipToBounds="True">

            <Border.Style>
                <Style TargetType="Border">

                    <!-- Раскрытое состояние -->

                    <Setter
                        Property="Width"
                        Value="240" />

                    <Style.Triggers>

                        <DataTrigger
                            Binding="{Binding IsSidebarExpanded}"
                            Value="False">

                            <!-- Конечная ширина -->

                            <Setter
                                Property="Width"
                                Value="80" />

                            <!-- Плавное закрытие -->

                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Width"
                                            From="240"
                                            To="80"
                                            Duration="0:0:0.40">

                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>

                                        </DoubleAnimation>

                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>

                            <!-- Плавное раскрытие -->

                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">

                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Width"
                                            From="80"
                                            To="240"
                                            Duration="0:0:0.46">

                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>

                                        </DoubleAnimation>

                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </Border.Style>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="116" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Логотип и сворачивание -->

                <Grid
                    Grid.Row="0"
                    Margin="18,20,14,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding IsSidebarExpanded}"
                                        Value="False">

                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </StackPanel.Style>

                        <Image
                            Source="pack://application:,,,/Assets/Images/MnemoraLogoIcon.png"
                            Width="42"
                            Height="42"
                            Stretch="Uniform"
                            RenderOptions.BitmapScalingMode="HighQuality" />

                        <TextBlock
                            Text="Mnemora"
                            Margin="9,0,0,0"
                            Foreground="White"
                            FontSize="22"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />

                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleSidebarCommand}"
                        Background="Transparent"
                        BorderBrush="#3B5279"
                        BorderThickness="1"
                        Foreground="#DDE4F3"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="Свернуть меню">

                        <Button.Style>
                            <Style TargetType="Button">

                                <Setter
                                    Property="Margin"
                                    Value="10,0,0,0" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding IsSidebarExpanded}"
                                        Value="False">

                                        <Setter
                                            Property="Grid.Column"
                                            Value="0" />

                                        <Setter
                                            Property="Grid.ColumnSpan"
                                            Value="2" />

                                        <Setter
                                            Property="Margin"
                                            Value="0" />

                                        <Setter
                                            Property="HorizontalAlignment"
                                            Value="Center" />

                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform X="-10" />
                                            </Setter.Value>
                                        </Setter>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border
                                    x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">

                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger
                                        Property="IsMouseOver"
                                        Value="True">

                                        <Setter
                                            TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#173B67" />

                                        <Setter
                                            TargetName="ButtonBorder"
                                            Property="BorderBrush"
                                            Value="{StaticResource Mnemora.Brush.Primary}" />

                                        <Setter
                                            Property="Foreground"
                                            Value="{StaticResource Mnemora.Brush.Primary}" />

                                    </Trigger>

                                    <Trigger
                                        Property="IsPressed"
                                        Value="True">

                                        <Setter
                                            TargetName="ButtonBorder"
                                            Property="Opacity"
                                            Value="0.7" />

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                        <Viewbox
                            Width="16"
                            Height="16">

                            <Path
                                Fill="Transparent"
                                Stroke="{Binding Foreground,
                RelativeSource={RelativeSource AncestorType=Button}}"
                                StrokeThickness="2"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round">

                                <Path.Style>

                                    <Style TargetType="Path">

                                        <Setter
                                            Property="Data"
                                            Value="M 15,3 L 6,12 L 15,21" />

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding IsSidebarExpanded}"
                                                Value="False">

                                                <Setter
                                                    Property="Data"
                                                    Value="M 7,3 L 16,12 L 7,21" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Path.Style>

                            </Path>

                        </Viewbox>

                    </Button>

                </Grid>

                <!-- Навигация -->

                <StackPanel Grid.Row="1">

                    <ToggleButton
                        Command="{Binding NavigateHomeCommand}"
                        IsChecked="{Binding IsHomeSelected, Mode=OneWay}"
                        Style="{StaticResource SidebarNavigationButtonStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon
                                Kind="HomeOutline"
                                Width="25"
                                Height="25"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Главная"
                                Style="{StaticResource SidebarTextStyle}" />
                        </Grid>

                    </ToggleButton>

                    <ToggleButton
                        Command="{Binding NavigateLibraryCommand}"
                        IsChecked="{Binding IsLibrarySelected, Mode=OneWay}"
                        Style="{StaticResource SidebarGroupButtonStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="25" Height="25" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Библиотека"
                                Style="{StaticResource SidebarTextStyle}" />

                            <materialDesign:PackIcon Grid.Column="2">
                                <materialDesign:PackIcon.Style>
                                    <Style
                                        TargetType="{x:Type materialDesign:PackIcon}"
                                        BasedOn="{StaticResource SidebarChevronStyle}">

                                        <Setter Property="Kind" Value="ChevronRight" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibraryMenuExpanded}" Value="True">
                                                <Setter Property="Kind" Value="ChevronDown" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Grid>
                    </ToggleButton>

                    <StackPanel Margin="0,3,0,7">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibrarySubmenuVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ToggleButton
                            Command="{Binding NavigateLibraryOverviewCommand}"
                            IsChecked="{Binding IsLibraryOverviewSelected, Mode=OneWay}"
                            Style="{StaticResource SidebarSubmenuButtonStyle}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="ViewGridOutline" Width="19" Height="19" />

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="11,0,0,0"
                                    Text="Обзор"
                                    FontSize="14"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>

                        <ToggleButton
                            Command="{Binding NavigateAllMaterialsCommand}"
                            IsChecked="{Binding IsAllMaterialsSelected, Mode=OneWay}"
                            Style="{StaticResource SidebarSubmenuButtonStyle}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="ViewAgendaOutline" Width="19" Height="19" />

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="11,0,0,0"
                                    Text="Все материалы"
                                    FontSize="14"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>

                        <ToggleButton
                            Command="{Binding NavigateLibraryManagementCommand}"
                            IsChecked="{Binding IsLibraryManagementSelected, Mode=OneWay}"
                            Style="{StaticResource SidebarSubmenuButtonStyle}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="PencilOutline" Width="19" Height="19" />

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="11,0,0,0"
                                    Text="Управление"
                                    FontSize="14"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>
                    </StackPanel>

                    <ToggleButton
                        Command="{Binding NavigatePracticeCommand}"
                        IsChecked="{Binding IsPracticeSelected, Mode=OneWay}"
                        Style="{StaticResource SidebarNavigationButtonStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon
                                Kind="CodeTags"
                                Width="25"
                                Height="25" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Практика"
                                Style="{StaticResource SidebarTextStyle}" />
                        </Grid>

                    </ToggleButton>

                    <ToggleButton
                        Command="{Binding NavigateTrainingCommand}"
                        IsChecked="{Binding IsTrainingSelected, Mode=OneWay}"
                        Style="{StaticResource SidebarNavigationButtonStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon
                                Kind="Dumbbell"
                                Width="25"
                                Height="25" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Тренировка"
                                Style="{StaticResource SidebarTextStyle}" />
                        </Grid>

                    </ToggleButton>

                    <ToggleButton
                        Command="{Binding NavigatePlanCommand}"
                        IsChecked="{Binding IsPlanSelected, Mode=OneWay}"
                        Style="{StaticResource SidebarNavigationButtonStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon
                                Kind="ClipboardTextOutline"
                                Width="25"
                                Height="25" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Мой план"
                                Style="{StaticResource SidebarTextStyle}" />
                        </Grid>

                    </ToggleButton>

                    <ToggleButton
                        Command="{Binding NavigateProgressCommand}"
                        IsChecked="{Binding IsProgressSelected, Mode=OneWay}"
                        Style="{StaticResource SidebarNavigationButtonStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon
                                Kind="ChartBar"
                                Width="25"
                                Height="25" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Прогресс"
                                Style="{StaticResource SidebarTextStyle}" />
                        </Grid>

                    </ToggleButton>

                    <ToggleButton
                        Command="{Binding NavigateSettingsCommand}"
                        IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                        Style="{StaticResource SidebarNavigationButtonStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon
                                Kind="CogOutline"
                                Width="25"
                                Height="25" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Настройки"
                                Style="{StaticResource SidebarTextStyle}" />
                        </Grid>

                    </ToggleButton>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Текущая страница -->

        <ContentControl
            Grid.Column="1"
            Content="{Binding CurrentPageViewModel}" />

        <ItemsControl
            Grid.ColumnSpan="2"
            Panel.ZIndex="100"
            Margin="0,24,24,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            ItemsSource="{Binding Notifications}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Width="360"
                        MinHeight="66"
                        Margin="0,0,0,10"
                        Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="12">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Color="#061735" Opacity="0.18" ShadowDepth="3" />
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Margin="0,8"
                                CornerRadius="2"
                                Style="{StaticResource NotificationAccentStyle}" />

                            <materialDesign:PackIcon
                                Grid.Column="1"
                                Width="25"
                                Height="25"
                                Margin="15,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource NotificationIconStyle}" />

                            <TextBlock
                                Grid.Column="2"
                                Margin="13,14"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                Text="{Binding Text}"
                                TextWrapping="Wrap" />

                            <Button
                                Grid.Column="3"
                                Margin="4,0,10,0"
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding Id}"
                                Style="{StaticResource NotificationCloseButtonStyle}"
                                ToolTip="Закрыть">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="Close" />
                            </Button>
                        </Grid>
                    </Border>
