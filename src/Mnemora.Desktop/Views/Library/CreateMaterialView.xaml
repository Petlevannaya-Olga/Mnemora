                                                         Kind="Close" />
                            </Button>

                            <TextBlock x:Name="QuestionFileError"
                                           Margin="18,0,18,8"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           FontSize="11"
                                           Foreground="#D14343"
                                           TextAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>

                            <Button Grid.Column="2"
                                    Style="{StaticResource CreateMaterial.TemplateSourceButton}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="44"
                                            Height="44"
                                            HorizontalAlignment="Center"
                                            Background="#F1EDFF"
                                            CornerRadius="14">
                                        <materialDesign:PackIcon Width="23"
                                                                 Height="23"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                                 Kind="FileDocumentPlusOutline" />
                                    </Border>
                                    <TextBlock Margin="0,7,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                               Text="Создать по шаблону" />
                                    <TextBlock Margin="0,3,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                               Text="Новый .md для редактора" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- Markdown эталонного ответа. -->

                        <Grid Margin="0,18,0,0" MinHeight="126">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="32*" />
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="AnswerDropZone"
                                  Grid.Column="0"
                                  Tag="Answer"
                                  AllowDrop="True"
                                  Background="Transparent"
                                  Cursor="Hand"
                                  PreviewDragEnter="MarkdownDropZone_OnDragEnter"
                                  PreviewDragOver="MarkdownDropZone_OnDragOver"
                                  PreviewDragLeave="MarkdownDropZone_OnDragLeave"
                                  PreviewDrop="MarkdownDropZone_OnDrop"
                                  PreviewMouseLeftButtonUp="MarkdownDropZone_OnMouseLeftButtonUp">
                                <Rectangle x:Name="AnswerDropBorder"
                                           Margin="1"
                                           RadiusX="16"
                                           RadiusY="16"
                                           Fill="{DynamicResource Mnemora.Brush.SurfaceMuted}"
                                           Stroke="{DynamicResource Mnemora.Brush.Border}"
                                           StrokeThickness="1.2"
                                           StrokeDashArray="5,4"
                                           SnapsToDevicePixels="True" />
                                <TextBlock Panel.ZIndex="2"
                                           Margin="18,-7,0,0"
                                           Padding="5,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Background="{DynamicResource Mnemora.Brush.SurfaceMuted}"
                                           FontSize="12"
                                           Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                           Text="Эталонный ответ" />

                                <StackPanel x:Name="AnswerEmptyState"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="44"
                                            Height="44"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource Mnemora.Brush.Surface}"
                                            BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <materialDesign:PackIcon Width="23"
                                                                 Height="23"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                                 Kind="FileUploadOutline" />
                                    </Border>
                                    <TextBlock Margin="0,7,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                               Text="Перетащи Markdown-файл сюда" />
                                    <TextBlock Margin="0,3,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                               Text="или нажми, чтобы выбрать" />
                                </StackPanel>

                                <Grid x:Name="AnswerSelectedState"
                                  Margin="28,18,48,18"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="46"
                                        Height="46"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Mnemora.Brush.Surface}"
                                        BorderBrush="{DynamicResource Mnemora.Brush.Primary}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <materialDesign:PackIcon Width="23"
                                                             Height="23"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                             Kind="FileDocumentOutline" />
                                </Border>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AnswerSelectedFileName"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                               Text="Нажми на карточку, чтобы выбрать другой файл" />
                                </StackPanel>

                                <Button Grid.Column="4"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Tag="Answer"
                                        Click="OpenSelectedMarkdown_OnClick"
                                        Style="{StaticResource Mnemora.SecondaryButton}"
                                        ToolTip="Открыть в редакторе">
                                    <materialDesign:PackIcon Width="18"
                                                             Height="18"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Kind="OpenInNew" />
                                </Button>
                            </Grid>

                            <Button x:Name="AnswerClearFileButton"
                                    Margin="0,10,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Tag="Answer"
                                    Click="ClearSelectedMarkdown_OnClick"
                                    Panel.ZIndex="20"
                                    Style="{StaticResource CreateMaterial.ClearFileButton}"
                                    ToolTip="Сбросить выбранный файл"
                                    Visibility="Collapsed">
                                <materialDesign:PackIcon Width="17"
                                                         Height="17"
                                                         Kind="Close" />
                            </Button>

                            <TextBlock x:Name="AnswerFileError"
                                           Margin="18,0,18,8"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           FontSize="11"
                                           Foreground="#D14343"
                                           TextAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>

                            <Button Grid.Column="2"
                                    Style="{StaticResource CreateMaterial.TemplateSourceButton}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="44"
                                            Height="44"
                                            HorizontalAlignment="Center"
                                            Background="#E8FAF7"
                                            CornerRadius="14">
                                        <materialDesign:PackIcon Width="23"
                                                                 Height="23"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                                                 Kind="FileDocumentPlusOutline" />
                                    </Border>
                                    <TextBlock Margin="0,7,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                               Text="Создать по шаблону" />
                                    <TextBlock Margin="0,3,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                               Text="Новый .md для редактора" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="32,16"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button HorizontalAlignment="Left"
                        Style="{StaticResource Mnemora.SecondaryButton}"
                        Click="GoToTypeStep_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Kind="ChevronLeft" />
                        <TextBlock Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Назад" />
                    </StackPanel>
                </Button>

                <!-- На этапе согласования следующего шага кнопка остаётся визуальной. -->
                <Button Grid.Column="1"
                        MinWidth="132"
                        Height="44"
                        IsEnabled="False"
                        Style="{StaticResource Mnemora.PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Далее" />
                        <materialDesign:PackIcon Width="18" Height="18"
                                                 Margin="7,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Kind="ChevronRight" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</TabItem>

</TabControl></Grid></UserControl>
