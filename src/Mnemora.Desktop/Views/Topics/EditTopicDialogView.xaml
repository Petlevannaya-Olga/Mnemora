<UserControl
    x:Class="Mnemora.Desktop.Views.Topics.EditTopicDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="700"
    MaxHeight="740"
    Background="Transparent"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True">

    <UserControl.InputBindings>
        <KeyBinding
            Key="Escape"
            Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="22">

        <!-- Тень вынесена отдельно, чтобы не размывать текст -->

        <Border
            Margin="1"
            Background="{StaticResource Mnemora.Brush.Surface}"
            CornerRadius="18">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="26"
                    Color="#061735"
                    Opacity="0.28"
                    ShadowDepth="7" />
            </Border.Effect>

        </Border>

        <!-- Основная поверхность -->

        <Border
            Padding="30,26,30,30"
            Background="{StaticResource Mnemora.Brush.Surface}"
            BorderBrush="{StaticResource Mnemora.Brush.Border}"
            BorderThickness="1"
            CornerRadius="18">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="48"
                        Height="48"
                        Background="{Binding SelectedColor.Brush}"
                        CornerRadius="12">

                        <materialDesign:PackIcon
                            Width="27"
                            Height="27"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="{Binding SelectedIcon.Kind}" />

                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Margin="15,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            FontSize="21"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                            Text="Редактирование темы" />

                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="13"
                            Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                            Text="Измените название и оформление темы" />

                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Mnemora.DialogCloseButton}">

                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Foreground="{Binding Foreground,
                                RelativeSource={RelativeSource AncestorType=Button}}"
                            Kind="Close" />

                    </Button>

                </Grid>

                <!-- Содержимое -->

                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,22,0,0"
                    MaxHeight="510"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="0,0,8,0">

                        <!-- Название -->

                        <TextBox
                            MaxLength="150"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Name,
                                UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="Название темы"
                            materialDesign:TextFieldAssist.HasClearButton="True" />

                        <!-- Цвет -->

                        <TextBlock
                            Margin="0,21,0,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                            Text="Цвет" />

                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding ColorOptions}"
                            SelectedItem="{Binding SelectedColor}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">

                                    <Setter
                                        Property="Margin"
                                        Value="0,0,10,0" />

                                    <Setter
                                        Property="Padding"
                                        Value="0" />

                                    <Setter
                                        Property="Background"
                                        Value="Transparent" />

                                    <Setter
                                        Property="FocusVisualStyle"
                                        Value="{x:Null}" />

                                    <Setter Property="Template">
                                        <Setter.Value>

                                            <ControlTemplate
                                                TargetType="ListBoxItem">

                                                <Border
                                                    x:Name="SelectionBorder"
                                                    Width="38"
                                                    Height="38"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    CornerRadius="19"
                                                    Cursor="Hand">

                                                    <Grid>

                                                        <Ellipse
                                                            Margin="5"
                                                            Fill="{Binding Brush}" />

                                                        <materialDesign:PackIcon
                                                            x:Name="SelectedMark"
                                                            Width="17"
                                                            Height="17"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="White"
                                                            Kind="Check"
                                                            Visibility="Collapsed" />

                                                    </Grid>

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <Trigger
                                                        Property="IsMouseOver"
                                                        Value="True">

                                                        <Setter
                                                            TargetName="SelectionBorder"
                                                            Property="Opacity"
                                                            Value="0.82" />

                                                    </Trigger>

                                                    <Trigger
                                                        Property="IsSelected"
                                                        Value="True">

                                                        <Setter
                                                            TargetName="SelectionBorder"
                                                            Property="BorderBrush"
                                                            Value="{StaticResource Mnemora.Brush.PrimaryDark}" />

                                                        <Setter
                                                            TargetName="SelectedMark"
                                                            Property="Visibility"
                                                            Value="Visible" />

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Setter.Value>
                                    </Setter>

                                </Style>
                            </ListBox.ItemContainerStyle>

                        </ListBox>

                        <!-- Иконка -->

                        <TextBlock
                            Margin="0,20,0,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                            Text="Иконка" />

                        <Border
                            Padding="14"
                            Background="{StaticResource Mnemora.Brush.SurfaceMuted}"
                            BorderBrush="{StaticResource Mnemora.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="11">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Предпросмотр -->

                                <Border
                                    Width="58"
                                    Height="58"
                                    Background="{Binding SelectedColor.Brush}"
                                    CornerRadius="13">

                                    <materialDesign:PackIcon
                                        Width="31"
                                        Height="31"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="{Binding SelectedIcon.Kind}" />

                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="15,0"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                        Text="{Binding SelectedIcon.Name}" />

                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="13"
                                        Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                        Text="{Binding SelectedIcon.Category}" />

                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    Height="44"
                                    MinWidth="180"
                                    Padding="18,0"
                                    Command="{Binding OpenIconPickerCommand}"
                                    Style="{StaticResource Mnemora.SecondaryButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            Kind="ShapeOutline" />

                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Выбрать иконку" />

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Border>

                        <!-- Ошибка -->

                        <Border
                            Margin="0,14,0,0"
                            Padding="12,9"
                            Background="#FFF1F1"
                            CornerRadius="8">

                            <Border.Style>
                                <Style TargetType="Border">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding HasError}"
                                            Value="True">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Border.Style>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon
                                    Width="19"
                                    Height="19"
                                    VerticalAlignment="Top"
                                    Foreground="#C62828"
                                    Kind="AlertCircleOutline" />

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="9,0,0,0"
                                    FontSize="13"
                                    Foreground="#A52222"
                                    Text="{Binding ErrorMessage}"
                                    TextWrapping="Wrap" />

                            </Grid>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- Кнопки -->

                <Grid
                    Grid.Row="2"
                    Margin="0,24,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Command="{Binding CancelCommand}"
                        Content="Отмена"
                        Style="{StaticResource Mnemora.SecondaryButton}" />

                    <Button
                        Grid.Column="2"
                        Command="{Binding SaveCommand}"
                        IsDefault="True"
                        Style="{StaticResource Mnemora.PrimaryButton}">

                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">

                                    <Setter
                                        Property="Text"
                                        Value="Сохранить изменения" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsSaving}"
                                            Value="True">

                                            <Setter
                                                Property="Text"
                                                Value="Сохраняем..." />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </Button>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>