<UserControl x:Class="Mnemora.Desktop.Views.Onboarding.EditorSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignWidth="1600"
             d:DesignHeight="900"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="OnboardingOutlineButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Foreground" Value="{StaticResource Mnemora.Brush.PrimaryDark}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Mnemora.Brush.Primary}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0FFFC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorSecondaryTextButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Foreground" Value="{StaticResource Mnemora.Brush.PrimaryDark}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0FFFC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorPathTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Mnemora.Brush.TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorChoiceButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnboardingInactiveStepStyle"
               TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="BorderBrush" Value="#53618C" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Mnemora.Brush.OnboardingBackground}"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image Grid.Row="0"
               Source="pack://application:,,,/Assets/Images/MnemoraLogo.png"
               Width="360"
               Height="90"
               Margin="28,12,28,10"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True" />

        <!-- Шаги онбординга -->

        <Grid Grid.Row="1"
              MaxWidth="820"
              Margin="24,0,24,0"
              HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CheckBold"
                                         Width="18"
                                         Height="18"
                                         Foreground="{StaticResource Mnemora.Brush.Primary}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Height="3"
                    Margin="4,0"
                    Background="{StaticResource Mnemora.Brush.Primary}"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <Border Grid.Row="0"
                    Grid.Column="2"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CheckBold"
                                         Width="18"
                                         Height="18"
                                         Foreground="{StaticResource Mnemora.Brush.Primary}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="3"
                    Height="3"
                    Margin="4,0"
                    Background="{StaticResource Mnemora.Brush.Primary}"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <Border Grid.Row="0"
                    Grid.Column="4"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <TextBlock Text="3"
                           Foreground="{StaticResource Mnemora.Brush.Primary}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="5"
                    Height="3"
                    Margin="4,0"
                    Background="#53618C"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <Border Grid.Row="0"
                    Grid.Column="6"
                    Style="{StaticResource OnboardingInactiveStepStyle}">
                <TextBlock Text="4"
                           Foreground="#D5DAED"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="7"
                    Height="3"
                    Margin="4,0"
                    Background="#53618C"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <Border Grid.Row="0"
                    Grid.Column="8"
                    Style="{StaticResource OnboardingInactiveStepStyle}">
                <TextBlock Text="5"
                           Foreground="#D5DAED"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Профиль"
                       Foreground="#C9CFE3"
                       FontSize="14"
                       TextAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Grid.Column="2"
                       Text="Хранилище"
                       Foreground="#C9CFE3"
                       FontSize="14"
                       TextAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Grid.Column="4"
                       Text="Редактор"
                       Foreground="{StaticResource Mnemora.Brush.Primary}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Grid.Column="6"
                       Text="ИИ"
                       Foreground="#C9CFE3"
                       FontSize="14"
                       TextAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Grid.Column="8"
                       Text="Начало"
                       Foreground="#C9CFE3"
                       FontSize="14"
                       TextAlignment="Center" />

        </Grid>

        <Grid Grid.Row="2">
            <StackPanel Margin="0,18,0,0"
                        VerticalAlignment="Top">

                <Border MaxWidth="724"
                        Margin="48,0"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource Mnemora.Brush.Surface}"
                        CornerRadius="22">
                    <Border.Effect>
                        <DropShadowEffect Color="#020A20"
                                          BlurRadius="28"
                                          ShadowDepth="8"
                                          Opacity="0.34" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="56,30,56,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Width="82"
                                  Height="82"
                                  HorizontalAlignment="Center">
                                <Ellipse Fill="{StaticResource Mnemora.Brush.SurfaceMuted}"
                                         Stroke="{StaticResource Mnemora.Brush.BrandGradient}"
                                         StrokeThickness="3" />
                                <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                         Width="42"
                                                         Height="42"
                                                         Foreground="{StaticResource Mnemora.Brush.BrandGradient}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Margin="0,24,0,12">
                                <TextBlock Text="Выберите Markdown-редактор"
                                           Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                           FontSize="27"
                                           FontWeight="Bold"
                                           TextAlignment="Center" />
                                <TextBlock Text="Mnemora будет открывать Markdown-файлы в привычном приложении"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                           FontSize="15"
                                           TextAlignment="Center" />
                                <TextBlock Text="Для продолжения нужно настроить и проверить один из редакторов"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                           FontSize="12"
                                           TextAlignment="Center" />
                            </StackPanel>

                            <Grid Grid.Row="2"
                                  Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding SelectVisualStudioCodeCommand}"
                                        Style="{StaticResource EditorChoiceButtonStyle}">
                                    <Border Padding="18,11"
                                            CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Mnemora.Brush.Surface}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Mnemora.Brush.Border}" />
                                                <Setter Property="BorderThickness" Value="1.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVisualStudioCodeSelected}" Value="True">
                                                        <Setter Property="Background" Value="#F0FFFC" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Mnemora.Brush.Primary}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44"
                                                    Height="44"
                                                    Background="{StaticResource Mnemora.Brush.SurfaceMuted}"
                                                    CornerRadius="10">
                                                <materialDesign:PackIcon Kind="CodeTags"
                                                                         Width="25"
                                                                         Height="25"
                                                                         Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Visual Studio Code"
                                                           Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="Код и Markdown"
                                                           Margin="0,3,0,0"
                                                           Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                           FontSize="12" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"
                                                                    Value="{Binding VisualStudioCodeAvailabilityText}" />
                                                            <Setter Property="Foreground"
                                                                    Value="#D53E4F" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVisualStudioCodeInstalled}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="#12B84F" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Grid Grid.Column="2"
                                                  Width="22"
                                                  Height="22"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVisualStudioCodeSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <!-- Выбран, но ещё не проверен. -->
                                                <Border Width="18"
                                                        Height="18"
                                                        CornerRadius="9"
                                                        BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                                                        BorderThickness="2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConfigurationVerified}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Fill="{StaticResource Mnemora.Brush.Primary}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Галочка появляется только после успешной проверки редактора. -->
                                                <materialDesign:PackIcon Kind="CheckCircle"
                                                                         Width="22"
                                                                         Height="22"
                                                                         Foreground="{StaticResource Mnemora.Brush.Primary}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConfigurationVerified}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>

                                <Button Grid.Column="2"
                                        Command="{Binding SelectObsidianCommand}"
                                        Style="{StaticResource EditorChoiceButtonStyle}">
                                    <Border Padding="18,11"
                                            CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Mnemora.Brush.Surface}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Mnemora.Brush.Border}" />
                                                <Setter Property="BorderThickness" Value="1.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsObsidianSelected}" Value="True">
                                                        <Setter Property="Background" Value="#F6F2FF" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Mnemora.Brush.Secondary}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44"
                                                    Height="44"
                                                    Background="#F4F0FF"
                                                    CornerRadius="10">
                                                <materialDesign:PackIcon Kind="BookOpenPageVariantOutline"
                                                                         Width="25"
                                                                         Height="25"
                                                                         Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Obsidian"
                                                           Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="Markdown и база знаний"
                                                           Margin="0,3,0,0"
                                                           Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                           FontSize="12" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"
                                                                    Value="{Binding ObsidianAvailabilityText}" />
                                                            <Setter Property="Foreground"
                                                                    Value="#D53E4F" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsObsidianInstalled}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="#12B84F" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Grid Grid.Column="2"
                                                  Width="22"
                                                  Height="22"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsObsidianSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <!-- Выбран, но ещё не проверен. -->
                                                <Border Width="18"
                                                        Height="18"
                                                        CornerRadius="9"
                                                        BorderBrush="{StaticResource Mnemora.Brush.Secondary}"
                                                        BorderThickness="2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConfigurationVerified}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Fill="{StaticResource Mnemora.Brush.Secondary}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Галочка появляется только после успешной проверки редактора. -->
                                                <materialDesign:PackIcon Kind="CheckCircle"
                                                                         Width="22"
                                                                         Height="22"
                                                                         Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConfigurationVerified}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </Grid>

                            <StackPanel Grid.Row="3"
                                        Margin="0,12,0,0">

                                <Border Padding="14,11"
                                        Background="{StaticResource Mnemora.Brush.SurfaceMuted}"
                                        CornerRadius="12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <!-- Блок настройки нужен только для Obsidian:
                                                     после обнаружения приложения пользователь выбирает Vault. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsObsidianSelected}"
                                                                   Value="True" />
                                                        <Condition Binding="{Binding IsObsidianInstalled}"
                                                                   Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- Obsidian -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsObsidianSelected}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsObsidianInstalled}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Хранилище Obsidian"
                                                           Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />

                                                <StackPanel Grid.Row="1"
                                                            Margin="0,4,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ObsidianVaultPath}"
                                                                             Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <TextBlock Text="Сначала создайте или откройте Vault в Obsidian, затем выберите его здесь."
                                                               Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="Vault — это папка Obsidian, содержащая каталог .obsidian."
                                                               Margin="0,2,0,0"
                                                               Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Grid Grid.Row="2"
                                                      Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="48" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Text="{Binding ObsidianVaultPath, Mode=OneWay}"
                                                             ToolTip="{Binding ObsidianVaultPath}"
                                                             IsReadOnly="True"
                                                             Style="{StaticResource EditorPathTextBoxStyle}" />

                                                    <Button Grid.Column="2"
                                                            Width="48"
                                                            Height="48"
                                                            Padding="0"
                                                            ToolTip="Выбрать хранилище Obsidian"
                                                            Command="{Binding SelectObsidianVaultCommand}"
                                                            Style="{StaticResource OnboardingOutlineButtonStyle}">
                                                        <materialDesign:PackIcon Kind="FolderOpenOutline"
                                                                                 Width="20"
                                                                                 Height="20"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Проверка редактора — тот же паттерн, что на экране ИИ -->
                                <Border Margin="0,10,0,0"
                                        Padding="14,10"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="#F7F8FE" />
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource Mnemora.Brush.Border}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConfigurationVerified}"
                                                             Value="True">
                                                    <Setter Property="Background"
                                                            Value="#F1FBF6" />
                                                    <Setter Property="BorderBrush"
                                                            Value="#9912B84F" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsConfigurationInvalid}"
                                                             Value="True">
                                                    <Setter Property="Background"
                                                            Value="#FFF4F5" />
                                                    <Setter Property="BorderBrush"
                                                            Value="#99D53E4F" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0"
                                              Width="26"
                                              Height="26"
                                              VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="InformationOutline"
                                                                     Width="24"
                                                                     Height="24"
                                                                     Foreground="{StaticResource Mnemora.Brush.TextSecondary}">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfigurationVerified}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsConfigurationInvalid}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>

                                            <materialDesign:PackIcon Kind="CheckBold"
                                                                     Width="24"
                                                                     Height="24"
                                                                     Foreground="#12B84F">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfigurationVerified}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>

                                            <materialDesign:PackIcon Kind="CloseThick"
                                                                     Width="24"
                                                                     Height="24"
                                                                     Foreground="#D53E4F">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfigurationInvalid}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Grid>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ConfigurationTitle}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource Mnemora.Brush.TextPrimary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfigurationInvalid}"
                                                                         Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="#D53E4F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding ConfigurationMessage}"
                                                       Margin="0,2,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Width="150"
                                                Height="38"
                                                Padding="14,0"
                                                Command="{Binding CheckConfigurationCommand}"
                                                Style="{StaticResource OnboardingOutlineButtonStyle}">
                                            <TextBlock FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"
                                                                Value="Проверить" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecking}"
                                                                         Value="True">
                                                                <Setter Property="Text"
                                                                        Value="Проверяем…" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Действия для отсутствующего VS Code вынесены под карточку проверки.
                                     Установка — основное действие, повторный поиск — лёгкое,
                                     ручной выбор пути — компактное третьестепенное. -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsVisualStudioCodeSelected}"
                                                                   Value="True" />
                                                        <Condition Binding="{Binding IsVisualStudioCodeInstalled}"
                                                                   Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Height="38"
                                            Padding="14,0"
                                            Command="{Binding InstallVisualStudioCodeCommand}"
                                            Style="{StaticResource Mnemora.PrimaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Download"
                                                                     Width="16"
                                                                     Height="16"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="Установить Visual Studio Code"
                                                       Margin="7,0,0,0"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Command="{Binding RefreshEditorsCommand}"
                                                Style="{StaticResource EditorSecondaryTextButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Refresh"
                                                                         Width="15"
                                                                         Height="15"
                                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="Найти снова"
                                                           Margin="5,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Margin="12,0,0,0"
                                                ToolTip="Указать путь к Visual Studio Code вручную"
                                                Command="{Binding SelectVisualStudioCodeFolderCommand}"
                                                Style="{StaticResource EditorSecondaryTextButtonStyle}">
                                            <TextBlock Text="Указать путь вручную"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Действия для отсутствующего Obsidian оформлены тем же утверждённым паттерном,
                                     что и для VS Code: установка — основное действие, повторный поиск — лёгкое. -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsObsidianSelected}"
                                                                   Value="True" />
                                                        <Condition Binding="{Binding IsObsidianInstalled}"
                                                                   Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Height="38"
                                            Padding="14,0"
                                            Command="{Binding InstallObsidianCommand}"
                                            Style="{StaticResource Mnemora.PrimaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Download"
                                                                     Width="16"
                                                                     Height="16"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="Установить Obsidian"
                                                       Margin="7,0,0,0"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Command="{Binding RefreshEditorsCommand}"
                                                Style="{StaticResource EditorSecondaryTextButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Refresh"
                                                                         Width="15"
                                                                         Height="15"
                                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="Найти снова"
                                                           Margin="5,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Margin="12,0,0,0"
                                                ToolTip="Выбрать Vault вручную"
                                                Command="{Binding SelectObsidianVaultCommand}"
                                                Style="{StaticResource EditorSecondaryTextButtonStyle}">
                                            <TextBlock Text="Выбрать Vault вручную"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,10,0,0"
                                Padding="42,16"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="120"
                                        Command="{Binding BackCommand}"
                                        Style="{StaticResource OnboardingOutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ArrowLeft"
                                                                 Width="21"
                                                                 Height="21"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="Назад"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Command="{Binding ContinueCommand}"
                                        Style="{StaticResource Mnemora.PrimaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Продолжить"
                                                   VerticalAlignment="Center" />
                                        <materialDesign:PackIcon Kind="ArrowRight"
                                                                 Width="21"
                                                                 Height="21"
                                                                 Margin="18,0,0,0"
                                                                 VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="Шаг 3 из 5"
                           Margin="0,24,0,0"
                           Foreground="White"
                           FontSize="15"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
