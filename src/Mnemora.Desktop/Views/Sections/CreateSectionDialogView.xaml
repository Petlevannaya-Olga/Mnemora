<UserControl x:Class="Mnemora.Desktop.Views.Sections.CreateSectionDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="560"
             Background="Transparent"
             ClipToBounds="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="26,22,26,30"
          ClipToBounds="False">

        <Border Padding="30,26,30,30"
                Background="{StaticResource Mnemora.Brush.Surface}"
                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="18"
                ClipToBounds="False">

            <Border.Effect>
                <DropShadowEffect Color="#061735"
                                  BlurRadius="26"
                                  ShadowDepth="7"
                                  Opacity="0.28" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок -->

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="48"
                            Height="48"
                            Background="#EEFFFC"
                            CornerRadius="12">

                        <materialDesign:PackIcon Width="27"
                                                 Height="27"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="{StaticResource Mnemora.Brush.PrimaryDark}"
                                                 Kind="FolderPlusOutline" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="15,0"
                                VerticalAlignment="Center">

                        <TextBlock Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Text="Новый раздел" />

                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                   FontSize="13"
                                   Text="Объедините связанные темы в одном месте" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource Mnemora.DialogCloseButton}">

                        <materialDesign:PackIcon
                            Kind="Close"
                            Width="20"
                            Height="20"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />

                    </Button>
                </Grid>

                <!-- Подсказка -->

                <TextBlock Grid.Row="1"
                           Margin="0,22,0,0"
                           Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                           FontSize="13"
                           LineHeight="19"
                           Text="Название должно описывать крупную область знаний, например Backend или Базы данных."
                           TextWrapping="Wrap" />

                <!-- Название -->

                <TextBox x:Name="NameTextBox"
                         Grid.Row="2"
                         MinHeight="54"
                         Margin="0,18,0,0"
                         MaxLength="150"
                         VerticalContentAlignment="Center"
                         Text="{Binding Name,
                                        UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Название раздела"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <!-- Ошибка -->

                <Border Grid.Row="3"
                        Margin="0,12,0,0"
                        Padding="12,9"
                        Background="#FFF1F1"
                        CornerRadius="8">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Width="19"
                                                 Height="19"
                                                 VerticalAlignment="Top"
                                                 Foreground="#C62828"
                                                 Kind="AlertCircleOutline" />

                        <TextBlock Grid.Column="1"
                                   Margin="9,0,0,0"
                                   Foreground="#A52222"
                                   FontSize="13"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- Кнопки -->

                <Grid Grid.Row="4"
                      Margin="0,26,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Height="52"
                            Command="{Binding CancelCommand}"
                            Content="Отмена"
                            Style="{StaticResource Mnemora.SecondaryButton}" />

                    <Button Grid.Column="2"
                            Height="52"
                            IsDefault="True"
                            Command="{Binding CreateCommand}"
                            Style="{StaticResource Mnemora.PrimaryButton}">

                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"
                                            Value="Создать раздел" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCreating}"
                                                     Value="True">
                                            <Setter Property="Text"
                                                    Value="Создаём..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>