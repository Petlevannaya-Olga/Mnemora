<UserControl x:Class="Mnemora.Desktop.Views.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Mnemora.Desktop.Converters"
             Loaded="HomeView_OnLoaded"
             Unloaded="HomeView_OnUnloaded">

    <UserControl.Resources>
        <converters:SectionColorConverter x:Key="SectionColorConverter" />
        <converters:SectionIconConverter x:Key="SectionIconConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource Mnemora.Brush.SurfaceMuted}">

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

            <Grid Margin="34,28,34,30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Приветствие -->

                <StackPanel Grid.Row="0">

                    <TextBlock Text="{Binding Greeting}"
                               Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                               FontSize="34"
                               FontWeight="SemiBold" />

                    <TextBlock Margin="0,7,0,0"
                               Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                               FontSize="17">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">

                                <Setter Property="Text"
                                        Value="Начнём собирать вашу базу знаний" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding HasSectionsWithoutTopics}"
                                                 Value="True">
                                        <Setter Property="Text"
                                                Value="Начало положено — добавим первую тему" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding HasTopics}"
                                                 Value="True">
                                        <Setter Property="Text"
                                                Value="Ваша база знаний начинает наполняться" />
                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                </StackPanel>

                <!-- Основное содержимое -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка -->

                    <Grid Grid.Column="0">

                        <!-- Загрузка -->

                        <Border MinHeight="520"
                                Background="{StaticResource Mnemora.Brush.Surface}"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <ProgressBar Width="230"
                                             Height="5"
                                             IsIndeterminate="True"
                                             Foreground="{StaticResource Mnemora.Brush.Primary}" />

                                <TextBlock Margin="0,18,0,0"
                                           Text="Загружаем состояние библиотеки..."
                                           Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                           FontSize="15" />

                            </StackPanel>

                        </Border>

                        <!-- Ошибка загрузки -->

                        <Border MinHeight="520"
                                Padding="40"
                                Background="{StaticResource Mnemora.Brush.Surface}"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLibraryError}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Width="430"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                         Width="52"
                                                         Height="52"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{StaticResource Mnemora.Brush.Secondary}" />

                                <TextBlock Margin="0,20,0,0"
                                           Text="Не удалось загрузить библиотеку"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                           FontSize="21"
                                           FontWeight="SemiBold" />

                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding LibraryErrorMessage}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                           FontSize="14" />

                            </StackPanel>

                        </Border>

                        <!-- Пустая библиотека -->

                        <Border MinHeight="520"
                                Padding="38,32"
                                Background="{StaticResource Mnemora.Brush.Surface}"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryEmpty}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.Effect>
                                <DropShadowEffect Color="#061735"
                                                  BlurRadius="14"
                                                  ShadowDepth="2"
                                                  Opacity="0.07" />
                            </Border.Effect>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Width="94"
                                        Height="94"
                                        HorizontalAlignment="Center"
                                        Background="#F0F1FF"
                                        CornerRadius="47">

                                    <materialDesign:PackIcon Kind="FolderOpenOutline"
                                                             Width="54"
                                                             Height="54"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource Mnemora.Brush.Secondary}" />

                                </Border>

                                <StackPanel Grid.Row="1"
                                            Margin="0,18,0,0">

                                    <TextBlock Text="В библиотеке пока нет материалов"
                                               Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center" />

                                    <TextBlock Margin="26,11,26,0"
                                               Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                               FontSize="15"
                                               LineHeight="22"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap">

                                        <Run Text="Создайте раздел, добавьте в него тему," />
                                        <LineBreak />
                                        <Run Text="а затем подключите статью или вопрос в формате Markdown" />

                                    </TextBlock>

                                </StackPanel>

                                <!-- Начальные шаги -->

                                <Grid Grid.Row="3">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <Border Width="42"
                                                Height="42"
                                                HorizontalAlignment="Center"
                                                Background="White"
                                                BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                                                BorderThickness="1.5"
                                                CornerRadius="9">

                                            <TextBlock Text="1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Mnemora.Brush.PrimaryDark}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />

                                        </Border>

                                        <TextBlock Margin="4,13,4,0"
                                                   Text="Создать раздел"
                                                   Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="4,6,4,0"
                                                   Text="Например, Backend"
                                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />

                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Height="2"
                                            Margin="0,20,0,0"
                                            VerticalAlignment="Top"
                                            Background="#AEB4CC"
                                            CornerRadius="1" />

                                    <StackPanel Grid.Column="2">

                                        <Border Width="42"
                                                Height="42"
                                                HorizontalAlignment="Center"
                                                Background="White"
                                                BorderBrush="#3E89FF"
                                                BorderThickness="1.5"
                                                CornerRadius="9">

                                            <TextBlock Text="2"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#2468E7"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />

                                        </Border>

                                        <TextBlock Margin="4,13,4,0"
                                                   Text="Добавить тему"
                                                   Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="4,6,4,0"
                                                   Text="Например, EF Core"
                                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />

                                    </StackPanel>

                                    <Border Grid.Column="3"
                                            Height="2"
                                            Margin="0,20,0,0"
                                            VerticalAlignment="Top"
                                            Background="#AEB4CC"
                                            CornerRadius="1" />

                                    <StackPanel Grid.Column="4">

                                        <Border Width="42"
                                                Height="42"
                                                HorizontalAlignment="Center"
                                                Background="White"
                                                BorderBrush="{StaticResource Mnemora.Brush.Secondary}"
                                                BorderThickness="1.5"
                                                CornerRadius="9">

                                            <TextBlock Text="3"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />

                                        </Border>

                                        <TextBlock Margin="4,13,4,0"
                                                   Text="Добавить материал"
                                                   Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="4,6,4,0"
                                                   Text="Статья или вопрос"
                                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />

                                    </StackPanel>

                                    <Border Grid.Column="5"
                                            Height="2"
                                            Margin="0,20,0,0"
                                            VerticalAlignment="Top"
                                            Background="#AEB4CC"
                                            CornerRadius="1" />

                                    <StackPanel Grid.Column="6">

                                        <Border Width="42"
                                                Height="42"
                                                HorizontalAlignment="Center"
                                                Background="White"
                                                BorderBrush="#B752D7"
                                                BorderThickness="1.5"
                                                CornerRadius="9">

                                            <TextBlock Text="4"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#A33AC8"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />

                                        </Border>

                                        <TextBlock Margin="4,13,4,0"
                                                   Text="Начать обучение"
                                                   Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="4,6,4,0"
                                                   Text="Теория и вопросы"
                                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />

                                    </StackPanel>

                                </Grid>

                                <Button Grid.Row="5"
                                        Width="350"
                                        HorizontalAlignment="Center"
                                        Command="{Binding CreateFirstSectionCommand}"
                                        Style="{StaticResource Mnemora.PrimaryButton}">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="Создать первый раздел"
                                                   VerticalAlignment="Center" />

                                        <materialDesign:PackIcon Kind="ArrowRight"
                                                                 Width="21"
                                                                 Height="21"
                                                                 Margin="18,0,0,0"
                                                                 VerticalAlignment="Center" />

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Border>

                        <!-- Разделы созданы, тем пока нет -->

                        <Border MinHeight="520"
                                Padding="34,30"
                                Background="{StaticResource Mnemora.Brush.Surface}"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSectionsWithoutTopics}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.Effect>
                                <DropShadowEffect Color="#061735"
                                                  BlurRadius="14"
                                                  ShadowDepth="2"
                                                  Opacity="0.07" />
                            </Border.Effect>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Заголовок -->

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="58"
                                            Height="58"
                                            Background="#EEFFFC"
                                            CornerRadius="29">

                                        <materialDesign:PackIcon Kind="CheckBold"
                                                                 Width="28"
                                                                 Height="28"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource Mnemora.Brush.PrimaryDark}" />

                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="16,0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="Первый раздел создан"
                                                   Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />

                                        <TextBlock Margin="0,5,0,0"
                                                   Text="Теперь добавьте в него первую тему"
                                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                   FontSize="14" />

                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Height="40"
                                            MinHeight="40"
                                            MinWidth="154"
                                            Padding="16,0"
                                            Command="{Binding OpenLibraryCommand}"
                                            Style="{StaticResource Mnemora.SecondaryButton}">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="Библиотека"
                                                       VerticalAlignment="Center" />

                                            <materialDesign:PackIcon Kind="ArrowRight"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Margin="9,0,0,0"
                                                                     VerticalAlignment="Center" />

                                        </StackPanel>

                                    </Button>

                                </Grid>

                                <!-- Предлагаемый раздел -->

                                <Border Grid.Row="2"
                                        Padding="18"
                                        Background="{StaticResource Mnemora.Brush.SurfaceMuted}"
                                        BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="12">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="58"
                                                Height="58"
                                                Background="{Binding SuggestedSection.Color,
                                                    Converter={StaticResource SectionColorConverter}}"
                                                CornerRadius="13">

                                            <materialDesign:PackIcon
                                                Kind="{Binding SuggestedSection.Icon,
                                                    Converter={StaticResource SectionIconConverter}}"
                                                Width="31"
                                                Height="31"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="White" />

                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="16,0"
                                                    VerticalAlignment="Center">

                                            <TextBlock Text="{Binding SuggestedSection.Name}"
                                                       Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Margin="0,5,0,0"
                                                       Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                       FontSize="13">

                                                <Run Text="Тем: " />
                                                <Run Text="{Binding SuggestedSection.Topics.Count, Mode=OneWay}" />

                                            </TextBlock>

                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Padding="13,7"
                                                VerticalAlignment="Center"
                                                Background="#EEFFFC"
                                                CornerRadius="8">

                                            <TextBlock Foreground="{StaticResource Mnemora.Brush.PrimaryDark}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold">

                                                <Run Text="{Binding SectionsCount, Mode=OneWay}" />
                                                <Run Text=" раздел" />

                                            </TextBlock>

                                        </Border>

                                    </Grid>

                                </Border>

                                <!-- Следующий шаг -->

                                <StackPanel Grid.Row="4">

                                    <TextBlock Text="Следующий шаг"
                                               Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />

                                    <Grid Margin="0,15,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="44"
                                                Height="44"
                                                Background="{StaticResource Mnemora.Brush.Primary}"
                                                CornerRadius="10">

                                            <materialDesign:PackIcon Kind="Check"
                                                                     Width="23"
                                                                     Height="23"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="White" />

                                        </Border>

                                        <Border Grid.Column="1"
                                                Height="2"
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource Mnemora.Brush.Primary}" />

                                        <Border Grid.Column="2"
                                                Width="44"
                                                Height="44"
                                                Background="White"
                                                BorderBrush="#3E89FF"
                                                BorderThickness="2"
                                                CornerRadius="10">

                                            <TextBlock Text="2"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#2468E7"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />

                                        </Border>

                                        <Border Grid.Column="3"
                                                Height="2"
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                Background="#D9DCEB" />

                                        <Border Grid.Column="4"
                                                Width="44"
                                                Height="44"
                                                Background="White"
                                                BorderBrush="#D9DCEB"
                                                BorderThickness="1.5"
                                                CornerRadius="10">

                                            <TextBlock Text="3"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />

                                        </Border>

                                    </Grid>

                                    <Grid Margin="0,9,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Раздел"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Mnemora.Brush.PrimaryDark}"
                                                   FontSize="11" />

                                        <TextBlock Grid.Column="2"
                                                   Text="Тема"
                                                   HorizontalAlignment="Center"
                                                   Foreground="#2468E7"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />

                                        <TextBlock Grid.Column="4"
                                                   Text="Материал"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                   FontSize="11" />

                                    </Grid>

                                </StackPanel>

                                <!-- Действия -->

                                <Grid Grid.Row="6">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Command="{Binding AddFirstTopicCommand}"
                                            Style="{StaticResource Mnemora.PrimaryButton}">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="Добавить первую тему"
                                                       VerticalAlignment="Center" />

                                            <materialDesign:PackIcon Kind="ArrowRight"
                                                                     Width="21"
                                                                     Height="21"
                                                                     Margin="14,0,0,0"
                                                                     VerticalAlignment="Center" />

                                        </StackPanel>

                                    </Button>

                                    <Button Grid.Column="2"
                                            Command="{Binding AddSectionCommand}"
                                            Style="{StaticResource Mnemora.SecondaryButton}">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon Kind="Plus"
                                                                     Width="20"
                                                                     Height="20"
                                                                     VerticalAlignment="Center" />

                                            <TextBlock Margin="10,0,0,0"
                                                       Text="Новый раздел"
                                                       VerticalAlignment="Center" />

                                        </StackPanel>

                                    </Button>

                                </Grid>

                            </Grid>

                        </Border>

                        <!-- Есть темы -->

                        <Border MinHeight="520"
                                Padding="36,32"
                                Background="{StaticResource Mnemora.Brush.Surface}"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTopics}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="64"
                                            Height="64"
                                            Background="#EEFFFC"
                                            CornerRadius="16">

                                        <materialDesign:PackIcon Kind="Bookshelf"
                                                                 Width="34"
                                                                 Height="34"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource Mnemora.Brush.PrimaryDark}" />

                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="18,0,0,0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="Библиотека начала наполняться"
                                                   Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />

                                        <TextBlock Margin="0,6,0,0"
                                                   Text="Следующий этап — добавление материалов"
                                                   Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                   FontSize="14" />

                                    </StackPanel>

                                </Grid>

                                <!-- Сводка -->

                                <Grid Grid.Row="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Padding="20"
                                            Background="{StaticResource Mnemora.Brush.SurfaceMuted}"
                                            BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="12">

                                        <StackPanel>

                                            <TextBlock Text="{Binding SectionsCount}"
                                                       Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                       FontSize="30"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Margin="0,5,0,0"
                                                       Text="Разделов"
                                                       Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                       FontSize="14" />

                                        </StackPanel>

                                    </Border>

                                    <Border Grid.Column="2"
                                            Padding="20"
                                            Background="{StaticResource Mnemora.Brush.SurfaceMuted}"
                                            BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="12">

                                        <StackPanel>

                                            <TextBlock Text="{Binding TopicsCount}"
                                                       Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                       FontSize="30"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Margin="0,5,0,0"
                                                       Text="Тем"
                                                       Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                                       FontSize="14" />

                                        </StackPanel>

                                    </Border>

                                </Grid>

                                <!-- Действия -->

                                <Grid Grid.Row="4">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Command="{Binding OpenLibraryCommand}"
                                            Style="{StaticResource Mnemora.PrimaryButton}">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="Открыть библиотеку"
                                                       VerticalAlignment="Center" />

                                            <materialDesign:PackIcon Kind="ArrowRight"
                                                                     Width="21"
                                                                     Height="21"
                                                                     Margin="14,0,0,0"
                                                                     VerticalAlignment="Center" />

                                        </StackPanel>

                                    </Button>

                                    <Button Grid.Column="2"
                                            Command="{Binding AddSectionCommand}"
                                            Style="{StaticResource Mnemora.SecondaryButton}">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon Kind="Plus"
                                                                     Width="20"
                                                                     Height="20"
                                                                     VerticalAlignment="Center" />

                                            <TextBlock Margin="10,0,0,0"
                                                       Text="Новый раздел"
                                                       VerticalAlignment="Center" />

                                        </StackPanel>

                                    </Button>

                                </Grid>

                            </Grid>

                        </Border>

                    </Grid>

                    <!-- Правая колонка -->

                    <Grid Grid.Column="2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Как устроена Mnemora -->

                        <Border Grid.Row="0"
                                Padding="26,22"
                                Background="{StaticResource Mnemora.Brush.OnboardingBackground}"
                                CornerRadius="12">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Как устроена Mnemora"
                                           Foreground="White"
                                           FontSize="21"
                                           FontWeight="SemiBold" />

                                <Grid Grid.Row="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Kind="FolderOpenOutline"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="{StaticResource Mnemora.Brush.Primary}"
                                                             VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="Раздел объединяет связанные темы"
                                               Foreground="White"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />

                                </Grid>

                                <Border Grid.Row="3"
                                        Margin="0,13"
                                        Background="#29406D" />

                                <Grid Grid.Row="4"
                                      Margin="0,8,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="#65A1FF"
                                                             VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="В теме хранятся статьи и вопросы"
                                               Foreground="White"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />

                                </Grid>

                                <Border Grid.Row="5"
                                        Margin="0,13"
                                        Background="#29406D" />

                                <Grid Grid.Row="6"
                                      Margin="0,8,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Kind="LinkVariant"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                             VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="У статьи могут быть связанные вопросы"
                                               Foreground="White"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />

                                </Grid>

                                <TextBlock Grid.Row="8"
                                           Text="Статья считается изученной после уверенных ответов на связанные вопросы"
                                           Foreground="#D6DDF2"
                                           FontSize="13"
                                           LineHeight="19"
                                           TextWrapping="Wrap" />

                            </Grid>

                        </Border>

                        <!-- Прогресс -->

                        <Border Grid.Row="2"
                                Padding="24,20"
                                Background="{StaticResource Mnemora.Brush.Surface}"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12">

                            <Border.Effect>
                                <DropShadowEffect Color="#061735"
                                                  BlurRadius="14"
                                                  ShadowDepth="2"
                                                  Opacity="0.06" />
                            </Border.Effect>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Мой прогресс"
                                           Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                           FontSize="20"
                                           FontWeight="SemiBold" />

                                <TextBlock Grid.Row="1"
                                           Margin="0,10,0,0"
                                           Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                           FontSize="31"
                                           FontWeight="SemiBold">

                                    <Run Text="{Binding ExperiencePoints, Mode=OneWay}" />
                                    <Run Text=" XP" />

                                </TextBlock>

                                <TextBlock Grid.Row="2"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                           FontSize="15"
                                           FontWeight="SemiBold">

                                    <Run Text="Уровень " />
                                    <Run Text="{Binding Level, Mode=OneWay}" />

                                </TextBlock>

                                <ProgressBar Grid.Row="4"
                                             Height="9"
                                             Minimum="0"
                                             Maximum="{Binding ExperienceForNextLevel, Mode=OneWay}"
                                             Value="{Binding CurrentLevelExperience, Mode=OneWay}"
                                             Background="#E9EBF6"
                                             Foreground="{StaticResource Mnemora.Brush.Primary}"
                                             BorderThickness="0" />

                                <TextBlock Grid.Row="5"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                           FontSize="13">

                                    <Run Text="{Binding CurrentLevelExperience, Mode=OneWay}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding ExperienceForNextLevel, Mode=OneWay}" />
                                    <Run Text=" до уровня " />
                                    <Run Text="{Binding NextLevel, Mode=OneWay}" />

                                </TextBlock>

                                <Grid Grid.Row="7">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            MinHeight="68"
                                            Padding="12"
                                            Background="#FAFAFE"
                                            BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="9">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Kind="Fire"
                                                                     Width="27"
                                                                     Height="27"
                                                                     Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                                     VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                       FontSize="12"
                                                       LineHeight="17"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap">

                                                <Run Text="{Binding StreakDays, Mode=OneWay}" />
                                                <Run Text=" дней" />
                                                <LineBreak />
                                                <Run Text="подряд" />

                                            </TextBlock>

                                        </Grid>

                                    </Border>

                                    <Border Grid.Column="2"
                                            MinHeight="68"
                                            Padding="12"
                                            Background="#FAFAFE"
                                            BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="9">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Kind="CreationOutline"
                                                                     Width="27"
                                                                     Height="27"
                                                                     Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                                     VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding AnswerSummary}"
                                                       Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />

                                        </Grid>

                                    </Border>

                                </Grid>

                            </Grid>

                        </Border>

                    </Grid>

                </Grid>

                <!-- Хранилище -->

                <Border Grid.Row="4"
                        Padding="22,17"
                        Background="{StaticResource Mnemora.Brush.Surface}"
                        BorderBrush="{StaticResource Mnemora.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="12">

                    <Border.Effect>
                        <DropShadowEffect Color="#061735"
                                          BlurRadius="12"
                                          ShadowDepth="2"
                                          Opacity="0.05" />
                    </Border.Effect>

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="54"
                                    Height="54"
                                    Background="#EEFFFC"
                                    BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                <materialDesign:PackIcon Kind="FolderCheckOutline"
                                                         Width="30"
                                                         Height="30"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource Mnemora.Brush.PrimaryDark}" />

                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Хранилище готово"
                                           Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />

                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding StoragePathDisplay, Mode=OneWay}"
                                           Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding StoragePath, Mode=OneWay}" />

                            </StackPanel>

                            <Button Grid.Column="4"
                                    Width="170"
                                    Command="{Binding OpenStorageFolderCommand}"
                                    Style="{StaticResource Mnemora.SecondaryButton}"
                                    BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                                    Foreground="{StaticResource Mnemora.Brush.PrimaryDark}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="Открыть папку"
                                               VerticalAlignment="Center" />

                                    <materialDesign:PackIcon Kind="FolderOpenOutline"
                                                             Width="20"
                                                             Height="20"
                                                             Margin="10,0,0,0"
                                                             VerticalAlignment="Center" />

                                </StackPanel>

                            </Button>

                        </Grid>

                        <Border Grid.Row="1"
                                Margin="70,12,190,0"
                                Padding="11,8"
                                Background="#FFF1F1"
                                CornerRadius="7">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStorageError}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="{Binding StorageErrorMessage, Mode=OneWay}"
                                       Foreground="#A52222"
                                       FontSize="12"
                                       TextWrapping="Wrap" />

                        </Border>

                    </Grid>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>