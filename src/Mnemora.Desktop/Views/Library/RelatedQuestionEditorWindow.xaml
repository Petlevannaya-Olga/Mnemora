<Window
    x:Class="Mnemora.Desktop.Views.Library.RelatedQuestionEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="1000"
    MinWidth="960"
    MaxHeight="920"
    SizeToContent="Height"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    PreviewKeyDown="Window_OnPreviewKeyDown">

    <Window.Resources>
        <!-- Компактное числовое поле XP: без внутреннего padding MaterialDesign,
             из-за которого двузначные значения визуально обрезались. -->
        <Style x:Key="RelatedQuestionXpTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="XpBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter
                                    TargetName="XpBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Mnemora.Brush.Secondary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border
            Margin="1"
            Background="{DynamicResource Mnemora.Brush.Surface}"
            CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="28"
                    Color="#061735"
                    Opacity="0.28"
                    ShadowDepth="7" />
            </Border.Effect>
        </Border>

        <Border
            Padding="24,20,24,18"
            Background="{DynamicResource Mnemora.Brush.Surface}"
            BorderBrush="{DynamicResource Mnemora.Brush.Border}"
            BorderThickness="1"
            CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            FontSize="23"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                            Text="{Binding RelatedQuestionEditorTitle}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                            Text="Вопрос будет создан только после финального подтверждения материала."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Margin="12,-4,-4,0"
                        VerticalAlignment="Top"
                        Click="Cancel_OnClick"
                        Style="{StaticResource Mnemora.DialogCloseButton}"
                        ToolTip="Закрыть">
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Kind="Close" />
                    </Button>
                </Grid>

                <!-- Main content: окно подстраивает высоту под содержимое. -->
                <StackPanel Grid.Row="1" Margin="0,14,0,12">
                    <!-- Иконка → сложность → название -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Width="48"
                            Height="48"
                            Padding="0"
                            Background="{DynamicResource Mnemora.Brush.SurfaceMuted}"
                            BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                            BorderThickness="1"
                            Command="{Binding OpenRelatedQuestionIconPickerCommand}"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="Выбрать иконку">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="IconButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12">
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter
                                                TargetName="IconButtonBorder"
                                                Property="BorderBrush"
                                                Value="{DynamicResource Mnemora.Brush.Secondary}" />
                                            <Setter
                                                TargetName="IconButtonBorder"
                                                Property="Background"
                                                Value="#F7F5FF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter
                                                TargetName="IconButtonBorder"
                                                Property="Background"
                                                Value="#F1EDFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <materialDesign:PackIcon
                                Width="25"
                                Height="25"
                                Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                Kind="{Binding RelatedQuestionIconKind}" />
                        </Button>

                        <ComboBox
                            Grid.Column="2"
                            Height="48"
                            ItemsSource="{Binding RelatedQuestionDifficultyOptions}"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding RelatedQuestionDifficulty, Mode=TwoWay}"
                            VerticalContentAlignment="Center"
                            materialDesign:HintAssist.Hint="Сложность"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                        <TextBox
                            Grid.Column="4"
                            Height="48"
                            VerticalContentAlignment="Center"
                            Text="{Binding RelatedQuestionTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="Название вопроса"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    </Grid>

                    <!-- Содержимое -->
                    <TextBlock
                        Margin="2,13,0,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="СОДЕРЖИМОЕ" />

                    <TextBlock
                        Margin="2,0,0,5"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="Текст вопроса" />

                    <!-- Текст вопроса: тот же паттерн, что в основном мастере -->
                    <Grid Height="112">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="32*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Column="0"
                            Tag="Prompt"
                            AllowDrop="True"
                            Background="Transparent"
                            Cursor="Hand"
                            DragOver="MarkdownDropZone_OnDragOver"
                            Drop="MarkdownDropZone_OnDrop"
                            MouseLeftButtonUp="MarkdownDropZone_OnMouseLeftButtonUp">
                            <Rectangle
                                Margin="1"
                                RadiusX="14"
                                RadiusY="14"
                                Fill="{DynamicResource Mnemora.Brush.SurfaceMuted}"
                                Stroke="{DynamicResource Mnemora.Brush.Border}"
                                StrokeThickness="1.2"
                                StrokeDashArray="5,4" />

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRelatedQuestionPromptConfigured}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon
                                    Width="21"
                                    Height="21"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                    Kind="FileUploadOutline" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                    Text="Перетащи Markdown-файл сюда" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                    Text="или нажми, чтобы выбрать · только .md" />
                            </StackPanel>

                            <Grid Margin="16,8,40,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRelatedQuestionPromptConfigured}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Mnemora.Brush.Surface}"
                                    BorderBrush="{DynamicResource Mnemora.Brush.Secondary}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                        Kind="FileDocumentOutline" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                        Text="{Binding RelatedQuestionPromptFileName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                        Text="Нажми на карточку, чтобы выбрать другой файл" />
                                </StackPanel>

                                <Button
                                    Grid.Column="4"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Tag="Prompt"
                                    Click="OpenMarkdown_OnClick"
                                    Style="{StaticResource Mnemora.SecondaryButton}"
                                    ToolTip="Открыть в редакторе">
                                    <materialDesign:PackIcon
                                        Width="17"
                                        Height="17"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Kind="OpenInNew" />
                                </Button>
                            </Grid>

                            <Button
                                Width="28"
                                Height="28"
                                Margin="0,7,7,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Tag="Prompt"
                                Click="ClearMarkdown_OnClick"
                                Panel.ZIndex="20"
                                ToolTip="Сбросить выбранный файл">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource Mnemora.DialogCloseButton}" TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRelatedQuestionPromptConfigured}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Width="14" Height="14" Kind="Close" />
                            </Button>
                        </Grid>

                        <Button
                            Grid.Column="2"
                            Height="112"
                            Padding="12"
                            Tag="Prompt"
                            Click="CreateMarkdownTemplate_OnClick"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Style="{StaticResource Mnemora.SecondaryButton}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon
                                    Width="21"
                                    Height="21"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                    Kind="FileDocumentPlusOutline" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="Создать по шаблону" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                    Text="Новый question.md" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock
                        Margin="2,10,0,6"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="Эталонный ответ" />

                    <!-- Эталонный ответ -->
                    <Grid Height="112">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="32*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Column="0"
                            Tag="Answer"
                            AllowDrop="True"
                            Background="Transparent"
                            Cursor="Hand"
                            DragOver="MarkdownDropZone_OnDragOver"
                            Drop="MarkdownDropZone_OnDrop"
                            MouseLeftButtonUp="MarkdownDropZone_OnMouseLeftButtonUp">
                            <Rectangle
                                Margin="1"
                                RadiusX="14"
                                RadiusY="14"
                                Fill="{DynamicResource Mnemora.Brush.SurfaceMuted}"
                                Stroke="{DynamicResource Mnemora.Brush.Border}"
                                StrokeThickness="1.2"
                                StrokeDashArray="5,4" />

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRelatedQuestionAnswerConfigured}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon
                                    Width="21"
                                    Height="21"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                    Kind="FileUploadOutline" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                    Text="Перетащи Markdown-файл сюда" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                    Text="или нажми, чтобы выбрать · только .md" />
                            </StackPanel>

                            <Grid Margin="16,8,40,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRelatedQuestionAnswerConfigured}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Mnemora.Brush.Surface}"
                                    BorderBrush="{DynamicResource Mnemora.Brush.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                        Kind="FileDocumentOutline" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                        Text="{Binding RelatedQuestionAnswerFileName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                        Text="Нажми на карточку, чтобы выбрать другой файл" />
                                </StackPanel>

                                <Button
                                    Grid.Column="4"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Tag="Answer"
                                    Click="OpenMarkdown_OnClick"
                                    Style="{StaticResource Mnemora.SecondaryButton}"
                                    ToolTip="Открыть в редакторе">
                                    <materialDesign:PackIcon
                                        Width="17"
                                        Height="17"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Kind="OpenInNew" />
                                </Button>
                            </Grid>

                            <Button
                                Width="28"
                                Height="28"
                                Margin="0,7,7,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Tag="Answer"
                                Click="ClearMarkdown_OnClick"
                                Panel.ZIndex="20"
                                ToolTip="Сбросить выбранный файл">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource Mnemora.DialogCloseButton}" TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRelatedQuestionAnswerConfigured}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Width="14" Height="14" Kind="Close" />
                            </Button>
                        </Grid>

                        <Button
                            Grid.Column="2"
                            Height="112"
                            Padding="12"
                            Tag="Answer"
                            Click="CreateMarkdownTemplate_OnClick"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Style="{StaticResource Mnemora.SecondaryButton}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon
                                    Width="21"
                                    Height="21"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                    Kind="FileDocumentPlusOutline" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="Создать по шаблону" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                    Text="Новый answer.md" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- XP -->
                    <TextBlock
                        Margin="2,13,0,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="НАГРАДЫ ЗА ОБУЧЕНИЕ" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            MinHeight="104"
                            Padding="14,10"
                            Background="{DynamicResource Mnemora.Brush.SurfaceMuted}"
                            CornerRadius="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="9" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" Background="#E8FAF7" CornerRadius="9">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Mnemora.Brush.Primary}"
                                            Kind="CheckCircleOutline" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                            Text="Первичное изучение" />
                                        <TextBlock
                                            Margin="0,1,0,0"
                                            FontSize="10"
                                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                            Text="За первое завершение вопроса" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        VerticalAlignment="Center"
                                        Minimum="5"
                                        Maximum="100"
                                        TickFrequency="5"
                                        SmallChange="5"
                                        LargeChange="10"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding RelatedQuestionStudyPoints, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Text="{Binding RelatedQuestionStudyPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource RelatedQuestionXpTextBoxStyle}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                        Text="XP" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,1,79,0">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        FontSize="9"
                                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                        Text="5" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="9"
                                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                        Text="100" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="2"
                            MinHeight="104"
                            Padding="14,10"
                            Background="{DynamicResource Mnemora.Brush.SurfaceMuted}"
                            CornerRadius="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="9" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" Background="#F1EDFF" CornerRadius="9">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                            Kind="Refresh" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                            Text="Повторение" />
                                        <TextBlock
                                            Margin="0,1,0,0"
                                            FontSize="10"
                                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                            Text="За последующие повторения" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        VerticalAlignment="Center"
                                        Minimum="5"
                                        Maximum="{Binding RelatedQuestionReviewMaximum}"
                                        TickFrequency="5"
                                        SmallChange="5"
                                        LargeChange="10"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding RelatedQuestionReviewPoints, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Text="{Binding RelatedQuestionReviewPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource RelatedQuestionXpTextBoxStyle}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                        Text="XP" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,1,79,0">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        FontSize="9"
                                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                        Text="5" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="9"
                                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                        Text="{Binding RelatedQuestionReviewMaximum, StringFormat=до {0}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Только операционные ошибки. Валидация формы заранее не показывается. -->
                    <Border
                        Margin="0,10,0,0"
                        Padding="11,8"
                        Background="#FFF2F2"
                        BorderBrush="#F4D2D2"
                        BorderThickness="1"
                        CornerRadius="9">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelatedQuestionEditorError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelatedQuestionEditorError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontSize="11"
                            Foreground="#B42318"
                            Text="{Binding RelatedQuestionEditorError}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Height="44"
                        HorizontalAlignment="Left"
                        Click="Cancel_OnClick"
                        Style="{StaticResource Mnemora.SecondaryButton}"
                        Content="Отмена" />

                    <Button
                        Grid.Column="2"
                        MinWidth="176"
                        Height="44"
                        IsEnabled="{Binding CanSaveRelatedQuestion}"
                        Click="Save_OnClick"
                        Style="{StaticResource Mnemora.PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Kind="Check" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding RelatedQuestionEditorActionText}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
