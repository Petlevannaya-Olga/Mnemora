<Window
    x:Class="Mnemora.Desktop.Views.Library.LibraryOrderDialogWindow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="900"
    Height="640"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Те же базовые стили строк и ячеек, что используются в таблицах управления. -->
        <Style x:Key="OrderGridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource Mnemora.Brush.TextSecondary}" />
        </Style>

        <Style
            x:Key="OrderGridNumberStyle"
            BasedOn="{StaticResource OrderGridTextStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OrderGridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Grid>
                            <Border
                                x:Name="RowBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                                BorderThickness="0,0,0,1" />

                            <Border
                                x:Name="SelectionIndicator"
                                Width="4"
                                Margin="0,7,0,7"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Mnemora.Brush.Primary}"
                                CornerRadius="0,3,3,0"
                                Visibility="Collapsed" />

                            <DataGridCellsPresenter />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#F4F8FC" />
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#E8F9F6" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrderGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="OrderGridHandleCellStyle"
            BasedOn="{StaticResource OrderGridCellStyle}"
            TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,5,4,5" />
        </Style>

        <Style
            x:Key="OrderGridPositionCellStyle"
            BasedOn="{StaticResource OrderGridCellStyle}"
            TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5,14,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <!-- Тень отдельным слоем, чтобы не размывать содержимое. -->
        <Border Margin="1"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="28"
                    Color="#061735"
                    Opacity="0.30"
                    ShadowDepth="7" />
            </Border.Effect>
        </Border>

        <Border Padding="28,22,28,24"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="50"
                            Height="50"
                            Background="#F2EEFF"
                            CornerRadius="13">
                        <materialDesign:PackIcon
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                            Kind="SwapVertical" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="16,0"
                                VerticalAlignment="Center">
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                            Text="{Binding DialogTitle}" />

                        <StackPanel Margin="0,4,0,0"
                                    Orientation="Horizontal">
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                Text="Перетащите строки — линия покажет точное место вставки" />

                            <TextBlock
                                Margin="10,0,0,0"
                                FontSize="13"
                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                Text="{Binding ContextText}"
                                Visibility="{Binding HasContext, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Click="Cancel_OnClick"
                            Style="{StaticResource Mnemora.DialogCloseButton}">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Kind="Close" />
                    </Button>
                </Grid>

                <!-- Таблица порядка -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Mnemora.Brush.Surface}"
                        BorderThickness="0"
                        ClipToBounds="True"
                        CornerRadius="12">
                    <Grid>
                        <!-- Таблица уходит на 1 px внутрь и не участвует в отрисовке рамки. -->
                        <Grid Margin="1">
                            <AdornerDecorator>
                            <DataGrid
                            x:Name="OrderGrid"
                            ItemsSource="{Binding Items}"
                            AllowDrop="True"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserResizeRows="False"
                            CanUserSortColumns="False"
                            CellStyle="{StaticResource OrderGridCellStyle}"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            GridLinesVisibility="None"
                            HeadersVisibility="None"
                            ColumnHeaderHeight="0"
                            IsReadOnly="True"
                            PreviewMouseLeftButtonDown="OrderGrid_OnPreviewMouseLeftButtonDown"
                            PreviewMouseMove="OrderGrid_OnPreviewMouseMove"
                            DragOver="OrderGrid_OnDragOver"
                            DragLeave="OrderGrid_OnDragLeave"
                            Drop="OrderGrid_OnDrop"
                            RowHeaderWidth="0"
                            RowStyle="{StaticResource OrderGridRowStyle}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="48"
                                    CellStyle="{StaticResource OrderGridHandleCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                                Tag="DragHandle"
                                                Cursor="SizeAll"
                                                Background="Transparent"
                                                ToolTip="Перетащить">
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                    Kind="DragVertical" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" MinWidth="420">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="36"
                                                    Height="36"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="#F2EEFF"
                                                    BorderBrush="#E5DEFF"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                    <materialDesign:PackIcon
                                                        Width="20"
                                                        Height="20"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                        Kind="{Binding IconKind}" />
                                                </Border>

                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Номер позиции остаётся справа, но без отдельной шапки. -->
                                <DataGridTemplateColumn
                                    Width="72"
                                    CellStyle="{StaticResource OrderGridPositionCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Style="{StaticResource OrderGridNumberStyle}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="{Binding Position}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            </DataGrid>
                            </AdornerDecorator>
                        </Grid>

                        <!-- Отдельный stroke поверх DataGrid даёт непрерывную дугу в углах.
                             Rectangle здесь надёжнее Border: дочерний ScrollViewer не может перекрыть рамку. -->
                        <Rectangle
                            Margin="0.5"
                            Panel.ZIndex="200"
                            Fill="Transparent"
                            IsHitTestVisible="False"
                            RadiusX="12"
                            RadiusY="12"
                            SnapsToDevicePixels="False"
                            Stroke="{DynamicResource Mnemora.Brush.Border}"
                            StrokeThickness="1" />
                    </Grid>
                </Border>

                <!-- Зачем нужен пользовательский порядок -->
                <Border Grid.Row="4"
                        Padding="13,9"
                        Background="#FAF9FF"
                        BorderBrush="#E5DEFF"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon
                            Width="19"
                            Height="19"
                            Margin="0,2,10,0"
                            Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                            Kind="InformationOutline" />

                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource Mnemora.Brush.TextPrimary}">
                                <Run
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                    Text="Мой порядок" />
                                <Run Text=" — ваш персональный порядок отображения разделов, тем и материалов." />
                            </TextBlock>

                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                Text="Этот порядок будет использоваться в библиотеке и в фильтре «Мой порядок»." />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Кнопки -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="UnsavedChangesText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="Есть несохранённые изменения"
                        Visibility="Collapsed" />

                    <Button
                        Grid.Column="1"
                        MinWidth="116"
                        Height="42"
                        Click="Cancel_OnClick"
                        Content="Отмена"
                        Style="{StaticResource Mnemora.SecondaryButton}" />

                    <Button
                        x:Name="SaveButton"
                        Grid.Column="3"
                        MinWidth="174"
                        Height="42"
                        Click="Save_OnClick"
                        IsEnabled="False"
                        IsDefault="True"
                        Style="{StaticResource Mnemora.PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Kind="ContentSaveOutline" />
                            <TextBlock
                                Margin="9,0,0,0"
                                VerticalAlignment="Center"
                                Text="Сохранить порядок" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
