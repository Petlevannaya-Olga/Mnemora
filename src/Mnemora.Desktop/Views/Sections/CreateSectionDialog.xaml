<Window
    x:Class="Mnemora.Desktop.Views.Sections.CreateSectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Новый раздел"
    Width="520"
    SizeToContent="Height"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Window.InputBindings>

        <KeyBinding
            Key="Escape"
            Command="{Binding CancelCommand}" />

    </Window.InputBindings>

    <Grid Margin="22">

        <Border
            Background="{StaticResource Mnemora.Brush.Surface}"
            CornerRadius="18">

            <Border.Effect>

                <DropShadowEffect
                    Color="#061735"
                    BlurRadius="26"
                    ShadowDepth="7"
                    Opacity="0.28" />

            </Border.Effect>

            <Grid Margin="30,26">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="48"
                        Height="48"
                        Background="#EEFFFC"
                        CornerRadius="12">

                        <materialDesign:PackIcon
                            Kind="FolderPlusOutline"
                            Width="27"
                            Height="27"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Mnemora.Brush.PrimaryDark}" />

                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Margin="15,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Новый раздел"
                            Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                            FontSize="21"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Объедините связанные темы в одном месте"
                            Margin="0,3,0,0"
                            Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                            FontSize="13" />

                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Command="{Binding CancelCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}">

                        <materialDesign:PackIcon
                            Kind="Close"
                            Width="20"
                            Height="20"
                            Foreground="{StaticResource Mnemora.Brush.TextSecondary}" />

                    </Button>

                </Grid>

                <!-- Подсказка -->

                <TextBlock
                    Grid.Row="1"
                    Margin="0,22,0,0"
                    Text="Название должно описывать крупную область знаний, например Backend или Базы данных."
                    Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                    FontSize="13"
                    LineHeight="19"
                    TextWrapping="Wrap" />

                <!-- Название -->

                <TextBox
                    x:Name="NameTextBox"
                    Grid.Row="3"
                    MaxLength="150"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    materialDesign:HintAssist.Hint="Название раздела"
                    materialDesign:TextFieldAssist.HasClearButton="True" />

                <!-- Ошибка -->

                <Border
                    Grid.Row="4"
                    Margin="0,12,0,0"
                    Padding="12,9"
                    Background="#FFF1F1"
                    CornerRadius="8">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter Property="Visibility" Value="Collapsed" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding HasError}"
                                    Value="True">

                                    <Setter Property="Visibility" Value="Visible" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon
                            Kind="AlertCircleOutline"
                            Width="19"
                            Height="19"
                            Foreground="#C62828"
                            VerticalAlignment="Top" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="9,0,0,0"
                            Text="{Binding ErrorMessage, Mode=OneWay}"
                            Foreground="#A52222"
                            FontSize="13"
                            TextWrapping="Wrap" />

                    </Grid>

                </Border>

                <!-- Кнопки -->

                <Grid Grid.Row="6">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Content="Отмена"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Mnemora.SecondaryButton}" />

                    <Button
                        Grid.Column="2"
                        Command="{Binding CreateCommand}"
                        Style="{StaticResource Mnemora.PrimaryButton}"
                        IsDefault="True">

                        <TextBlock>

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter
                                        Property="Text"
                                        Value="Создать раздел" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsCreating}"
                                            Value="True">

                                            <Setter
                                                Property="Text"
                                                Value="Создаём..." />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Button>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>