<Window x:Class="Mnemora.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loading="clr-namespace:Mnemora.Desktop.Controls.Loading"
        Title="Mnemora - место, где знания остаются с тобой"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/Images/Mnemora.ico"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}" />

        <!-- Оболочка показывается до первого render AppShellView.
             Меню имеет стабильную форму, а содержимое страниц заменяет
             универсальный индикатор, не зависящий от выбранного экрана. -->
        <Grid Panel.ZIndex="50"
              Background="{StaticResource Mnemora.Brush.SurfaceMuted}"
              IsHitTestVisible="True">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInitializing}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Боковая панель -->
            <Border Grid.Column="0"
                    Background="{StaticResource Mnemora.Brush.SidebarBackground}">
                <StackPanel Margin="28,30">
                    <StackPanel Margin="0,0,0,30"
                                Orientation="Horizontal">
                        <Border Width="42"
                                Height="42"
                                Background="#245A84"
                                CornerRadius="21" />
                        <Border Width="108"
                                Height="22"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="#365477"
                                CornerRadius="6" />
                    </StackPanel>

                    <Border Height="42" Margin="0,0,0,12" Background="#244767" CornerRadius="9" />
                    <Border Height="42" Margin="0,0,0,12" Background="#1B3858" CornerRadius="9" />
                    <Border Height="42" Margin="0,0,0,12" Background="#1B3858" CornerRadius="9" />
                    <Border Height="42" Margin="0,0,0,12" Background="#1B3858" CornerRadius="9" />
                    <Border Height="42" Margin="0,0,0,12" Background="#1B3858" CornerRadius="9" />
                    <Border Height="42" Background="#1B3858" CornerRadius="9" />
                </StackPanel>
            </Border>

            <!-- Рабочая область -->
            <loading:LoadingIndicator
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IndicatorLength="420"
                IndicatorThickness="10"
                Message="Открываем Mnemora..." />
        </Grid>

        <Border x:Name="DialogOverlay"
                Panel.ZIndex="100"
                Background="#A0061735"
                IsHitTestVisible="True"
                Opacity="0"
                Visibility="Collapsed" />
    </Grid>

</Window>
