<Window x:Class="Mnemora.Desktop.Views.Startup.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loading="clr-namespace:Mnemora.Desktop.Controls.Loading"
        Title="Mnemora"
        Width="620"
        Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True">
    <Border CornerRadius="22" BorderBrush="#273B60" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#061735" />
                <GradientStop Offset="0.56" Color="#0A2144" />
                <GradientStop Offset="1" Color="#151B45" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="42,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Width="250"
                   Height="70"
                   HorizontalAlignment="Center"
                   Source="pack://application:,,,/Assets/Images/MnemoraLogo.png"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Grid Grid.Row="1" Margin="0,26,0,22">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="{Binding Title}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <loading:LoadingIndicator
                        Margin="0,30,0,0"
                        IndicatorLength="440"
                        IndicatorThickness="10"
                        IsIndeterminate="False"
                        Maximum="100"
                        Message="{Binding Details}"
                        MessageForeground="#AEBBD1"
                        PercentageForeground="#16CDB7"
                        ShowPercentage="True"
                        TrackBrush="#263C60"
                        Value="{Binding Progress, Mode=OneWay}" />
                </StackPanel>

                <Border Padding="24,20"
                        MaxWidth="500"
                        MinHeight="118"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#B5162A4C"
                        BorderBrush="#40577A"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <Border Width="34"
                                Height="34"
                                HorizontalAlignment="Center"
                                Background="#24FFB4A8"
                                BorderBrush="#D9897C"
                                BorderThickness="1"
                                CornerRadius="17">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#FFD0C8"
                                       Text="!" />
                        </Border>

                        <TextBlock Margin="0,12,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#F2F5FA"
                                   Text="{Binding ErrorMessage}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,7,0,0"
                                   FontSize="12"
                                   Foreground="#AEBBD1"
                                   Text="{Binding ErrorHint}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button Width="92"
                        Height="42"
                        Command="{Binding CloseCommand}"
                        Content="Закрыть"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#AEBBD1"
                        Cursor="Hand" />

                <Button Width="{Binding ErrorActionButtonWidth}"
                        Height="42"
                        Margin="10,0,0,0"
                        Command="{Binding RetryCommand}"
                        Content="{Binding ErrorActionText}"
                        Background="Transparent"
                        BorderBrush="#536681"
                        BorderThickness="1"
                        Foreground="#DCE4F1"
                        Cursor="Hand" />

                <Button Width="232"
                        Height="42"
                        Margin="12,0,0,0"
                        Padding="18,0"
                        FontSize="16"
                        Command="{Binding OpenOnboardingCommand}"
                        Content="Изменить настройки"
                        Style="{StaticResource Mnemora.PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
