<UserControl x:Class="Mnemora.Desktop.Views.Onboarding.StorageSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignWidth="1600"
             d:DesignHeight="900"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Основная кнопка -->

        <Style x:Key="OnboardingPrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="52" />
            <Setter Property="MinWidth"
                    Value="230" />
            <Setter Property="Padding"
                    Value="26,0" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{StaticResource Mnemora.Brush.BrandGradient}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Контурная кнопка -->

        <Style x:Key="OnboardingOutlineButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="52" />
            <Setter Property="Padding"
                    Value="20,0" />
            <Setter Property="Foreground"
                    Value="{StaticResource Mnemora.Brush.PrimaryDark}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource Mnemora.Brush.Primary}" />
            <Setter Property="BorderThickness"
                    Value="1.5" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F0FFFC" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле с путём -->

        <Style x:Key="StoragePathTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="52" />
            <Setter Property="Padding"
                    Value="16,0" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="FontSize"
                    Value="17" />
            <Setter Property="Foreground"
                    Value="{StaticResource Mnemora.Brush.TextPrimary}" />
            <Setter Property="Background"
                    Value="{StaticResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness"
                    Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource Mnemora.Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnboardingInactiveStepStyle"
               TargetType="Border">
            <Setter Property="Width"
                    Value="40" />
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="CornerRadius"
                    Value="20" />
            <Setter Property="BorderBrush"
                    Value="#53618C" />
            <Setter Property="BorderThickness"
                    Value="2" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource Mnemora.Brush.OnboardingBackground}"
          ClipToBounds="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Логотип -->

        <Image Grid.Row="0"
               Source="pack://application:,,,/Assets/Images/MnemoraLogo.png"
               Width="360"
               Height="90"
               Margin="28,12,28,10"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True" />

        <!-- Шаги онбординга -->

        <Grid Grid.Row="1"
              MaxWidth="720"
              Margin="24,0,24,0"
              HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>

            <!-- Шаг 1 завершён -->

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CheckBold"
                                         Width="18"
                                         Height="18"
                                         Foreground="{StaticResource Mnemora.Brush.Primary}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Height="3"
                    Margin="4,0"
                    Background="{StaticResource Mnemora.Brush.Primary}"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <!-- Шаг 2 активен -->

            <Border Grid.Row="0"
                    Grid.Column="2"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    BorderBrush="{StaticResource Mnemora.Brush.Primary}"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <TextBlock Text="2"
                           Foreground="{StaticResource Mnemora.Brush.Primary}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="3"
                    Height="3"
                    Margin="4,0"
                    Background="#53618C"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <!-- Шаги 3 и 4 неактивны -->

            <Border Grid.Row="0"
                    Grid.Column="4"
                    Style="{StaticResource OnboardingInactiveStepStyle}">
                <TextBlock Text="3"
                           Foreground="#D5DAED"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <Border Grid.Row="0"
                    Grid.Column="5"
                    Height="3"
                    Margin="4,0"
                    Background="#53618C"
                    CornerRadius="2"
                    VerticalAlignment="Center" />

            <Border Grid.Row="0"
                    Grid.Column="6"
                    Style="{StaticResource OnboardingInactiveStepStyle}">
                <TextBlock Text="4"
                           Foreground="#D5DAED"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Профиль"
                       Foreground="#C9CFE3"
                       FontSize="14"
                       TextAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Grid.Column="2"
                       Text="Хранилище"
                       Foreground="{StaticResource Mnemora.Brush.Primary}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Grid.Column="4"
                       Text="ИИ"
                       Foreground="#C9CFE3"
                       FontSize="14"
                       TextAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Grid.Column="6"
                       Text="Начало"
                       Foreground="#C9CFE3"
                       FontSize="14"
                       TextAlignment="Center" />

        </Grid>

        <!-- Карточка и номер шага -->

        <Grid Grid.Row="2">

            <StackPanel Margin="0,46,0,0"
                        VerticalAlignment="Top">

                <Border Height="420"
                        MaxWidth="720"
                        Margin="48,0"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource Mnemora.Brush.Surface}"
                        CornerRadius="22">

                    <Border.Effect>
                        <DropShadowEffect Color="#020A20"
                                          BlurRadius="28"
                                          ShadowDepth="8"
                                          Opacity="0.34" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Содержимое карточки -->

                        <Grid Grid.Row="0"
                              Margin="56,30,56,14">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Иконка -->

                            <Grid Grid.Row="0"
                                  Width="82"
                                  Height="82"
                                  HorizontalAlignment="Center">
                                <Ellipse Fill="{StaticResource Mnemora.Brush.SurfaceMuted}"
                                         Stroke="{StaticResource Mnemora.Brush.BrandGradient}"
                                         StrokeThickness="3" />
                                <materialDesign:PackIcon Kind="FolderOutline"
                                                         Width="42"
                                                         Height="42"
                                                         Foreground="{StaticResource Mnemora.Brush.BrandGradient}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Grid>

                            <!-- Заголовок -->

                            <StackPanel Grid.Row="1"
                                        Margin="0,20,0,12">
                                <TextBlock Text="Выберите хранилище"
                                           Foreground="{StaticResource Mnemora.Brush.TextPrimary}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           TextAlignment="Center" />
                                <TextBlock Text="Здесь будут храниться Markdown-файлы и вложения"
                                           Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                           FontSize="16"
                                           TextAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Выбор папки -->

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="1" Margin="0 12 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding StoragePath, Mode=OneWay}"
                                             Style="{StaticResource StoragePathTextBoxStyle}"
                                             IsReadOnly="True" />

                                    <Button Grid.Column="2"
                                            Command="{Binding SelectFolderCommand}"
                                            Style="{StaticResource OnboardingOutlineButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderOpenOutline"
                                                                     Width="22"
                                                                     Height="22"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="Выбрать"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- Статус папки -->

                            <!-- Примечания -->

                            <StackPanel Grid.Row="3"
                                        Margin="8,10,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Database"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="Системные данные и прогресс Mnemora сохранятся автоматически"
                                               Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,7,0,0">
                                    <materialDesign:PackIcon Kind="ShieldLock"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="{StaticResource Mnemora.Brush.Secondary}"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="Все материалы остаются на вашем устройстве"
                                               Foreground="{StaticResource Mnemora.Brush.TextSecondary}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                        </Grid>

                        <!-- Нижняя панель -->

                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource Mnemora.Brush.Border}"
                                BorderThickness="0,1,0,0"
                                Padding="42,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="120"
                                        Command="{Binding BackCommand}"
                                        Style="{StaticResource OnboardingOutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ArrowLeft"
                                                                 Width="21"
                                                                 Height="21"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="Назад"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Command="{Binding ContinueCommand}"
                                        Style="{StaticResource OnboardingPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Продолжить" />
                                        <materialDesign:PackIcon Kind="ArrowRight"
                                                                 Width="21"
                                                                 Height="21"
                                                                 Margin="18,0,0,0"
                                                                 VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                    </Grid>

                </Border>

                <TextBlock Text="Шаг 2 из 4"
                           Foreground="White"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0" />

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
