<UserControl
    x:Class="Mnemora.Desktop.Views.Library.LibraryOverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Mnemora.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="LibraryOverviewView_OnLoaded"
    Unloaded="LibraryOverviewView_OnUnloaded"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <converters:SectionColorConverter x:Key="SectionColorConverter" />
        <converters:SectionIconConverter x:Key="SectionIconConverter" />

        <Style x:Key="SectionOverviewCardStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="198" />
            <Setter Property="Margin" Value="0,0,18,18" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{DynamicResource Mnemora.Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mnemora.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Mnemora.Brush.SurfaceMuted}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->

        <StackPanel Margin="32,28,32,22">
            <TextBlock Style="{StaticResource Mnemora.Heading}" Text="Библиотека" />

            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource Mnemora.Description}"
                Text="Разделы базы знаний" />
        </StackPanel>

        <!-- Поиск и сортировка -->

        <Grid Grid.Row="1" Margin="32,0,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <TextBox
                Height="52"
                VerticalContentAlignment="Center"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                materialDesign:HintAssist.Hint="Поиск по разделам..."
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            <ComboBox
                Grid.Column="2"
                Height="52"
                VerticalContentAlignment="Center"
                DisplayMemberPath="Name"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSortOption}"
                materialDesign:HintAssist.Hint="Сортировка"
                Style="{StaticResource MaterialDesignOutlinedComboBox}" />
        </Grid>

        <!-- Содержимое -->

        <Grid Grid.Row="2" Margin="32,0,32,28">

            <!-- Загрузка -->

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ProgressBar
                    Width="220"
                    Height="4"
                    Foreground="{DynamicResource Mnemora.Brush.Primary}"
                    IsIndeterminate="True" />

                <TextBlock
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Text="Загружаем библиотеку..." />
            </StackPanel>

            <!-- Ошибка -->

            <Border
                Width="480"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="16">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasError}" Value="True" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>

                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <materialDesign:PackIcon
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                        Kind="AlertCircleOutline" />

                    <TextBlock
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="Не удалось загрузить библиотеку" />

                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="{Binding ErrorMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ReloadCommand}"
                        Content="Попробовать снова"
                        Style="{StaticResource Mnemora.SecondaryButton}" />
                </StackPanel>
            </Border>

            <!-- Нет разделов -->

            <Border
                Padding="48"
                Background="{DynamicResource Mnemora.Brush.Surface}"
                BorderBrush="{DynamicResource Mnemora.Brush.Border}"
                BorderThickness="1"
                CornerRadius="16">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon
                        Width="68"
                        Height="68"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.Primary}"
                        Kind="FolderOutline" />

                    <TextBlock
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="Разделов пока нет" />

                    <TextBlock
                        Margin="0,9,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                        Text="Создать первый раздел можно в управлении библиотекой." />
                </StackPanel>
            </Border>

            <!-- Поиск ничего не нашёл -->

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoSearchResults}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <materialDesign:PackIcon
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Kind="Magnify" />

                <TextBlock
                    Margin="0,18,0,0"
                    FontSize="21"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                    Text="Разделы не найдены" />

                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                    Text="Попробуйте изменить поисковый запрос." />
            </StackPanel>

            <!-- Разделы -->

            <ScrollViewer
                x:Name="SectionsScrollViewer"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasSections}" Value="True" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding HasError}" Value="False" />
                                </MultiDataTrigger.Conditions>

                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,18"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                        Text="Разделы" />

                    <ItemsControl
                        Width="{Binding ViewportWidth, ElementName=SectionsScrollViewer}"
                        ItemsSource="{Binding Sections}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SectionOverviewCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Иконка, название и план -->

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="54"
                                                Height="54"
                                                Background="{Binding Color, Converter={StaticResource SectionColorConverter}}"
                                                CornerRadius="13">

                                                <materialDesign:PackIcon
                                                    Width="29"
                                                    Height="29"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Kind="{Binding Icon, Converter={StaticResource SectionIconConverter}}" />
                                            </Border>

                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="16,0,12,0"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />

                                            <Border
                                                Grid.Column="2"
                                                Padding="10,5"
                                                VerticalAlignment="Top"
                                                Background="#E6FBF8"
                                                CornerRadius="7"
                                                Visibility="{Binding HasPlannedMaterials, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                d:Visibility="Visible">

                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Mnemora.Brush.PrimaryDark}"
                                                    Text="{Binding PlannedText}"
                                                    d:Text="3 в плане" />
                                            </Border>
                                        </Grid>

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,16,0,0"
                                            FontSize="14"
                                            Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                            Text="{Binding StructureText}" />

                                        <!-- Прогресс -->

                                        <StackPanel
                                            Grid.Row="2"
                                            Margin="0,15,0,0"
                                            Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            d:Visibility="Visible">

                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource Mnemora.Brush.TextPrimary}"
                                                Text="{Binding ProgressText}"
                                                d:Text="12 из 18 изучено" />

                                            <ProgressBar
                                                Height="5"
                                                Margin="0,9,0,0"
                                                Maximum="100"
                                                Background="#E6E8F1"
                                                BorderThickness="0"
                                                Foreground="{StaticResource Mnemora.Brush.BrandGradient}"
                                                Value="{Binding ProgressPercentage, Mode=OneWay}"
                                                d:Value="67" />
                                        </StackPanel>

                                        <!-- Типы материалов -->

                                        <Grid Grid.Row="4" Margin="0,18,0,0">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{DynamicResource Mnemora.Brush.TextSecondary}"
                                                Text="{Binding MaterialTypesText}" />

                                            <materialDesign:PackIcon
                                                Width="22"
                                                Height="22"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource Mnemora.Brush.Secondary}"
                                                Kind="ChevronRight" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>